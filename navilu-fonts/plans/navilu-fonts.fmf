summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: navilu-fonts
execute:
    how: tmt
environment:
    PACKAGE: navilu-fonts
    FONT_ALIAS: sans-serif
    FONT_FAMILY: Navilu
    FONT_LANG: kn
    DEFAULT_SANS: 2
    DEFAULT_SERIF: 2
    DEFAULT_MONO: 2 
