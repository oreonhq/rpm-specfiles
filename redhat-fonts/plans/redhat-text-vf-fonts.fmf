summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: redhat-text-vf-fonts
execute:
    how: tmt
environment:
    PACKAGE: redhat-text-vf-fonts
    FONT_ALIAS: sans-serif
    FONT_FAMILY: Red Hat Text
