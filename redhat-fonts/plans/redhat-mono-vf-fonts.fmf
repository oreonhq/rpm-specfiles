summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: redhat-mono-vf-fonts
execute:
    how: tmt
environment:
    PACKAGE: redhat-mono-vf-fonts
    FONT_ALIAS: monospace
    FONT_FAMILY: Red Hat Mono
