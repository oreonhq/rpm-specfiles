summary: Upstream tests
contact: Michal Josef Spacek <mspacek@redhat.com>
component: perl-Module-Install-AuthorRequires
require: perl-Module-Install-AuthorRequires-tests
test: /usr/libexec/perl-Module-Install-AuthorRequires/test
enabled: true
tag:
  - rhel-buildroot
adjust:
