summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: pt-sans-fonts
execute:
    how: tmt
environment:
    PACKAGE: pt-sans-fonts
    FONT_ALIAS: sans-serif
    FONT_FAMILY: PT Sans
    FONT_LANG: ru
    FONT_VALIDATE_EXCLUDE_FILES: (PTC55F|PTC75F)
