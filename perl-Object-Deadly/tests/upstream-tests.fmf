summary: Upstream tests
contact: Michal Josef Spacek <mspacek@redhat.com>
component: perl-Object-Deadly
require: perl-Object-Deadly-tests
test: /usr/libexec/perl-Object-Deadly/test
enabled: true
tag:
  - rhel-buildroot
adjust:
  - enabled: false
    when: distro < rhel-10 or distro < centos-stream-10
    continue: false
