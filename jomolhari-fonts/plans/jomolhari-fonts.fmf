summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: jomolhari-fonts
execute:
    how: tmt
environment:
    PACKAGE: jomolhari-fonts
    FONT_ALIAS: serif
    FONT_FAMILY: Jomolhari
    FONT_LANG: bo
    DEFAULT_SANS: 1
    DEFAULT_SERIF: 1
    DEFAULT_MONO: 1
