summary: Fonts related tests
discover:
  how: fmf
  url: https://src.fedoraproject.org/tests/fonts
prepare:
  name: tmt
  how: install
  package: google-noto-serif-cjk-vf-fonts
execute:
  how: tmt
environment:
  PACKAGE: google-noto-serif-cjk-vf-fonts
  FONT_ALIAS: serif
  FONT_FAMILY: Noto Serif CJK TC
  FONT_LANG: zh-tw
  DEFAULT_SERIF: 1
  FONT_VALIDATE_INDEXES: 3,131075,196611,262147,327683,393219,458755
