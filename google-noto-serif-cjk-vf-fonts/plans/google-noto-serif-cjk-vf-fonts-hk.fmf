summary: Fonts related tests
discover:
  how: fmf
  url: https://src.fedoraproject.org/tests/fonts
prepare:
  name: tmt
  how: install
  package: google-noto-serif-cjk-vf-fonts
execute:
  how: tmt
environment:
  PACKAGE: google-noto-serif-cjk-vf-fonts
  FONT_ALIAS: serif
  FONT_FAMILY: Noto Serif CJK HK
  FONT_LANG: zh-hk,zh-mo
  DEFAULT_SERIF: 1
  FONT_VALIDATE_INDEXES: 4,131076,196612,262148,327684,393220,458756
