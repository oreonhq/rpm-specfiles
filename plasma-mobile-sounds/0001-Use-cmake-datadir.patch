From 4f1d62d4a3ea4afcdda884e59f8687755417f29b Mon Sep 17 00:00:00 2001
From: Troy Dawson <tdawson@redhat.com>
Date: Wed, 11 Dec 2024 12:31:18 -0800
Subject: [PATCH] Use cmake datadir

---
 CMakeLists.txt | 8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index cc97249..97f484d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -7,10 +7,6 @@ cmake_minimum_required(VERSION 3.16)
 project(plasma-mobile-sounds)
 set(PROJECT_VERSION "1.0")
 
-find_package(ECM ${KF5_MIN_VERSION} REQUIRED CONFIG)
-set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} ${ECM_MODULE_PATH})
+include(GNUInstallDirs)
 
-include(KDEInstallDirs)
-include(KDECMakeSettings)
-
-install(DIRECTORY plasma-mobile DESTINATION ${KDE_INSTALL_SOUNDDIR})
+install(DIRECTORY plasma-mobile DESTINATION ${CMAKE_INSTALL_DATADIR}/sounds)
