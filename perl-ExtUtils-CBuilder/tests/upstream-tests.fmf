summary: Upstream tests
component: perl-ExtUtils-CBuilder
require: perl-ExtUtils-CBuilder-tests
test: /usr/libexec/perl-ExtUtils-CBuilder/test
enabled: true
tag:
  - rhel-buildroot
  - TestCaseCopy
  - Tier1
tier: '1'
adjust:
  - enabled: false
    when: distro < rhel-10 or distro < centos-stream-10
    continue: false
