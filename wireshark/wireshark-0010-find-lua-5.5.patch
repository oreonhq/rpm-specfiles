+//
+// Undo any definition of _FORTIFY_SOURCE, so that we don't get a
+// complaint that we're compiling without optimization.
+//
+#undef _FORTIFY_SOURCE
+#include <lua.h>
+
+int
+main(void)
+{
+    return lua_resetthread(NULL, NULL);
+}
+" HAVE_TWO_ARGUMENT_LUA_RESETTHREAD)
