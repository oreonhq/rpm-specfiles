# Package groups for Oreon 11 (Release Pack 1) ONLY

[rpm-and-base]
summary: the release itself, rpm, and the packages every other spec assumes exist
maintainer: Brandon Lester
packages: filesystem, setup, rpm, rpm-sequoia, tree-pkg, chkconfig, oreon-release, oreon-defense, oreon-rpm-config, oreon-rpm-macros, ca-certificates, hwdata, tzdata

[srpm-macros]
summary: macros imported into other specs. a mistake here breaks the whole tree
maintainer: Brandon Lester
packages: cmake-srpm-macros, efi-srpm-macros, fonts-srpm-macros, forge-srpm-macros, go-srpm-macros, java-srpm-macros, kernel-srpm-macros, lua-srpm-macros, ocaml-srpm-macros, openblas-srpm-macros, package-notes-srpm-macros, perl-srpm-macros, perl-generators, pyproject-rpm-macros, pyproject-srpm-macros, python-srpm-macros, qt6-srpm-macros, rust-srpm-macros

[toolchain]
