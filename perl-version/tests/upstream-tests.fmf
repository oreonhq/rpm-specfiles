summary: Upstream tests
contact: Jitka Plesnikova <jplesnik@redhat.com>
component: perl-version
require: perl-version-tests
test: /usr/libexec/perl-version/test
enabled: true
tag:
  - rhel-buildroot
adjust:
  - enabled: false
    when: distro < rhel-10 or distro < centos-stream-10
    continue: false
