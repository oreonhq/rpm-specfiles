[baseos]
name=Oreon $releasever - BaseOS
mirrorlist=https://mirrors.almalinux.org/mirrorlist/$releasever/baseos
# baseurl=https://kitten.repo.almalinux.org/$releasever-kitten/BaseOS/$basearch/os/
enabled=1
gpgcheck=1
countme=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Oreon-10
metadata_expire=86400
enabled_metadata=1

[oreon-mainstream]
name=Oreon - Mainstream
mirrorlist=https://mirrors.oreonproject.org/oreon-10
skip_if_unavailable=True
fastestmirror=True
gpgcheck=1
gpgkey=https://mirrors.oreonhq.com/RPM-GPG-KEY-oreon-11-primary
repo_gpgcheck=0
enabled=1
enabled_metadata=1

[baseos-debuginfo]
name=Oreon $releasever - BaseOS - Debug
mirrorlist=https://mirrors.almalinux.org/mirrorlist/$releasever/baseos-debug
# baseurl=https://kitten.vault.almalinux.org/$releasever-kitten/BaseOS/debug/$basearch/
enabled=0
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Oreon-10
metadata_expire=86400
enabled_metadata=0

[baseos-source]
name=Oreon $releasever - BaseOS - Source
mirrorlist=https://mirrors.almalinux.org/mirrorlist/$releasever/baseos-source
# baseurl=https://kitten.vault.almalinux.org/$releasever-kitten/BaseOS/Source/
enabled=0
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Oreon-10
metadata_expire=86400
enabled_metadata=0

