summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: google-carlito-fonts
execute:
    how: tmt
environment:
    PACKAGE: google-carlito-fonts
    FONT_ALIAS: sans-serif
    FONT_FAMILY: Carlito
    FONT_LANG: en
