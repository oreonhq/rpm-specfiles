     parr[0] = OSSL_PARAM_construct_octet_string(pname, val, len);
@@ -373,6 +426,7 @@ load_slot(OSSL_LIB_CTX *libctx, const char *propq, const char *pname,
         ret = 1;
 
 err:
+    OPENSSL_free(adjusted_propq);
     EVP_PKEY_CTX_free(ctx);
