         len = mbytes;
+        adjusted_propq = get_adjusted_propq(propq);
     } else {
         alg = key->xinfo->algorithm_name;
         group = (char *)key->xinfo->group_name;
@@ -362,7 +414,8 @@ load_slot(OSSL_LIB_CTX *libctx, const char *propq, const char *pname,
     }
     val = (void *)(in + off);
 
-    if ((ctx = EVP_PKEY_CTX_new_from_name(libctx, alg, propq)) == NULL
+    if ((ctx = EVP_PKEY_CTX_new_from_name(libctx, alg,
+                                          adjusted_propq ? adjusted_propq : propq)) == NULL
         || EVP_PKEY_fromdata_init(ctx) <= 0)
         goto err;
     parr[0] = OSSL_PARAM_construct_octet_string(pname, val, len);
@@ -373,6 +426,7 @@ load_slot(OSSL_LIB_CTX *libctx, const char *propq, const char *pname,
         ret = 1;
 
 err:
+    OPENSSL_free(adjusted_propq);
     EVP_PKEY_CTX_free(ctx);
     return ret;
 }
@@ -696,6 +750,7 @@ static void *mlx_kem_gen(void *vgctx, OSSL_CALLBACK *osslcb, void *cbarg)
     PROV_ML_KEM_GEN_CTX *gctx = vgctx;
     MLX_KEY *key;
     char *propq;
+    char *adjusted_propq = NULL;
 
     if (gctx == NULL
         || (gctx->selection & OSSL_KEYMGMT_SELECT_KEYPAIR) == OSSL_KEYMGMT_SELECT_PUBLIC_KEY)
@@ -711,8 +766,10 @@ static void *mlx_kem_gen(void *vgctx, OSSL_CALLBACK *osslcb, void *cbarg)
         return key;
 
     /* For now, using the same "propq" for all components */
-    key->mkey = EVP_PKEY_Q_keygen(key->libctx, key->propq,
+    adjusted_propq = get_adjusted_propq(propq);
