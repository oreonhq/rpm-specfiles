         || EVP_PKEY_decapsulate_init(ctx, NULL) <= 0
         || EVP_PKEY_decapsulate(ctx, sbuf, &decap_slen, cbuf, decap_clen) <= 0)
@@ -370,6 +398,7 @@ end:
             ML_KEM_SHARED_SECRET_BYTES + key->xinfo->shsec_bytes);
