    die "Could not find URL in JSON response from playlist URL generator: " .
        $playlist_url_data . "\n";
}

# Another layer before M3U playlist URL:
$response = $ua->request(GET $smil_url);
$response->is_success or
    die "Could not get <"
        . $smil_url . ">: "
        . $response->status_line . "\n";
my $m3u_url_data = $response->decoded_content;
if ($opt_v) {
    print STDERR "Another layer before M3U URL returned:\n",
        "===BEGIN OUTPUT===\n", $m3u_url_data, "\n===END OUTPUT===\n";
}
my $m3u_url_json;
eval { $m3u_url_json = decode_json($m3u_url_data) } or 
    die "Could not decode JSON string with M3U URL: $m3u_url_data: $@\n";


# Video can have multiple parts
my $PART = 0;
if ($opt_t) {
    # Listing parts requested
    if (defined $ARGV[0]) {
        $PART = shift @ARGV;
        print $$m3u_url_json{playlist}[$PART]->{streamUrls}{main} . "\n";
    } else {
        my $id = 0;
        for (@{$$m3u_url_json{playlist}}) {
            print $id . ": " . $_->{streamUrls}{main} . "\n";
            $id++;
        }
    }
    exit;
} else {
    # If this is not the only part and user did not select it, die.
    if (@{$$m3u_url_json{playlist}} > 1) {
        if (defined $ARGV[0]) {
            $PART = shift @ARGV;
        } else {
            warn "Video has multiple parts:\n";
            my $id = 0;
            for (@{$$m3u_url_json{playlist}}) {
                print $id . ": " . $_->{streamUrls}{main} . "\n";
                $id++;
            }
            die "Select one by adding a positional argument.\n";
        }
    }
}


$m3u_url = $$m3u_url_json{playlist}->[$PART]{streamUrls}{main};
if (!defined $m3u_url) {
    die "Could not find M3U URL in JSON response from M3U URL generator: " .
        $playlist_url_data . "\n";
}


HAVE_SMIL_URL: # Overloaded server returns the SMIL URL directly.
# Rewrite SMIL playlist URL for next-stage generator
# http://code.google.com/p/dmd-xbmc/issues/detail?id=94
$smil_url = URI::Escape::uri_unescape($smil_url);


my $smil;
# The iPad requires a special suffix '&rd=1' to an URL hard-coded into the
# HTML frame. However it's easier to edit the URL here to utilize unified code
# path.
# There is a new step with Apple playlist. A short-cut to M3U exists by
# appending '&rd=1' to the generator URL. But we do not use the short-cut now.
# 
if (!defined $m3u_url) {
    $response = $ua->request(GET $smil_url);
    $response->is_success or
        die "Could not get playlist URL from second-step URL generator <"
            . $smil_url . ">: "
            . $response->status_line . "\n";
    $m3u_url = $response->decoded_content;
    if ($opt_v) {
        print STDERR "Second-step URL generator returned:\n",
            "===BEGIN OUTPUT===\n", $m3u_url, "\n===END OUTPUT===\n";
    }

    if ($m3u_url =~ /<smilRoot>/) {
        $smil = $m3u_url;
        # This is sometimes SMIL play-list with only one video URL
        # which points to Apple M3U top play-list.
        my $parser = XML::XPath->new('xml' => $smil) or
            die "Could not parse SMIL playlist from <" .
                $smil_url . ">:\n" . $smil . "\n";
        # XXX: XML::XPath is lazy in parsing. It dies when calling find() on
        # XML syntax error. 
        eval {
            $m3u_url = extract_url_from_m3u_smil($smil, $smil_url, $parser);
        };
        if ($@) {
            print STDERR "Error while finding stream URLs " .
                "in SMIL playlist from <", $smil_url, ">.\n";
            print STDERR "===BEGIN INPUT===\n$smil\n===END INPUT===\n";
            die "Reason: $@\n";
        }

    } else {
        # Or the second-step generator returns two concatened URLs in plain
        # text file.
        $m3u_url =~ s|(.)http://.*|$1|;
    }
}


# Get stream URLs
my @bitrate_url_pairs = extract_urls_from_top_apple_m3u($m3u_url, $ua);

my $BITRATE = shift @ARGV;
if ($opt_f || $opt_s) {
    # Select Apple M3U URL
    if (defined $BITRATE) {
        @bitrate_url_pairs = grep { ${$_}{'bitrate'} == $BITRATE }
            @bitrate_url_pairs;
    }
    if ($#bitrate_url_pairs < 0) {
        die "No usable video streams found in top-level Apple playlist:\n$m3u_url\n";
    }
    if ($#bitrate_url_pairs == 0 ) {
        iterate_bottom_apple_m3u(${$bitrate_url_pairs[0]}{'url'}, $ua, $opt_s);
    } else {
        die "Multiple bit-rate play-lists not implemented yet.\n";
    }
} else {
    # Output URL
    my $video_counter = 0;
    for my $pair (@bitrate_url_pairs) {
        if (defined $BITRATE) {
            if (${$pair}{'bitrate'} == $BITRATE) {
                print "${$pair}{'url'}\n";
                $video_counter++;
            }
        } else {
            print "${$pair}{'bitrate'}: ${$pair}{'url'}\n";
            $video_counter++;
        }
    }
    if ($video_counter <= 0) {
        die "No usable video streams found in playlist:\n$smil\n";
    }
}

