# Get playlist URL
my $generator_url = URI->new_abs($generator_path, $ENTRY);
#$ua->default_header($xmlrpc_header => $xmlrpc_value) if defined $xmlrpc_header;
if ($opt_v) {
    print STDERR "Posting to playlist URL generator <$generator_url>\n";
    print STDERR "Posting data to playlist URL generator: ", join(',', @data), "\n";
}
$response = $ua->request(POST $generator_url, \@data);
if ($response->code == 301 || $response->code == 302) {
    # Non-HTTPS POST requests receive 301 (used to be 302) redirecting to an
    # HTTPS location and a new POST request is expected. This violates
    # RFC 2616 and libwww-perl-6.27 does not support RFC 7231 yet
    # <https://github.com/libwww-perl/libwww-perl/issues/42>.
    my $new_url = $response->header('Location');
    if (!defined $new_url) {
        die "Playlist URL generator <$generator_url> redirects " .
            "but does not specify a new location\n";
    }
    $generator_url = $new_url;
    if ($opt_v) {
        print STDERR "Playlist URL generator redirected to <$generator_url>\n";
    }
    $response = $ua->request(POST $generator_url, \@data);
}
$response->is_success or
    die "Could not get playlist URL from playlist URL generator <" .
        $generator_url . ">: " . $response->status_line . "\n" .
        "===BEGIN OUTPUT===\n" . $response->decoded_content .
        "\n===END OUTPUT===\n";
my $playlist_url_data = $response->decoded_content;
if ($opt_v) {
    print STDERR "Playlist URL generator returned: <$playlist_url_data>\n";
}


my $smil_url_json;
eval { $smil_url_json = decode_json($playlist_url_data) } or 
    die "Could not decode JSON string with playlist URL: $playlist_url_data: $@\n";
