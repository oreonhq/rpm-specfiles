summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: sil-abyssinica-fonts
execute:
    how: tmt
environment:
    PACKAGE: sil-abyssinica-fonts
    FONT_ALIAS: serif
    FONT_FAMILY: Abyssinica SIL
    FONT_LANG: en
    DEFAULT_SANS: 2
    DEFAULT_SERIF: 2
    DEFAULT_MONO: 2
