summary: Upstream tests
component: perl-Devel-PPPort
require: perl-Devel-PPPort-tests
test: /usr/libexec/perl-Devel-PPPort/test
enabled: true
tag:
  - rhel-buildroot
  - TestCaseCopy
  - Tier1
tier: '1'
adjust:
  - enabled: false
    when: distro < rhel-10 or distro < centos-stream-10
    continue: false
