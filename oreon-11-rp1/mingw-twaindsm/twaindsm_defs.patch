+/*
+* Convert a TWRC_ return code numerical value to a string...
+*/
+void CTwnDsm::StringFromRC(char     *_szRc,
+                     const int       _nChars,
+                     const TW_UINT16 _rc)
+{
+  switch (_rc)
+  {
+    default:    
+      SSNPRINTF(_szRc,_nChars,_nChars,"TWRC_0x%04x",_rc);
+      break;
+
+    case TWRC_SUCCESS:
+      SSTRCPY(_szRc,_nChars,"TWRC_SUCCESS");
+      break;
+
+    case TWRC_FAILURE:
