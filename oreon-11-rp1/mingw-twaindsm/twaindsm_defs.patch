-TW_INT16 CTwnDsm::DSM_GetFirst(TW_IDENTITY *_pAppId,
-                               TW_IDENTITY *_pDsId)
-{
-  // Validate...
-  if (   !pod.m_ptwndsmapps->AppValidateId(_pAppId)
-      || (0 == _pDsId))
-  {
-    kLOG((kLOGERR,"bad _pAppId or _pDsId..."));
-    return TWRC_FAILURE;
