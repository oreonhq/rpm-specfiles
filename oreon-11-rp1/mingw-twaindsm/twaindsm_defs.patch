-
-      return result;
-
-  // We don't support the user selection box on linux...
-  #elif  (TWNDSM_CMP == TWNDSM_CMP_GNUGPP)
-
-    pod.m_ptwndsmapps->AppSetConditionCode(_pAppId,TWCC_BADPROTOCOL);
-    return TWRC_FAILURE;
-
-  // Ruh-roh, Reorge...
