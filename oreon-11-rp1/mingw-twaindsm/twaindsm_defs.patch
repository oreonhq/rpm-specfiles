-  }
-  else if (0 == _pDsId->ProductName[0])
-  {
-    return TWRC_FAILURE;
-  }
-
-  // Search for a match on the ProductName...
-  for (ii = 1; ii < MAX_NUM_DS; ++ii)
-  {
-    // Note that TW_STR32 type is NUL-filled, not NUL-terminated...
