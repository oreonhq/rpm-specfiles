-      // match found, set the index
-      *_pDsId = *pod.m_ptwndsmapps->DsGetIdentity(_pAppId,ii);
-      return TWRC_SUCCESS;
-    }
-  }
-
-  // Uh-oh...
-  return TWRC_FAILURE;
