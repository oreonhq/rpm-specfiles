summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: khmer-os-siemreap-fonts
execute:
    how: tmt
environment:
    PACKAGE: khmer-os-siemreap-fonts
    FONT_ALIAS: monospace
    FONT_FAMILY: Khmer OS Siemreap
    FONT_LANG: km
    DEFAULT_SANS: 2
    DEFAULT_SERIF: 2
    DEFAULT_MONO: 2
