From 5615f3d071867c17f235c9a29319bfa8907b75b9 Mon Sep 17 00:00:00 2001
From: Michel Alexandre Salim <salimma@fedoraproject.org>
Date: Thu, 16 Mar 2023 11:22:53 -0500
Subject: [PATCH] Pre-generate version for distro packaging

Signed-off-by: Michel Alexandre Salim <salimma@fedoraproject.org>
---
 pyproject.toml           | 8 +-------
 src/fixit/__version__.py | 4 ++++
 2 files changed, 5 insertions(+), 7 deletions(-)
 create mode 100644 src/fixit/__version__.py

diff --git a/pyproject.toml b/pyproject.toml
index 94f6080..89d1a6c 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -31,7 +31,7 @@ dependencies = [
     "trailrunner >= 1.2",
 ]
 
-dynamic = ["version"]
+version = '0.1.5.dev68+gd2b59da'
 description = "A lint framework that writes better Python code for you."
 
 [project.optional-dependencies]
@@ -62,12 +62,6 @@ Changelog = "https://github.com/Instagram/LibCST/blob/main/CHANGELOG.md"
 [tool.black]
 target-version = ["py37"]
 
-[tool.hatch.version]
-source = "vcs"
-
-[tool.hatch.build.hooks.vcs]
-version-file = "src/fixit/__version__.py"
-
 [tool.hatch.envs.default]
 features = ["dev", "pretty"]
 
diff --git a/src/fixit/__version__.py b/src/fixit/__version__.py
new file mode 100644
index 0000000..1f1fc82
--- /dev/null
+++ b/src/fixit/__version__.py
@@ -0,0 +1,4 @@
+# file generated by setuptools_scm
+# don't change, don't track in version control
+__version__ = version = '0.1.5.dev68+gd2b59da'
+__version_tuple__ = version_tuple = (0, 1, 5, 'dev68', 'gd2b59da')
-- 
2.39.2

