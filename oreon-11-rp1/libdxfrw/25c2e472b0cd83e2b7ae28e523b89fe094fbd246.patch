From 25c2e472b0cd83e2b7ae28e523b89fe094fbd246 Mon Sep 17 00:00:00 2001
From: Dongxu Li <dongxuli2011@gmail.com>
Date: Fri, 26 May 2023 16:12:49 -0400
Subject: [PATCH] issue #1598 : save closed splines with wrapped control points

---
 libraries/libdxfrw/src/drw_base.h           |  1 +
 libraries/libdxfrw/src/drw_entities.h       | 58 +++++++++---------

diff --git a/libraries/libdxfrw/src/drw_base.h b/libraries/libdxfrw/src/drw_base.h
index c68089ae57..474adcfbb9 100644
--- a/src/drw_base.h
+++ b/src/drw_base.h
@@ -209,6 +209,7 @@ enum TransparencyCodes {
 class DRW_Coord {
 public:
     DRW_Coord()=default;
+    DRW_Coord(double ix, double iy): x(ix), y(iy){}
     DRW_Coord(double ix, double iy, double iz): x(ix), y(iy),z(iz){}
 
 /*!< convert to unitary vector */
diff --git a/libraries/libdxfrw/src/drw_entities.h b/libraries/libdxfrw/src/drw_entities.h
