<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!-- SPDX-License-Identifier: MIT -->
<fontconfig>
	<alias>
		<family>sans-serif</family>
		<prefer>
			<family>Gothic A1</family>
		</prefer>
	</alias>
	<alias>
		<family>Gothic A1</family>
		<default>
			<family>DejaVu Sans</family>
			<family>Bitstream Vera Sans</family>
			<family>sans-serif</family>
		</default>
	</alias>
</fontconfig>
