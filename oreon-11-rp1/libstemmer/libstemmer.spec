%global source0_hash c33aea097734daae5c445efe6e399cb078f66325b40d54791df577ffaa53c2d7

Name: libstemmer
Version: 3.2.0
Release: 1%{?dist}
Summary: Snowball stemming library
License: BSD-3-Clause
URL: https://snowballstem.org/
Source0: https://github.com/snowballstem/snowball/archive/refs/tags/v%{version}.tar.gz#/snowball-%{version}.tar.gz

BuildRequires: oreon-rpm-macros
BuildRequires: gcc
BuildRequires: make
BuildRequires: perl

%description
Libstemmer provides stemming algorithms generated by the Snowball
language for use in search and text processing applications.

%package devel
Summary: Development files for libstemmer
Requires: %{name}%{?_isa} = %{version}-%{release}

%description devel
Headers and the unversioned linker interface for libstemmer.

%prep
%oreon_sha256
%autosetup -n snowball-%{version}

%build
%make_build CFLAGS="%{build_cflags} -fPIC"
gcc -shared %{build_ldflags} \
  -Wl,-soname,libstemmer.so.0 \
  -Wl,--whole-archive libstemmer.a -Wl,--no-whole-archive \
  -o libstemmer.so.0.0.0

%install
install -Dpm 0755 libstemmer.so.0.0.0 \
  %{buildroot}%{_libdir}/libstemmer.so.0.0.0
ln -s libstemmer.so.0.0.0 %{buildroot}%{_libdir}/libstemmer.so.0
ln -s libstemmer.so.0 %{buildroot}%{_libdir}/libstemmer.so
install -Dpm 0644 include/libstemmer.h \
  %{buildroot}%{_includedir}/libstemmer.h

%check
%make_build check_stemtest check_compilertest

%ldconfig_scriptlets

%files
%license COPYING
%doc NEWS README.rst
%{_libdir}/libstemmer.so.0*

%files devel
%{_includedir}/libstemmer.h
%{_libdir}/libstemmer.so

%changelog
%autochangelog
