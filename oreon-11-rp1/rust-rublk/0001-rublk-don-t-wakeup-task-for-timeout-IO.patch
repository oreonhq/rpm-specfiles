From df42eecfe18d1d2ce2deee925468de23adf261af Mon Sep 17 00:00:00 2001
From: Ming Lei <tom.leiming@gmail.com>
Date: Thu, 6 Nov 2025 11:24:28 +0000
Subject: [PATCH 2/2] rublk: don't wakeup task for timeout IO

When using io_uring with timeouts in the compress target, timeout CQEs
were incorrectly being passed to ublk_wake_task(). Timeout events are
internal housekeeping events used by ublk_reap_io_events_with_update_queue
and should not trigger task wakeups.

This could cause spurious task wakeups and potential issues with task
scheduling, as the timeout user_data doesn't correspond to any actual
waiting task.

Fix this by checking if the CQE user_data matches TIMEOUT_USER_DATA and
skipping the wake call for timeout events, while still waking tasks for
all normal I/O completion events.

Signed-off-by: Ming Lei <tom.leiming@gmail.com>
---
 src/compress.rs | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/compress.rs b/src/compress.rs
index abd2a7b..d9f4dd9 100644
--- a/src/compress.rs
+++ b/src/compress.rs
@@ -320,7 +320,9 @@ async fn handle_uring_events<T>(
         ublk_reap_io_events_with_update_queue(q, poll_timeout, Some(TIMEOUT_USER_DATA), |cqe| {
             // Handle normal CQEs by waking tasks
             // Timeout CQEs are handled internally by ublk_reap_io_events_with_update_queue
-            ublk_wake_task(cqe.user_data(), cqe);
+            if cqe.user_data() != TIMEOUT_USER_DATA {
+                ublk_wake_task(cqe.user_data(), cqe);
+            }
         })
     };
     let run_ops = || while exe.try_tick() {};
