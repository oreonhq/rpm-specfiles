diff -up dlt-daemon-2.18.9/src/daemon/dlt.conf.fedora dlt-daemon-2.18.9/src/daemon/dlt.conf
--- dlt-daemon-2.18.9/src/daemon/dlt.conf.fedora	2023-04-17 09:02:23.000000000 -0400
+++ dlt-daemon-2.18.9/src/daemon/dlt.conf	2023-05-17 11:33:22.560239612 -0400
@@ -31,8 +31,8 @@ ECUId = ECU1
 # Size of shared memory (Default: 100000)
 SharedMemorySize = 100000
 
-# Directory where to store the persistant configuration (Default: /tmp)
-# PersistanceStoragePath = /tmp
+# Directory where to store the persistant configuration (Default: /var/lib/dlt-daemon)
+PersistanceStoragePath = /var/lib/dlt-daemon/
 
 # The logging console for internal logging of dlt-daemon (Default: 0)
 # 0 = log to stdout
@@ -45,10 +45,10 @@ LoggingMode = 0
 # LOG_EMERG = 0, LOG_ALERT = 1, LOG_CRIT = 2, LOG_ERR = 3, LOG_WARNING = 4, LOG_NOTICE = 5, LOG_INFO = 6, LOG_DEBUG = 7
 LoggingLevel = 6
 
-# The logging filename if internal logging mode is log to file (Default: /tmp/dlt.log)
+# The logging filename if internal logging mode is log to file (Default: /var/lib/dlt-daemon/dlt.log)
 # If access to the file is not possible, the daemon will fall back to syslog
 # if WITH_DLT_FILE_LOGGING_SYSLOG_FALLBACK is set as compile flag
-LoggingFilename = /tmp/dlt.log
+LoggingFilename = /var/lib/dlt-daemon/dlt.log
 
 # Indicate whether size of logging file(s) is limited (Default: 0)
 EnableLoggingFileLimit = 0
@@ -71,7 +71,7 @@ RingbufferMaxSize = 10000000
 # The step size the Ringbuffer is increased, used for storing temporary DLT messages, until client is connected (Default: 500000)
 RingbufferStepSize = 500000
 
-# The size of Daemon FIFO (/tmp/dlt) (Default: 65536, MinSize: depend on pagesize of system, MaxSize: please check /proc/sys/fs/pipe-max-size)
+# The size of Daemon FIFO (/var/lib/dlt-daemon/dlt) (Default: 65536, MinSize: depend on pagesize of system, MaxSize: please check /proc/sys/fs/pipe-max-size)
 # This is only supported for Linux.
 # DaemonFIFOSize = 65536
 
@@ -102,21 +102,21 @@ RingbufferStepSize = 500000
 ########################################################################
 # Permission configuration                                             #
 # ==================================================================== #
-# Owner group of daemon FIFO directory(Default: /tmp/dlt)
+# Owner group of daemon FIFO directory(Default: /var/lib/dlt-daemon)
 # (If not set, primary group of dlt-daemon process is used)
 # DaemonFifoGroup = dlt_user_apps_group
 
 ########################################################################
 # Control Application                                                  #
 ########################################################################
-ControlSocketPath = /tmp/dlt-ctrl.sock
+ControlSocketPath = /run/dlt/dlt-ctrl.sock
 
 ########################################################################
 # Offline Trace memory                                                 #
 ########################################################################
 
 # Store DLT messages to local directory, if not set offline Trace is off (Default: off)
-# OfflineTraceDirectory = /tmp
+# OfflineTraceDirectory = /var/lib/dlt-daemon
 
 # Maximum size in bytes of one trace file (Default: 1000000)
 # OfflineTraceFileSize = 1000000
diff -up dlt-daemon-2.18.9/systemd/dlt.service.cmake.fedora dlt-daemon-2.18.9/systemd/dlt.service.cmake
--- dlt-daemon-2.18.9/systemd/dlt.service.cmake.fedora	2023-04-17 09:02:23.000000000 -0400
+++ dlt-daemon-2.18.9/systemd/dlt.service.cmake	2023-05-17 11:29:03.853060931 -0400
@@ -24,6 +24,7 @@ ExecStart=@CMAKE_INSTALL_PREFIX@/bin/dlt
 WatchdogSec=@DLT_WatchdogSec@
 NotifyAccess=main
 LimitCORE=infinity
+RuntimeDirectory=dlt
 
 [Install]
 WantedBy=basic.target
