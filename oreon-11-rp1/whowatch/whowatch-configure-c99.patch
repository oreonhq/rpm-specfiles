 FD_ZERO(&rfds); FD_SET(0,&rfds);
 select(1,&rfds,0,0,&tv);
-if(tv.tv_sec == 0) exit(0);
-else exit(1);
+if(tv.tv_sec == 0) return 0;
+else return 1;
 }
