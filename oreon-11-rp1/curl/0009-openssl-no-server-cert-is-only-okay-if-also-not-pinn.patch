From a84b69f1c6e5ec52cf23fe2fe3390e3002257b8a Mon Sep 17 00:00:00 2001
From: Daniel Stenberg <daniel@haxx.se>
Date: Mon, 24 Aug 2026 23:37:49 +0200
Subject: [PATCH] openssl: no server cert is only okay if also not pinned

Reported-by: Stanislav Fort
Closes #22660

(cherry picked from commit 5267ed859d545534d0c21675a2b70af5a3b6e3ef)
---
 lib/vtls/openssl.c | 26 +++++++++++++++-----------
 1 file changed, 15 insertions(+), 11 deletions(-)

diff --git a/lib/vtls/openssl.c b/lib/vtls/openssl.c
index 4659cbf881..0f4123e83d 100644
--- a/lib/vtls/openssl.c
+++ b/lib/vtls/openssl.c
@@ -4573,21 +4573,24 @@ out:
   return result;
 }
 
-static CURLcode ossl_check_pinned_key(struct Curl_cfilter *cf,
-                                      struct Curl_easy *data,
-                                      X509 *server_cert)
+static const char *pinned(struct Curl_cfilter *cf,
+                          struct Curl_easy *data)
 {
-  const char *ptr;
-  CURLcode result = CURLE_OK;
-
   (void)cf;
+  return
 #ifndef CURL_DISABLE_PROXY
-  ptr = Curl_ssl_cf_is_proxy(cf) ?
+    Curl_ssl_cf_is_proxy(cf) ?
     data->set.str[STRING_SSL_PINNEDPUBLICKEY_PROXY] :
-    data->set.str[STRING_SSL_PINNEDPUBLICKEY];
-#else
-  ptr = data->set.str[STRING_SSL_PINNEDPUBLICKEY];
 #endif
+    data->set.str[STRING_SSL_PINNEDPUBLICKEY];
+}
+
+static CURLcode ossl_check_pinned_key(struct Curl_cfilter *cf,
+                                      struct Curl_easy *data,
+                                      X509 *server_cert)
+{
+  CURLcode result = CURLE_OK;
+  const char *ptr = pinned(cf, data);
   if(ptr) {
     result = ossl_pkp_pin_peer_pubkey(data, server_cert, ptr);
     if(result)
@@ -4769,7 +4772,8 @@ CURLcode Curl_ossl_check_peer_cert(struct Curl_cfilter *cf,
   server_cert = SSL_get1_peer_certificate(octx->ssl);
   if(!server_cert) {
     /* no verification at all, this maybe acceptable */
-    if(!(conn_config->verifypeer || conn_config->verifyhost))
+    if(!(conn_config->verifypeer || conn_config->verifyhost) &&
+       !pinned(cf, data))
       goto out;
 
     failf(data, "SSL: could not get peer certificate");
