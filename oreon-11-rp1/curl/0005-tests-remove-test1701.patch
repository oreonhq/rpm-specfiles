-
-HTTP/2 200%SP
-date: Tue, 09 Nov 2010 14:49:00 GMT
-last-modified: Tue, 13 Jun 2000 12:10:00 GMT
-etag: "21025-dc7-39462498"
-accept-ranges: bytes
-content-length: 6
-content-type: text/html
-funny-head: yesyes
-via: 1.1 nghttpx
-
--foo-
-</stdout>
-<stripfile>
-s/^server: nghttpx.*\r?\n//
-</stripfile>
-</verify>
-</testcase>
