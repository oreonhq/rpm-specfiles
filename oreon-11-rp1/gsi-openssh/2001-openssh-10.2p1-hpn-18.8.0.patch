+    signed char    vchar;
+    unsigned char  vuchar;
+    signed short   vshort;
+    unsigned short vushort;
+    signed int     vint;
+    unsigned int   vuint;
+    //
+    float          vfloat;
+    double         vdouble;
+    //
+    BOOL           vbool;
+  };
+  //
+  BOOL   disable_int_compression;
+};
