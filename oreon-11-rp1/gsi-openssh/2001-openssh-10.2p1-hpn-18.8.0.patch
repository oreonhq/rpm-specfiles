+    case BINN_SINGLE_STR:
+      return BINN_STORAGE_DWORD;
+    case BINN_DOUBLE_STR:
+      return BINN_STORAGE_QWORD;
+#endif
+    case BINN_BOOL:
+    case BINN_TRUE:
+    case BINN_FALSE:
+      return BINN_STORAGE_DWORD;
+    default:
+      binn_get_type_info(type, &storage_type, NULL);
+      return storage_type;
+  }
+
+}
