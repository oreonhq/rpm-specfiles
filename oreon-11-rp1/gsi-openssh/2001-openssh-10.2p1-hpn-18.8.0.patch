+void * APIENTRY binn_list_read(const void *list, int pos, int *ptype, int *psize) {
+  binn value;
+
+  if (binn_list_get_value(list, pos, &value) == FALSE) return NULL;
+  if (ptype) *ptype = value.type;
+  if (psize) *psize = value.size;
