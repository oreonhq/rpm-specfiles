+int APIENTRY binn_get_write_storage(int type) {
+  int storage_type;
+
+  switch (type) {
+    case BINN_SINGLE_STR:
+    case BINN_DOUBLE_STR:
+      return BINN_STORAGE_STRING;
+
+    case BINN_BOOL:
+      return BINN_STORAGE_NOBYTES;
+
+    default:
+      binn_get_type_info(type, &storage_type, NULL);
+      return storage_type;
+  }
+
+}
