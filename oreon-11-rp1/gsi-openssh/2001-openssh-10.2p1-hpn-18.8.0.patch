+
+
+// extended content types:
+
+// strings:
+
+#define BINN_HTML      0xB001
+#define BINN_XML       0xB002
+#define BINN_JSON      0xB003
+#define BINN_JAVASCRIPT 0xB004
+#define BINN_CSS       0xB005
+
