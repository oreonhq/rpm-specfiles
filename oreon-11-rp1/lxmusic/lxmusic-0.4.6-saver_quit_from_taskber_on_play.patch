             gtk_widget_set_tooltip_text( play_btn, _("Play") );
             img = gtk_bin_get_child( (GtkBin*)play_btn );
             gtk_image_set_from_stock( (GtkImage*)img, GTK_STOCK_MEDIA_PLAY,
                                       GTK_ICON_SIZE_BUTTON );
+		}
             break;
     }
 
