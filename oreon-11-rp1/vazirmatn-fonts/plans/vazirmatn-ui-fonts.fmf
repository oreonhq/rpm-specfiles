summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: vazirmatn-ui-fonts
execute:
    how: tmt
environment:
    PACKAGE: vazirmatn-ui-fonts
    FONT_ALIAS: sans-serif
    FONT_FAMILY: Vazirmatn UI
    FONT_LANG: fa
