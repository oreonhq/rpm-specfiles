summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: vazirmatn-fonts
execute:
    how: tmt
environment:
    PACKAGE: vazirmatn-fonts
    FONT_ALIAS: sans-serif
    FONT_FAMILY: Vazirmatn
    FONT_LANG: fa
    DEFAULT_SANS: 1
    DEFAULT_MONO: 1
