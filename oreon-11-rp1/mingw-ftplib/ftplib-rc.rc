
#define RC_FILE_TYPE      VFT_DLL
#define RC_PRODUCT_STR    "libftp Library"
#define RC_FILE_NAME_STR  "libftp.dll"
#define RC_VERSION        4,0,0,0
#define RC_VERSION_STR    "4.0.0"

#include <winver.h>

#define RT_MANIFEST 24
#define ID_MANIFEST 1

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    RC_VERSION
 PRODUCTVERSION RC_VERSION
 FILEFLAGSMASK  0x3FL
 FILEFLAGS      VS_FF_PRERELEASE
 FILEOS         0x4L
 FILETYPE       RC_FILE_TYPE
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",     "Thomas Pfau"
            VALUE "FileDescription", RC_PRODUCT_STR
            VALUE "FileVersion",     RC_VERSION_STR
            VALUE "InternalName",    RC_FILE_NAME_STR
            VALUE "LegalCopyright",  "© 2001 Thomas Pfau"
            VALUE "OriginalFilename",RC_FILE_NAME_STR
            VALUE "ProductName",     RC_PRODUCT_STR
            VALUE "ProductVersion",  RC_VERSION_STR
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

