summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: clm-nachlieli-fonts
execute:
    how: tmt
environment:
    PACKAGE: clm-nachlieli-fonts
    FONT_ALIAS: sans-serif
    FONT_FAMILY: Nachlieli CLM
    FONT_LANG: he
    DEFAULT_SANS: 2
    DEFAULT_SERIF: 2
    DEFAULT_MONO: 2
