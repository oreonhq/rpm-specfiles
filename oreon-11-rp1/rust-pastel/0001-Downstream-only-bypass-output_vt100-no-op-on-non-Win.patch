From 67e0bfe6cdeeeb60e7c5b749ee733ebcf96f7489 Mon Sep 17 00:00:00 2001
From: "Benjamin A. Beasley" <code@musicinmybrain.net>
Date: Mon, 10 Nov 2025 07:52:58 +0000
Subject: [PATCH] Downstream-only: bypass output_vt100 (no-op on non-Windows)

---
 src/cli/cli.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/cli/cli.rs b/src/cli/cli.rs
index 241e629..e03c629 100644
--- a/src/cli/cli.rs
+++ b/src/cli/cli.rs
@@ -502,7 +502,7 @@ pub fn build_cli() -> Command {
                 .value_name("mode")
                 .help("Specify the terminal color mode: 24bit, 8bit, off, *auto*")
                 .value_parser(["24bit", "8bit", "off", "auto"])
-                .default_value(if output_vt100::try_init().is_ok() {"auto"} else {"off"})
+                .default_value("auto")
                 .hide_possible_values(true)
                 .hide_default_value(true)
         )
