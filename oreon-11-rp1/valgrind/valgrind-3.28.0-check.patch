@@ -1,4 +1,4 @@
 prog: madv_guard
 vgopts: -q --sanity-level=3
 stdout_filter: filter_madv_guard
-prereq: test -e ./madv_guard
+prereq: test -e ./madv_guard && sh madv_guard.prereq
diff -ruN a/memcheck/tests/linux/madv_guard.prereq b/memcheck/tests/linux/madv_guard.prereq
--- /dev/null
+++ b/memcheck/tests/linux/madv_guard.prereq
@@ -0,0 +1,32 @@
+cat > madv_guard_prereq.c << 'EOF'
+#define _GNU_SOURCE
+#include <sys/mman.h>
+#include <stdint.h>
+#include <unistd.h>
+#include <fcntl.h>
+int main(void)
+{
+  long ps = sysconf(_SC_PAGESIZE);
+  void *p = mmap(0, (size_t)ps, PROT_READ | PROT_WRITE,
+                 MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  uint64_t entry = 0;
+  int fd;
+  if (p == MAP_FAILED)
+    return 1;
+  if (madvise(p, (size_t)ps, MADV_GUARD_INSTALL) != 0)
+    return 1;
+  fd = open("/proc/self/pagemap", O_RDONLY);
+  if (fd < 0)
+    return 1;
+  if (pread(fd, &entry, sizeof(entry),
+            ((uintptr_t)p / (uintptr_t)ps) * sizeof(entry))
+      != (ssize_t)sizeof(entry))
+    return 1;
+  return ((entry >> 58) & 1) ? 0 : 1;
+}
+EOF
+gcc -o madv_guard_prereq madv_guard_prereq.c >/dev/null 2>&1
+rc=$?
+if [ $rc -eq 0 ]; then ./madv_guard_prereq; rc=$?; fi
+rm -f madv_guard_prereq madv_guard_prereq.c
+exit $rc
