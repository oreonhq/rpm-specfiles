--- a/dola-bsx-api/src/main/java/io/kojan/dola/rpm/RPM.java
+++ b/dola-bsx-api/src/main/java/io/kojan/dola/rpm/RPM.java
@@ -26,7 +26,33 @@
     // Load the Lujavrite native shared library necessary to interface with Lua.
     // This library provides native support for the Lua-Java bridge.
     static {
-        System.load("/usr/lib64/lua/5.4/lujavrite.so");
+        String lib = System.getProperty("lujavrite.lib");
+        if (lib == null || lib.isEmpty()) {
+            lib = findLujavrite();
+        }
+        if (lib == null) {
+            System.loadLibrary("lujavrite");
+        } else {
+            System.load(lib);
+        }
+    }
+
+    private static String findLujavrite() {
+        String[] roots = {"/usr/lib64/lua", "/usr/lib/lua"};
+        java.nio.file.Path best = null;
+        for (String root : roots) {
+            java.nio.file.Path dir = java.nio.file.Path.of(root);
+            try (java.util.stream.Stream<java.nio.file.Path> s = java.nio.file.Files.list(dir)) {
+                for (java.nio.file.Path v : s.filter(java.nio.file.Files::isDirectory).sorted().toList()) {
+                    java.nio.file.Path f = v.resolve("lujavrite.so");
+                    if (java.nio.file.Files.isRegularFile(f)) {
+                        best = f;
+                    }
+                }
+            } catch (Exception e) {
+            }
+        }
+        return best == null ? null : best.toString();
     }
 
