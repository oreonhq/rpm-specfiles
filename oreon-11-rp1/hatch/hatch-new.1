.TH HATCH\-NEW "1" "August 2024" "" "User Commands"
.SH NAME
.B hatch\ new
\(en Create or initialize a project
.SH SYNOPSIS
.B hatch\ new
.RI [ OPTIONS ]
.RI [ NAME ]
.RI [ LOCATION ]
.SH OPTIONS
.TP
.B \-i\fR, \fB\-\-interactive
Interactively choose details about the project
.TP
.B \-\-cli
Give the project a command line interface
.TP
.B \-\-init
Initialize an existing project
.TP
.B \-h\fR, \fB\-\-help
Show a help message and exit
.SH "SEE ALSO"
.BR hatch\-build (1),
.BR hatch\-clean (1),
.BR hatch\-config (1),
.BR hatch\-dep (1),
.BR hatch\-env (1),
.BR hatch\-fmt (1),
.BR hatch\-project (1),
.BR hatch\-publish (1),
.BR hatch\-python (1),
.BR hatch\-run (1),
.BR hatch\-self (1),
.BR hatch\-shell (1),
.BR hatch\-status (1),
.BR hatch\-test (1),
.BR hatch\-version (1)
.P
.BR hatch (1)
