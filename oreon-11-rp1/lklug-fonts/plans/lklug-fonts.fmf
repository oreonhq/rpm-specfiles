summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: lklug-fonts
execute:
    how: tmt
environment:
    PACKAGE: lklug-fonts
    FONT_ALIAS: sans-serif
    FONT_FAMILY: LKLUG
    FONT_LANG: si
    DEFAULT_SANS: 2
    DEFAULT_SERIF: 2
    DEFAULT_MONO: 2
