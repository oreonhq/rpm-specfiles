From 14d355fbc6fce30b879f1bb1d360107fc0c1b9f9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ralf=20Cors=C3=A9pius?= <corsepiu@fedoraproject.org>
Date: Sat, 25 Jan 2025 17:59:44 +0100
Subject: [PATCH] Fix bool detection

---
 src/C_XS/ToolBox.h | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/C_XS/ToolBox.h b/src/C_XS/ToolBox.h
index c2efcbe..ce74c02 100644
--- a/src/C_XS/ToolBox.h
+++ b/src/C_XS/ToolBox.h
@@ -9,7 +9,7 @@ extern "C"
 /*****************************************************************************/
 /*  MODULE IMPORTS:                                                          */
 /*****************************************************************************/
-#ifdef PERL_DARWIN
+#if defined(PERL_DARWIN) || (defined __STDC_VERSION__ && __STDC_VERSION__ > 201710L)
 #include <stdbool.h>
 #endif
 /*****************************************************************************/
@@ -94,9 +94,13 @@ typedef  Z_longword         *Z_longwordptr;
         #define boolean bool
     #else
         typedef int boolean;
+#if defined __STDC_VERSION__ && __STDC_VERSION__ > 201710L
+/* bool, true and false are keywords.  */
+#else
         #ifndef I_STDBOOL
          enum { false, true };
         #endif 
+#endif
     #endif
 #endif
 
