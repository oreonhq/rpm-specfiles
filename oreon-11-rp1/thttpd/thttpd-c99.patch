Various tweaks to port to C99.  Obtaining the sigset definition
is tricky; introducing e.g. -D_GNU_SOURCE everywhere seems risky.

diff --git a/configure b/configure
index bb2d78f589572ad1..85c59cf27452f32a 100755
--- a/configure
+++ b/configure
@@ -761,7 +761,7 @@ cat > conftest.$ac_ext << EOF
 #line 762 "configure"
 #include "confdefs.h"
 
-main(){return(0);}
+int main(){return(0);}
 EOF
 if { (eval echo configure:767: \"$ac_link\") 1>&5; (eval $ac_link) 2>&5; } && test -s conftest${ac_exeext}; then
   ac_cv_prog_cc_works=yes
@@ -880,7 +880,7 @@ if eval "test \"`echo '$''{'ac_cv_lbl_static_flag'+set}'`\" = set"; then
   echo $ac_n "(cached) $ac_c" 1>&6
 else
   ac_cv_lbl_static_flag=unknown
-    echo 'main() {}' > conftest.c
+    echo 'int main() {}' > conftest.c
     if test "$GCC" != yes ; then
 	    trial_flag="-Bstatic"
 	    test=`$CC $trial_flag -o conftest conftest.c 2>&1`
@@ -913,6 +913,7 @@ else
   cat > conftest.$ac_ext <<EOF
 #line 915 "configure"
 #include "confdefs.h"
+#include <stdio.h>
 
 int main() {
 extern char *__progname; 
@@ -2046,13 +2047,14 @@ else
