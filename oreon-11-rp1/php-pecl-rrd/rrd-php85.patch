+#else
+#include "Zend/zend_smart_string.h"
+#endif
 
 #include <rrd.h>
 
diff --git a/rrd_update.c b/rrd_update.c
index 1fc4573..e21c778 100644
--- a/rrd_update.c
+++ b/rrd_update.c
@@ -14,7 +14,11 @@
 
