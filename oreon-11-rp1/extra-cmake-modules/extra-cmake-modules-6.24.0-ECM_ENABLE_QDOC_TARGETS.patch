diff -up a/modules/ECMGenerateQDoc.cmake b/modules/ECMGenerateQDoc.cmake
--- a/modules/ECMGenerateQDoc.cmake
+++ b/modules/ECMGenerateQDoc.cmake
@@ -48,13 +48,24 @@ Since 6.11.0.
 #]=======================================================================]
 
 cmake_policy(VERSION 3.16)
 
-add_custom_target(prepare_docs)
-add_custom_target(generate_docs)
-add_custom_target(install_html_docs)
-add_custom_target(generate_qch)
-add_custom_target(install_qch_docs)
+# Distributors can set -DECM_ENABLE_QDOC_TARGETS=OFF to avoid registering
+# qdoc targets (useful when qdoc crashes in minimal or hardened build roots).
+if(NOT DEFINED ECM_ENABLE_QDOC_TARGETS)
+    option(ECM_ENABLE_QDOC_TARGETS "Register qdoc documentation targets (prepare_docs, generate_docs, ...)" ON)
+endif()
+
+if(ECM_ENABLE_QDOC_TARGETS)
+    add_custom_target(prepare_docs)
+    add_custom_target(generate_docs)
+    add_custom_target(install_html_docs)
+    add_custom_target(generate_qch)
+    add_custom_target(install_qch_docs)
+endif()
 
 function(ecm_generate_qdoc target qdocconf_file)
+    if(NOT ECM_ENABLE_QDOC_TARGETS)
+        return()
+    endif()
     find_package(Qt6Tools CONFIG QUIET)
     find_package(Qt6 OPTIONAL_COMPONENTS ToolsTools CONFIG QUIET)
 
