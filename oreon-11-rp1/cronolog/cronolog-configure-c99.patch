Generic C99 compatibility fixes for the configure script.  These
are problems that have already been fixed in autoconf.

diff -ur cronolog-1.6.2.orig/configure cronolog-1.6.2/configure
--- cronolog-1.6.2.orig/configure	2001-05-03 18:44:22.000000000 +0200
+++ cronolog-1.6.2/configure	2022-11-28 13:06:03.159326049 +0100
@@ -946,7 +946,7 @@
 #line 947 "configure"
 #include "confdefs.h"
 
-main(){return(0);}
+int main(){return(0);}
 EOF
 if { (eval echo configure:952: \"$ac_link\") 1>&5; (eval $ac_link) 2>&5; } && test -s conftest${ac_exeext}; then
   ac_cv_prog_cc_works=yes
@@ -1351,8 +1351,8 @@
 #define TOUPPER(c) (ISLOWER(c) ? 'A' + ((c) - 'a') : (c))
 #define XOR(e, f) (((e) && !(f)) || (!(e) && (f)))
 int main () { int i; for (i = 0; i < 256; i++)
-if (XOR (islower (i), ISLOWER (i)) || toupper (i) != TOUPPER (i)) exit(2);
-exit (0); }
+if (XOR (islower (i), ISLOWER (i)) || toupper (i) != TOUPPER (i)) return 2;
+return 0; }
 
 EOF
 if { (eval echo configure:1359: \"$ac_link\") 1>&5; (eval $ac_link) 2>&5; } && test -s conftest${ac_exeext} && (./conftest; exit) 2>/dev/null
