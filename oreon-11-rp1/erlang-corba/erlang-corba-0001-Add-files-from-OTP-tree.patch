@@ -113,7 +114,7 @@ opt debug release docs release_docs clean depend xmllint:
 	    fi ;							\
 	done ;
 
-install install-docs: TESTROOT=$(DESTDIR)$(shell $(MAKE) -f $(ERL_TOP)/Makefile erlang_inst_libdir_configured)
