[Unit]
Description=Vaultwarden API server
After=network.target

[Service]
Type=simple
User=vaultwarden
Group=vaultwarden
Environment="ENV_FILE=/etc/vaultwarden/vaultwarden.cfg"
ExecStart=/usr/bin/vaultwarden
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
WorkingDirectory=/var/lib/vaultwarden

[Install]
WantedBy=multi-user.target
