+/**
+ * Set the part-uuid of the partition \p part. This will only work if the disk label
+ * supports it.
+ */
+int
+ped_partition_set_uuid (PedPartition *part, const uint8_t* uuid)
+{
+        PED_ASSERT (part != NULL);
+        PED_ASSERT (part->disk != NULL);
+        PED_ASSERT (ped_partition_is_active (part));
+
+        if (!_assert_partition_uuid_feature (part->disk->type))
+                return 0;
+
+        PED_ASSERT (part->disk->type->ops->partition_set_uuid != NULL);
+        return part->disk->type->ops->partition_set_uuid (part, uuid);
+}
+
 /**
  * Get the uuid of the partition \p part. This will only work if the disk label
  * supports it.
diff --git a/libparted/labels/gpt.c b/libparted/labels/gpt.c
index ac40ec82..d63482f5 100644
--- a/libparted/labels/gpt.c
+++ b/libparted/labels/gpt.c
@@ -1809,6 +1809,25 @@ gpt_partition_get_type_uuid (const PedPartition *part)
   return buf;
 }
 
+
+static int
+gpt_partition_set_uuid (PedPartition *part, const uint8_t *uuid)
+{
+  GPTPartitionData *gpt_part_data = part->disk_specific;
+
+  efi_guid_t* part_uuid = &gpt_part_data->uuid;
+  memcpy(part_uuid, uuid, sizeof (efi_guid_t));
+
+  /* part_uuid is always LE, while uint8_t is always kind of BE */
+
+  part_uuid->time_low = PED_SWAP32(part_uuid->time_low);
+  part_uuid->time_mid = PED_SWAP16(part_uuid->time_mid);
+  part_uuid->time_hi_and_version = PED_SWAP16(part_uuid->time_hi_and_version);
+
+  return 1;
+}
+
