   plugins/main/vlan \
   plugins/meta/bandwidth \
   plugins/meta/firewall \
   plugins/meta/portmap \
   plugins/meta/sbr \
   plugins/meta/tuning \
   plugins/meta/vrf \
   plugins/sample; do
  %gobuild -o %{gobuilddir}/bin/$(basename $cmd) %{goipath}/$cmd
done

