summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: lohit-assamese-fonts
execute:
    how: tmt
environment:
    PACKAGE: lohit-assamese-fonts
    FONT_ALIAS: sans-serif
    FONT_FAMILY: Lohit Assamese
    FONT_LANG: as
    DEFAULT_SANS: 2
    DEFAULT_SERIF: 2
    DEFAULT_MONO: 2
