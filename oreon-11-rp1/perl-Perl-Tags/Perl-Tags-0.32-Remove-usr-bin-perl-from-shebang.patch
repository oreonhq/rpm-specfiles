From 57cfbdb37c7b42554ecdda2339bb82acfd03e7d3 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Petr=20P=C3=ADsa=C5=99?= <ppisar@redhat.com>
Date: Tue, 7 Nov 2017 15:54:27 +0100
Subject: [PATCH] Remove /usr/bin/perl from shebang
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

This is forbidded by packaging policy now.

Signed-off-by: Petr Písař <ppisar@redhat.com>
---
 bin/perl-tags                | 2 +-
 bin/require-perl-tags        | 2 +-
 bin/require-perl-tags-packed | 7 ++++---
 lib/App/Perl/Tags.pm         | 1 -
 4 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/bin/perl-tags b/bin/perl-tags
index 7497a16..813f4a8 100644
--- a/bin/perl-tags
+++ b/bin/perl-tags
@@ -1,4 +1,4 @@
-#!/usr/bin/env perl
+#!perl
 use 5.006;
 use strict;
 use warnings;
diff --git a/bin/require-perl-tags b/bin/require-perl-tags
index d9e9435..3e0fa5f 100644
--- a/bin/require-perl-tags
+++ b/bin/require-perl-tags
@@ -1,4 +1,4 @@
-#!/usr/bin/env perl
+#!perl
 use 5.006;
 use strict; use warnings;
 
diff --git a/bin/require-perl-tags-packed b/bin/require-perl-tags-packed
index d873f32..45ad313 100644
--- a/bin/require-perl-tags-packed
+++ b/bin/require-perl-tags-packed
@@ -1,12 +1,13 @@
-#!/usr/bin/env perl
+#!perl
 
 # This chunk of stuff was generated by App::FatPacker. To find the original
 # file's code, look for the end of this BEGIN block or the string 'FATPACK'
 BEGIN {
 my %fatpacked;
 
-$fatpacked{"App/Perl/Tags.pm"} = '#line '.(1+__LINE__).' "'.__FILE__."\"\n".<<'APP_PERL_TAGS';
-  #!/usr/bin/env perl
+require Config;
+$fatpacked{"App/Perl/Tags.pm"} = '#line '.(1+__LINE__).' "'.__FILE__."\"\n".
+    $Config::Config{startperl}."\n".<<'APP_PERL_TAGS';
   use 5.006;
   use strict; use warnings;
   
diff --git a/lib/App/Perl/Tags.pm b/lib/App/Perl/Tags.pm
index 639199c..fbc54ff 100644
--- a/lib/App/Perl/Tags.pm
+++ b/lib/App/Perl/Tags.pm
@@ -1,4 +1,3 @@
-#!/usr/bin/env perl
 use 5.006;
 use strict; use warnings;
 
-- 
2.13.6

