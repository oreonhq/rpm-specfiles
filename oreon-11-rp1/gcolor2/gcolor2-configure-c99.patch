Avoid implicit function declarations in the configure script.
Future compilers are likely to reject them, and that would alter
the configure check results.

No need to upstream this because re-running autoconf fixes these
issues.

diff --git a/aclocal.m4 b/aclocal.m4
index 2cfe3504a48ca87c..80094ea64da1419b 100644
--- a/aclocal.m4
+++ b/aclocal.m4
@@ -1750,10 +1750,6 @@ else
 #  endif
 #endif
 
-#ifdef __cplusplus
-extern "C" void exit (int);
-#endif
-
 void fnord() { int i=42;}
 int main ()
 {
@@ -1767,7 +1763,7 @@ int main ()
       /* dlclose (self); */
     }
 
-    exit (status);
+    return status;
 }]
 EOF
   if AC_TRY_EVAL(ac_link) && test -s conftest${ac_exeext} 2>/dev/null; then
diff --git a/configure b/configure
index 842ad23f4ecc4de0..91d530922b47d2f1 100755
--- a/configure
+++ b/configure
@@ -2751,7 +2751,7 @@ if { (eval echo "$as_me:$LINENO: \"$ac_compile\"") >&5
   echo "$as_me:$LINENO: \$? = $ac_status" >&5
   (exit $ac_status); }; }; then
   for ac_declaration in \
-   '' \
+   '#include <stdlib.h>' \
    'extern "C" void std::exit (int) throw (); using std::exit;' \
    'extern "C" void std::exit (int); using std::exit;' \
    'extern "C" void exit (int) throw ();' \
@@ -4160,8 +4160,8 @@ main ()
   for (i = 0; i < 256; i++)
     if (XOR (islower (i), ISLOWER (i))
 	|| toupper (i) != TOUPPER (i))
-      exit(2);
-  exit (0);
+      return 2;
+  return 0;
 }
 _ACEOF
 rm -f conftest$ac_exeext
