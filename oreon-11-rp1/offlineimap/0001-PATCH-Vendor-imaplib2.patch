 # Ensure that `ui` gets loaded before `threadutil` in order to
 # break the circular dependency between `threadutil` and `Curses`.
diff --git a/pyproject.toml b/pyproject.toml
index 9fefd55..22807be 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,7 +1,6 @@
 [project]
 dependencies = [
     "distro",
-    "imaplib2>=3.5",
     "rfc6555",
     "urllib3~=1.25.9"
 ]
diff --git a/requirements.txt b/requirements.txt
index 9070773..5ab7ee9 100644
--- a/requirements.txt
+++ b/requirements.txt
@@ -1,5 +1,4 @@
 # Requirements
