From 62cfeb362a3f3581370308241d343deac36282f7 Mon Sep 17 00:00:00 2001
From: serge-sans-paille <serge.guelton@telecom-bretagne.eu>
Date: Wed, 29 Oct 2025 00:55:47 +0100
Subject: [PATCH 4/4] [PATCH] Loosen urllib3 requirements

---
 pyproject.toml   | 2 +-
 requirements.txt | 2 +-
 setup.py         | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 8022726..b0b3dfe 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,7 +1,7 @@
 [project]
 dependencies = [
     "distro",
-    "urllib3~=1.25.9"
+    "urllib3"
 ]
 name = "offlineimap"
 version = "8.0.1"
diff --git a/requirements.txt b/requirements.txt
index b54ed58..f906ab8 100644
--- a/requirements.txt
+++ b/requirements.txt
@@ -1,3 +1,3 @@
 # Requirements
 distro; python_version > "3.6"
-urllib3~=1.25.9
+urllib3
diff --git a/setup.py b/setup.py
index ba1adc5..23936fa 100644
--- a/setup.py
+++ b/setup.py
@@ -85,7 +85,7 @@ setup(name="offlineimap",
       setup_requires=['setuptools>=18.5', 'wheel'],
       license=copyright + ", Licensed under the GPL version 2",
       install_requires=['distro',
-                        'urllib3~=1.25.9'],
+                        'urllib3'],
       extras_require={'kerberos':'gssapi[kerberos]',
                       'keyring':'keyring[keyring]',
                       'cygwin':'portalocker[cygwin]',
-- 
2.51.0

