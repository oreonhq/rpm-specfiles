testgtk test_rtree:
	gprbuild -P testgtk.gpr -p ${GNAT_BUILDER_FLAGS} \
	         -cargs:Ada ${ADAFLAGS} \
	         -cargs:C `pkg-config --cflags glib-2.0` ${CPPFLAGS} ${CFLAGS} \
	         -bargs ${GNATBINDFLAGS} \
	         -largs -Wl,--as-needed `pkg-config --libs glib-2.0 gtk+-3.0` -lm ${LDFLAGS}
