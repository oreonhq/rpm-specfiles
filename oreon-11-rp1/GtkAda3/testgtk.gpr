with "gtkada.gpr";

project TestGTK is

   for Languages use ("Ada");
   for Main use ("testgtk.adb", "test_rtree.adb");
   for Source_Dirs use (".", "task_project/src");
   for Object_Dir use "obj";
   for Exec_Dir use ".";

end TestGTK;
