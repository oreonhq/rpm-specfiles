with "directories";

library project GTKada is
   for Library_Name     use "gtkada";
   for Library_Kind     use "dynamic";
   for Source_Dirs      use (Directories.Includedir & "/gtkada");
   for Library_Dir      use Directories.Libdir;
   for Library_ALI_Dir  use Directories.Libdir & "/gtkada";
   for Externally_Built use "true";

   -- A horrible kludge in GPS's configuration script wants to see this line in
   -- this file:
   version := "@VERSION@";
end GTKada;
