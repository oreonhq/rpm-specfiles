From: Hannes Braun <hannes@hannesbraun.net>
Date: Sat, 26 Jul 2025 17:48:59 +0200
Subject: [PATCH 1/4] Fix ambiguous call to init in SimulationFrame

---
 spark/guiplugin/simulationframe/simulationframe.cpp | 4 ++--
 spark/guiplugin/simulationframe/simulationframe.h   | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/guiplugin/simulationframe/simulationframe.cpp b/spark/guiplugin/simulationframe/simulationframe.cpp
index de3870dd..beaa9c8a 100644
--- a/guiplugin/simulationframe/simulationframe.cpp
+++ b/guiplugin/simulationframe/simulationframe.cpp
@@ -48,7 +48,7 @@ SimulationFrame::SimulationFrame() :
     //Initialization
     mClosed = false;
     mSimulationManager = getCarbon()->getSimulationManager();
-    init();
+    initSimulationFrame();
 
     //-------------------
     //Settings
@@ -101,7 +101,7 @@ void SimulationFrame::saveSettings()
 // Private
 //--------------------------------------------------------------
 
-void SimulationFrame::init()
+void SimulationFrame::initSimulationFrame()
 {
     //Task Type list
     ui.tasksComboBox->clear();
diff --git a/guiplugin/simulationframe/simulationframe.h b/spark/guiplugin/simulationframe/simulationframe.h
index c9595ca3..975f89df 100644
--- a/guiplugin/simulationframe/simulationframe.h
+++ b/guiplugin/simulationframe/simulationframe.h
@@ -87,7 +87,7 @@ private:
     /*!
      \brief Initialize non-changing fields.
     */
-    void init();
+    void initSimulationFrame();
     /*!
      \brief Removes all task widgets.
     */
