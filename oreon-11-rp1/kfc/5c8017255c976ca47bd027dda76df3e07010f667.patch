From 5c8017255c976ca47bd027dda76df3e07010f667 Mon Sep 17 00:00:00 2001
From: Sergiy Stupar <owner@sestolab.pp.ua>
Date: Wed, 24 May 2023 16:26:58 +0300
Subject: [PATCH] Remove unneeded -lX11 from Makefile (#7)

---
 Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index da32f8d..5c97c85 100644
--- a/Makefile
+++ b/Makefile
@@ -6,7 +6,7 @@ CC     ?= gcc
 all: kfc
 
 kfc: kfc.c Makefile
-	$(CC) -O3 $(CFLAGS) -o $@ $< -lX11 $(LDFLAGS)
+	$(CC) -O3 $(CFLAGS) -o $@ $< $(LDFLAGS)
 
 install: all
 	install -Dm755 kfc $(DESTDIR)$(BINDIR)/kfc
