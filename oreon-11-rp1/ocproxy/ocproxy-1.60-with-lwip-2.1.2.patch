-
-  to.sin_len = sizeof(to);
-  to.sin_family = AF_INET;
-  to.sin_addr.s_addr = addr->addr;
-
-  lwip_sendto(s,iecho,sizeof(*iecho),0,(struct sockaddr*)&to,sizeof(to));
-
-  free(iecho);
-  seq_num++;
