-            do_tcp_test(s, &req, &master);
-            break;
-        case NC_REQUEST_START_IDLE:
-        case NC_REQUEST_STOP_IDLE:
-        case NC_REQUEST_SET_LOAD:
-        default:
-            break;
-        }
-    }
-    close(s);
-}
