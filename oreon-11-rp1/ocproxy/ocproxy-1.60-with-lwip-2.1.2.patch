-/*-----------------------------------------------------------------------------------*/
-static void
-low_level_init(struct netif *netif)
-{
-  struct tunif *tunif;
-  char buf[sizeof(IFCONFIG_CALL) + 50];
-
-  tunif = (struct tunif *)netif->state;
-
-  /* Obtain MAC address from network interface. */
-
