-//
-// Read data from a stream, accounting for the fact that packet 'boundaries'
-// are not preserved.  This can also timeout (which would probably wreck the
-// data boundaries).
-//
-
-int
-do_read(int fd, void *buf, int buflen)
-{
-    char *p = (char *)buf;
-    int len = buflen;
-    int res;
-    while (len) {
-        res = read(fd, p, len);
-        if (res < 0) {
-            perror("read");
-        } else {
-            len -= res;
-            p += res;
-            if (res == 0) {
-                break;
-            }
-        }
-    }
-    return (buflen - len);
-}
