-  fail_if((pos + len) > p->tot_len);
-  while (pos > p->len && p->next) {
-    pos -= p->len;
-    p = p->next;
-  }
-  fail_if(p == NULL);
-  fail_unless(pos + len <= p->len); /* All data we seek within same pbuf */
