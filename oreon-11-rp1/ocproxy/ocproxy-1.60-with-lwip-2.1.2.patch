-            ULONG a_addr = ((struct sockaddr_in *)a->addr)->sin_addr.s_addr;
-            ULONG a_netmask = ((struct sockaddr_in *)a->netmask)->sin_addr.s_addr;
-            ULONG a_netaddr = a_addr & a_netmask;
-            ULONG addr = (*netaddr).s_addr;
-            if (a_netaddr == addr) {
-               int ret = -1;
-               char name[128];
-               char *start, *end;
