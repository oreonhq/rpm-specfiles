-static int
-get_adapter_index_from_addr(struct in_addr *netaddr, char *guid, size_t guid_len)
-{
-   pcap_if_t *alldevs;
-   pcap_if_t *d;
-   char errbuf[PCAP_ERRBUF_SIZE+1];
-   int index = 0;
-
-   memset(guid, 0, guid_len);
