diff --git a/qt5ct/src/qt5ct-qtplugin/qt5ctplatformtheme.cpp b/qt5ct/src/qt5ct-qtplugin/qt5ctplatformtheme.cpp
index 37dacc4..ad920f2 100644
--- a/qt5ct/src/qt5ct-qtplugin/qt5ctplatformtheme.cpp
