diff --git a/qt5ct/src/qt5ct-qtplugin/CMakeLists.txt b/qt5ct/src/qt5ct-qtplugin/CMakeLists.txt
index 7ac6c82..aedb4a6 100644
--- a/qt5ct/src/qt5ct-qtplugin/CMakeLists.txt
