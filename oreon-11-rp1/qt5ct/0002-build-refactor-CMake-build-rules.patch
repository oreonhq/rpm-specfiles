diff --git a/qt5ct/src/qt5ct/main.cpp b/qt5ct/src/qt5ct/main.cpp
index a912b9c..5417fcc 100644
--- a/qt5ct/src/qt5ct/main.cpp
+++ b/qt5ct/src/qt5ct/main.cpp
@@ -42,8 +42,13 @@ int main(int argc, char **argv)
 
     QTranslator translator;
 
+#ifndef QT5CT_IN_TREE
     if(translator.load(QLocale(), QStringLiteral("qt5ct"), QStringLiteral("_"), QStringLiteral(":/")))
         QCoreApplication::installTranslator(&translator);
+#else
+    if(translator.load(QLocale(), QStringLiteral("qt5ct"), QStringLiteral("_"), QLibraryInfo::location(QLibraryInfo::TranslationsPath)))
+        QCoreApplication::installTranslator(&translator);
+#endif
 
     QTranslator qt_translator;
     if(qt_translator.load(QLocale(), QStringLiteral("qtbase"), QStringLiteral("_"), QLibraryInfo::location(QLibraryInfo::TranslationsPath)))
diff --git a/qt5ct/src/qt5ct/translations/CMakeLists.txt b/qt5ct/src/qt5ct/translations/CMakeLists.txt
new file mode 100644
index 0000000..6f3b337
--- /dev/null
+++ b/qt5ct/src/qt5ct/translations/CMakeLists.txt
@@ -0,0 +1,48 @@
+set(translation_SRCS
+    qt5ct_ar.ts
+    qt5ct_bg.ts
+    qt5ct_ca.ts
+    qt5ct_cs.ts
+    qt5ct_da.ts
+    qt5ct_de.ts
+    qt5ct_el.ts
+    qt5ct_en.ts
+    qt5ct_es_ES.ts
+    qt5ct_es.ts
+    qt5ct_fi.ts
+    qt5ct_fr.ts
+    qt5ct_gl_ES.ts
+    qt5ct_he.ts
+    qt5ct_hu.ts
+    qt5ct_it_IT.ts
+    qt5ct_it.ts
+    qt5ct_ja.ts
+    qt5ct_kk.ts
+    qt5ct_lt.ts
+    qt5ct_nl_NL.ts
+    qt5ct_nl.ts
+    qt5ct_pl.ts
+    qt5ct_pt_BR.ts
+    qt5ct_pt.ts
+    qt5ct_ru.ts
+    qt5ct_sk.ts
+    qt5ct_sr_BA.ts
+    qt5ct_sr_RS.ts
+    qt5ct_sr.ts
+    qt5ct_tr.ts
+    qt5ct_uk.ts
+    qt5ct_zh_CN.ts
+    qt5ct_zh_TW.ts
+)
+
+qt5_add_translation(app_LANGS ${translation_SRCS} OPTIONS -silent)
+set_source_files_properties(${app_LANGS} PROPERTIES GENERATED TRUE)
+add_custom_target(app_translations DEPENDS ${app_LANGS})
+
+if(QT5CT_IN_TREE)
+  install(FILES ${app_LANGS} DESTINATION ${QT_INSTALL_TRANSLATIONS})
+else()
+  configure_file(translations.qrc translations.qrc COPYONLY)
+  qt5_add_resources(lang_RC ${CMAKE_CURRENT_BINARY_DIR}/translations.qrc)
+  add_library(app_resources INTERFACE ${lang_RC})
+endif()
