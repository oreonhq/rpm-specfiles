diff --git a/qt5ct/src/qt5ct-common/qt5ct.cpp b/qt5ct/src/qt5ct-common/qt5ct.cpp
index 3ec88d7..6ab1c51 100644
--- a/qt5ct/src/qt5ct-common/qt5ct.cpp
+++ b/qt5ct/src/qt5ct-common/qt5ct.cpp
@@ -36,7 +36,7 @@
 #include <QtDebug>
 #include "qt5ct.h"
 
-#ifndef QT5CT_DATADIR
+#if !defined(QT5CT_IN_TREE) && !defined(QT5CT_DATADIR)
 #define QT5CT_DATADIR "/usr/share"
 #endif
 
@@ -97,7 +97,9 @@ QStringList Qt5CT::sharedStyleSheetPaths()
     {
         paths << (p + QLatin1String("/qt5ct/qss"));
     }
+#ifndef QT5CT_IN_TREE
     paths << QLatin1String(QT5CT_DATADIR"/qt5ct/qss");
+#endif
     paths.removeDuplicates();
     return paths;
 }
@@ -119,7 +121,9 @@ QStringList Qt5CT::sharedColorSchemePaths()
     {
         paths << (p + QLatin1String("/qt5ct/colors"));
     }
+#ifndef QT5CT_IN_TREE
     paths << QLatin1String(QT5CT_DATADIR"/qt5ct/colors");
+#endif
     paths.removeDuplicates();
     return paths;
 }
diff --git a/qt5ct/src/qt5ct-common/qt5ct.h b/qt5ct/src/qt5ct-common/qt5ct.h
index 7a1a426..cd06bbc 100644
--- a/qt5ct/src/qt5ct-common/qt5ct.h
+++ b/qt5ct/src/qt5ct-common/qt5ct.h
