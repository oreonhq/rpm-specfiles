 set(app_SRCS
   appearancepage.cpp
@@ -24,10 +24,15 @@ set(app_SRCS
   qsseditordialog.ui
   qsspage.ui
   troubleshootingpage.ui
-  translations/translations.qrc
 )
 
 add_executable(qt5ct ${app_SRCS})
+add_dependencies(qt5ct app_translations)
 target_link_libraries(qt5ct PRIVATE Qt5::Widgets Qt5::Concurrent Qt5::WidgetsPrivate qt5ct-common)
+
+if(NOT QT5CT_IN_TREE)
+  target_link_libraries(qt5ct PRIVATE app_resources)
