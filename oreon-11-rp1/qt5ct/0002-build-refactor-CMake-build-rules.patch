diff --git a/qt5ct/CMakeLists.txt b/qt5ct/CMakeLists.txt
index 59256fd..cb53e8f 100644
--- a/qt5ct/CMakeLists.txt
+++ b/qt5ct/CMakeLists.txt
@@ -1,9 +1,15 @@
-cmake_minimum_required(VERSION 3.11.0)
+cmake_minimum_required(VERSION 3.16.0)
 
-project(qt5ct LANGUAGES CXX)
+project(qt5ct LANGUAGES CXX VERSION 1.9)
 
 include(GNUInstallDirs)
 
+find_package(ECM REQUIRED NO_MODULE)
+set(CMAKE_MODULE_PATH ${ECM_MODULE_PATH})
+
+option(DISABLE_DBUS "disable D-Bus support (global menu and D-Bus tray icon implementation)" OFF)
+option(QT5CT_IN_TREE "act as an in-tree Qt module, use standard Qt paths, unbundle language files, etc." OFF)
+
 CONFIGURE_FILE(
   "${CMAKE_CURRENT_SOURCE_DIR}/cmake_uninstall.cmake.in"
   "${CMAKE_CURRENT_BINARY_DIR}/cmake_uninstall.cmake"
@@ -23,9 +29,7 @@ set(CMAKE_AUTOUIC ON)
 set(CMAKE_BUILD_RPATH_USE_ORIGIN ON)
 set(QT_MINIMUM_VERSION "5.15.0")
 
-option(DISABLE_DBUS "disable D-Bus support (global menu and D-Bus tray icon implementation)" OFF)
-
-ADD_DEFINITIONS(-DQT_DISABLE_DEPRECATED_BEFORE=0x050C00 -DUSE_WIDGETS)
+add_compile_definitions(-DQT_DISABLE_DEPRECATED_BEFORE=0x050C00 -DUSE_WIDGETS)
 
 find_package(Qt5 ${QT_MINIMUM_VERSION} COMPONENTS Widgets Concurrent LinguistTools REQUIRED)
 find_package(Qt5Gui ${QT_MINIMUM_VERSION} CONFIG REQUIRED Private)
@@ -37,30 +41,9 @@ else()
     message(STATUS "D-Bus support: Disabled")
 endif()
 
-get_target_property(QT_LRELEASE_EXECUTABLE Qt5::lrelease IMPORTED_LOCATION)
-
-if(QT_LRELEASE_EXECUTABLE)
-    message(STATUS "Found lrelease executable: " ${QT_LRELEASE_EXECUTABLE})
-else()
-    message(FATAL_ERROR "Could NOT find lrelease executable")
-endif()
-
-get_filename_component(QT_QTPATHS_EXECUTABLE ${QT_LRELEASE_EXECUTABLE} DIRECTORY)
-set(QT_QTPATHS_EXECUTABLE ${QT_QTPATHS_EXECUTABLE}/qtpaths)
-
-if(EXISTS ${QT_QTPATHS_EXECUTABLE})
-    message(STATUS "Found qtpaths executable: " ${QT_QTPATHS_EXECUTABLE})
-else()
-    message(FATAL_ERROR "Could NOT find qtpaths executable")
-endif()
-
-execute_process(COMMAND ${QT_QTPATHS_EXECUTABLE} --plugin-dir OUTPUT_VARIABLE PLUGINDIR OUTPUT_STRIP_TRAILING_WHITESPACE)
-message(STATUS "Plugin path: " ${PLUGINDIR})
-
-message(STATUS "Generating translations ...")
-execute_process(COMMAND find ${CMAKE_CURRENT_SOURCE_DIR} -name *.ts COMMAND xargs ${QT_LRELEASE_EXECUTABLE} -silent)
-
-include_directories(${CMAKE_CURRENT_SOURCE_DIR}/src/qt5ct-common)
+include(ECMQueryQt)
+ecm_query_qt(QT_INSTALL_PLUGINS QT_INSTALL_PLUGINS)
+ecm_query_qt(QT_INSTALL_TRANSLATIONS QT_INSTALL_TRANSLATIONS)
 
 add_link_options(-Wl,--no-undefined)
 add_subdirectory(src/qt5ct-common)
diff --git a/qt5ct/src/qt5ct-common/CMakeLists.txt b/qt5ct/src/qt5ct-common/CMakeLists.txt
index f15112b..30c29ca 100644
--- a/qt5ct/src/qt5ct-common/CMakeLists.txt
+++ b/qt5ct/src/qt5ct-common/CMakeLists.txt
@@ -1,30 +1,17 @@
-project(qt5ct-common)
+block()
+  set(QT5CT_VERSION_MAJOR "${CMAKE_PROJECT_VERSION_MAJOR}")
+  set(QT5CT_VERSION_MINOR "${CMAKE_PROJECT_VERSION_MINOR}")
+  configure_file(config.h.in config.h @ONLY)
+endblock()
 
-#extract version from qt5ct.h
-file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/qt5ct.h"
-     QT5CT_VERSION_DATA REGEX "^#define[ \t]+QT5CT_VERSION_[A-Z]+[ \t]+[0-9]+.*$")
-
-if(QT5CT_VERSION_DATA)
-  foreach(item IN ITEMS MAJOR MINOR)
-    string(REGEX REPLACE ".*#define[ \t]+QT5CT_VERSION_${item}[ \t]+([0-9]+).*"
-       "\\1" QT5CT_VERSION_${item} ${QT5CT_VERSION_DATA})
-  endforeach()
-  set(QT5CT_VERSION "${QT5CT_VERSION_MAJOR}.${QT5CT_VERSION_MINOR}")
-  set(QT5CT_SOVERSION "${QT5CT_VERSION_MAJOR}")
-  message(STATUS "qt5ct version: ${QT5CT_VERSION}")
-else()
-  message(FATAL_ERROR "invalid header")
-endif()
-
-add_definitions(-DQT5CT_LIBRARY)
-
-set(app_SRCS
+set(lib_SRCS
   qt5ct.cpp
 )
 
-include_directories(${CMAKE_CURRENT_SOURCE_DIR}/../)
-
-add_library(qt5ct-common SHARED ${app_SRCS})
-set_target_properties(qt5ct-common PROPERTIES VERSION ${QT5CT_VERSION})
+add_library(qt5ct-common SHARED ${lib_SRCS})
+set_target_properties(qt5ct-common PROPERTIES VERSION ${CMAKE_PROJECT_VERSION})
+target_compile_definitions(qt5ct-common PRIVATE -DQT5CT_LIBRARY -DQT5CT_HAVE_CONFIG_H)
+target_include_directories(qt5ct-common PUBLIC ${CMAKE_CURRENT_BINARY_DIR})
+target_include_directories(qt5ct-common INTERFACE ${CMAKE_CURRENT_SOURCE_DIR})
 target_link_libraries(qt5ct-common PRIVATE Qt5::Core Qt5::Gui)
 install(TARGETS qt5ct-common DESTINATION ${CMAKE_INSTALL_LIBDIR})
