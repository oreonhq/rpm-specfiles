%global source0_hash none

# Warning:
# Anyone editing this spec file please make sure the same spec file
# works on other fedora and epel releases, which are supported by this software.
# No quick Rawhide-only fixes will be allowed.

Name:			gpaw-setups
Version:		24.11.0
Release:		4%{?dist}
Summary:		Atomic GPAW setups

# Automatically converted from old format: GPLv3+ - review is highly recommended.
License:		GPL-3.0-or-later
URL:			https://wiki.fysik.dtu.dk/gpaw/
Source0:		https://wiki.fysik.dtu.dk/gpaw-files/%{name}-%{version}.tar.gz

BuildArch:		noarch

%description
Atomic GPAW setups. A setup is to the PAW method what
a pseudo-potential is to the pseudo-potential method.

%prep
%setup -q -n %{name}-%{version}

%build

# Starting from https://gitlab.com/gpaw/gpaw/-/commit/66b6638fc45de55dfa69cd799b65b97dfc861b6c
# GPAW_SETUP_PATH must be explicitly set, there is no default
cat <<EOF > %{name}.sh
# NOTE: This is an automatically-generated file!  (generated by the
# %%{name} RPM).  Any changes made here will be lost if the RPM is
# uninstalled or upgraded.

PA=%{_datadir}/%{name}

case \$GPAW_SETUP_PATH in
*\${PA}*);;
*) GPAW_SETUP_PATH=\${PA};;
esac
export GPAW_SETUP_PATH

EOF

cat <<EOF > %{name}.csh
# NOTE: This is an automatically-generated file!  (generated by the
# %%{name} RPM).  Any changes made here will be lost if the RPM is
# uninstalled or upgraded.

set PA=%{_datadir}/%{name}

if (\$?GPAW_SETUP_PATH) then
if ("\$GPAW_SETUP_PATH" !~ *\${PA}*) then
	setenv GPAW_SETUP_PATH \${PA}
endif
else
setenv GPAW_SETUP_PATH \${PA}
endif

unset PA

EOF

%install

mkdir -p %{buildroot}%{_datadir}/%{name}
install -p -m 444 *.{gz,pckl,txt} %{buildroot}%{_datadir}/%{name}

mkdir -p $RPM_BUILD_ROOT%{_sysconfdir}/profile.d
install -p -m 444 %{name}*.*sh $RPM_BUILD_ROOT%{_sysconfdir}/profile.d

%files
%doc COPYING LICENSE
%config(noreplace) %{_sysconfdir}/profile.d/%{name}.*sh
%{_datadir}/%{name}

%changelog
%autochangelog
