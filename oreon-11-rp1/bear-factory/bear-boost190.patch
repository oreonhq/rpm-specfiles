From 62eb2ae4b93c1c221386f31692b37dd6af363305 Mon Sep 17 00:00:00 2001
From: Jonathan Wakely <jwakely@redhat.com>
Date: Tue, 16 Dec 2025 14:31:40 +0000
Subject: [PATCH 1/2] Remove all -std=c++11 options from build files

---
 Makefile                                     | 2 +-
 bear-engine/test/entity-count/CMakeLists.txt | 2 +-
 cmake-helper/compiler-defaults.cmake         | 1 -
 3 files changed, 2 insertions(+), 3 deletions(-)

diff --git a/Makefile b/Makefile
index 8a43e723..609b9d65 100644
--- a/Makefile
+++ b/Makefile
@@ -1,5 +1,5 @@
 CFLAGS=-Wall -Wno-sign-compare -fdiagnostics-color=always -fext-numeric-literals
-CXXFLAGS= $(CFLAGS) -std=c++11
+CXXFLAGS= $(CFLAGS)
 LDFLAGS=
 
 CMAKE_BUILD_TYPE=
diff --git a/bear-engine/test/entity-count/CMakeLists.txt b/bear-engine/test/entity-count/CMakeLists.txt
index 69b0903a..48d4e797 100644
--- a/bear-engine/test/entity-count/CMakeLists.txt
+++ b/bear-engine/test/entity-count/CMakeLists.txt
@@ -2,7 +2,7 @@ cmake_minimum_required(VERSION 2.8)
 
 set( BEAR_ROOT_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/../../../" )
 set(CMAKE_CXX_FLAGS
-  "${CMAKE_CXX_FLAGS} -std=c++11 -Wall -pedantic -fdiagnostics-color=always")
+  "${CMAKE_CXX_FLAGS} -Wall -pedantic -fdiagnostics-color=always")
 
 # The engine comes with some CMake scripts to ease its configuration and usage.
 # These scripts are in the directory below and must be assigned to
diff --git a/cmake-helper/compiler-defaults.cmake b/cmake-helper/compiler-defaults.cmake
index 54f0be2f..d02604d4 100644
--- a/cmake-helper/compiler-defaults.cmake
+++ b/cmake-helper/compiler-defaults.cmake
@@ -2,7 +2,6 @@ if(CMAKE_COMPILER_IS_GNUCXX)
   if(NOT WIN32 AND NOT APPLE)
     add_definitions(
       -Wall
-      -std=c++11
       -pedantic
       -Wmissing-field-initializers
       -Wuninitialized

