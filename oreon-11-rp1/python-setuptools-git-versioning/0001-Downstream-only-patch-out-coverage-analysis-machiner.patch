+                return re.sub(r"[^\d.]+", "", tag)
+
+            setuptools.setup(
+                name="mypkg",
+                setuptools_git_versioning={
+                    "tag_formatter": tag_formatter
+                },
+                setup_requires=[
+                    "setuptools>=41",
+                    "wheel",
+                    "setuptools-git-versioning",
+                ]
+            )
         """
         ),
     )
