diff --git a/tests/test_integration/test_tag_formatter.py b/tests/test_integration/test_tag_formatter.py
index f01938d..8ba978d 100644
--- a/tests/test_integration/test_tag_formatter.py
+++ b/tests/test_integration/test_tag_formatter.py
