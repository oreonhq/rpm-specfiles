--- disktype-9-orig/dos.c	2006-06-04 13:05:06.000000000 -0700
+++ disktype-9-20140129/dos.c	2014-01-15 16:11:57.000000000 -0800
@@ -606,4 +606,59 @@
     print_line(level, "Windows / MS-DOS boot loader");
 }
 
+/*
+ * exfat file system
+ */
+
+void detect_exfat(SECTION *section, int level)
+{
+  u4 sectsize, clustersize, allocatedpercent, versionminor, versionmajor;
+  u8 sectcount;
+  unsigned char *buf;
+  char s[256];
+
+  // retrieve the header of 1024 bytes
+  if (get_buffer(section, 0, 1024, (void **)&buf) < 1024)
+    return;
+
+  // see if the EXFAT string exists at position 3, if it doesn't then return
+  get_string(buf + 3, 7, s);
+  if (!s[0])
+    return;
+  if (memcmp(s, "EXFAT  ", 7) != 0)
+    return;
+
+  print_line(level, "exFAT file system");
+
+  /* sector size: must be a power of two */
+  sectsize = 1 << buf[0x6c];
+
+  //  printf("%u", sectsize);
+  if (sectsize < 512 || (sectsize & (sectsize - 1)))
+    return;
+  /* sectors per cluster: must be a power of two */
+  clustersize = (1 << buf[0x6d]) * sectsize;
+  if (clustersize == 0 || (clustersize & (clustersize - 1)))
+    return;
+
+  /* get size in sectors */
+  sectcount = get_le_quad(buf + 0x48);
+
+  /* get FS version minor and major */
+  versionminor = buf[0x68];
+  versionmajor = buf[0x69];
+  print_line(level +1, "Version %u.%u", versionmajor, versionminor);
+
+  ///* get allocation percentage */
+  //allocatedpercent = buf[0x70];
+  //print_line(level + 1, "Allocation Percentage: %s", allocatedpercent);
+
+  /* print volume size info */
+  format_blocky_size(s, sectcount, 512, "sectors", NULL);
+  print_line(level + 1, "Volume size %s", s);
+
+  return;
+}
+
+
 /* EOF */
diff -ruN disktype-9-orig/ewf.c disktype-9-20140129/ewf.c
--- disktype-9-orig/ewf.c	1969-12-31 16:00:00.000000000 -0800
+++ disktype-9-20140129/ewf.c	2014-01-31 04:30:50.191172685 -0800
@@ -0,0 +1,141 @@
+/*
+ * ewf.c
+ * Layered data source for EWF images via libewf.
+ * For use with disktype, Copyright (c) 2003 Christoph Pfisterer
