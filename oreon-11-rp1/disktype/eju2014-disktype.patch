diff -ruN disktype-9-orig/linux.c disktype-9-20140129/linux.c
--- disktype-9-orig/linux.c	2006-06-04 13:05:06.000000000 -0700
+++ disktype-9-20140129/linux.c	2014-01-15 15:57:25.000000000 -0800
@@ -28,10 +28,111 @@
 #include "global.h"
 
 /*
- * ext2/ext3 file system
+ * luks encryption detection
  */
 
-void detect_ext23(SECTION *section, int level)
+void detect_luks(SECTION *section, int level)
+{
+  unsigned char *buf;
+  char s[256];
+
+  if (get_buffer(section, 0x0, 1024, (void **)&buf) < 1024)
+    return ;
+
+  if (memcmp(buf, "LUKS\xBA\xBE", 6) == 0) {
+    print_line(level, "LUKS Encryption Detected");
+
+    get_string(buf + 0xa8, 36, s);
+    print_line(level + 1, "luksUUID: %s", s);
+
+    get_string(buf + 0x28, 24, s);
+    print_line(level + 1, "type: %s", s);
+  }
+
+}
+
+/*
+ * f2fs file system
+ */
+
+void detect_f2fs(SECTION *section, int level)
+{
+  unsigned char *buf;
+  char s[256];
+  u4 log_sectorsize, log_sectors_per_block, log_blocksize, log_blocks_per_seg, segs_per_sec, secs_per_zone, checksum_offset;;
+  u8 block_count;
+  u4 sector_size;
+
+// retrieve the header of 65536 bytes
+  if (get_buffer(section, 0x1000, 1024, (void **)&buf) < 1024)
+    return;
+
+  /* signature */
+  if (get_le_long(buf) != 0xF2F52010)
+    return;
+
+  print_line(level, "f2fs file system");
+
+  // label information
+  format_utf16_le(buf + 0x8c, 512, s);
+  if (s[0])
+    print_line(level + 1, "Volume name \"%s\"", s);
+}
+
+/*
+ * btrfs file system
+ */
+
+void detect_btrfs(SECTION *section, int level)
+{
+  unsigned char *buf;
+  char s[256];
+  u4 sectorsize, nodesize, leafsize, stripesize;
+  u8 blockcount, totalbytes, bytesused;
+
+  // retrieve the header of 65536 bytes
+  if (get_buffer(section, 64 * 1024, 1024, (void **)&buf) < 1024)
+    return;
+
+  // get the 8 character string that is 64 bytes into the header
+  get_string(buf + 64, 8, s);
+  if (!s[0])
+    return;
+  if (memcmp(s, "_BHRfS_M", 8) != 0)
+    return;
+
+  print_line(level, "Btrfs file system");
+
+  // label information
+  get_string(buf + 299, 256, s);
+  if (s[0])
+    print_line(level + 1, "Volume name \"%s\"", s);
+
+  // guid information
+  format_guid(buf + 32, s);
+  print_line(level + 1, "fsid %s", s);
+
+  /* collect size information */
+  totalbytes = get_le_quad(buf + 0x70);
+  bytesused = get_le_quad(buf + 0x78);
+  sectorsize = get_le_long(buf + 0x90);
+  nodesize = get_le_long(buf + 0x94);
+  leafsize = get_le_long(buf + 0x98);
+  stripesize = get_le_long(buf + 0x9c);
+
+  /* print the size information */
+  print_line(level +1, "Bytes in use: %u; node size: %u; leaf size: %u; stripe size: %u", bytesused, nodesize, leafsize, stripesize);
+
+  format_blocky_size(s, totalbytes/sectorsize, sectorsize, "blocks", NULL);
+  print_line(level + 1, "Volume size: %s", s);
+}
+
+/*
+ * ext2/ext3/ext4 file system
+ */
+
+
+void detect_ext234(SECTION *section, int level)
 {
   unsigned char *buf;
   char s[256];
@@ -44,7 +145,9 @@
