+++ b/idris.cabal
@@ -339,7 +339,7 @@ Library
                 , haskeline >= 0.8 && < 0.9
                 , ieee754 >= 0.7 && < 0.9
                 , megaparsec >= 7.0.4 && < 10
-                , mtl >= 2.1 && < 2.3
