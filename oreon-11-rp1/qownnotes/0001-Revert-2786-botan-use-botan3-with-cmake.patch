 #define BOTAN_INSTALL_PREFIX R"(/usr/local)"
-#define BOTAN_INSTALL_HEADER_DIR "include/botan-3"
+#define BOTAN_INSTALL_HEADER_DIR "include/botan-2"
 #define BOTAN_INSTALL_LIB_DIR "/usr/local/lib"
