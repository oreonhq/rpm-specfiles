+*  sdl/input.c input routines using SDL                    *
+***********************************************************/
+
+#include <interface.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <stdbool.h>
+
+#include <SDL.h>
+
+int             pressed[SDLK_LAST];
+int             n_pressed = 0;
+int             last_pressed;
+
+void
+UpdateInput (void)
+{
+  SDL_Event       event;
+  int             val = -1;
+
+  if (!SDL_PollEvent (&event))
+    return;
+
+  switch (event.type)
+    {
+    case SDL_KEYDOWN:
+      val = 1;
+      last_pressed = event.key.keysym.sym;
+      break;
+    case SDL_KEYUP:
+      val = 0;
+      last_pressed = 0;
+      break;
+    case SDL_MOUSEBUTTONDOWN:
+      n_pressed++;
+      break;
+    case SDL_MOUSEBUTTONUP:
+      n_pressed--;
+      break;
+    default:
+      return;
+    }
+
+  if (val >= 0)
+    {
+      n_pressed += val ? 1 : -1;
+      pressed[event.key.keysym.sym] = val;
+    }
+}
+
+int
+GetKey (void)
+{
+  int             key = last_pressed;
+
+  last_pressed = 0;
+  return key;
+}
+
+bool
+Pressed (void)
+{
+  return n_pressed != 0;
+}
+
+bool
+IsPressed (int key)
+{
+  return pressed[key] > 0;
+}
+
+int
+IsPressedUp (void)
+{
+  return pressed[SDLK_UP];
+}
+
+int
+IsPressedDown (void)
+{
+  return pressed[SDLK_DOWN];
+}
+
+int
+IsPressedLeft (void)
+{
+  return pressed[SDLK_LEFT];
+}
+
+int
+IsPressedRight (void)
+{
+  return pressed[SDLK_RIGHT];
+}
+
+int
+IsPressedEnter (void)
+{
+  return pressed[SDLK_RETURN] || pressed[SDLK_KP_ENTER];
+}
+
+int
+IsPressedEsc (void)
+{
+  return pressed[SDLK_ESCAPE];
+}
+
+int
+IsPressedH (void)
+{
+  return pressed[SDLK_h];
+}
+
+int
+IsPressedP (void)
+{
+  return pressed[SDLK_p];
+}
+
+#ifdef MOUSE
+int
+MouseX (void)
+{
+  int             x;
+  SDL_GetMouseState (&x, NULL);
+  return x;
+}
+
+int
+MouseY (void)
+{
+  int             y;
+  SDL_GetMouseState (NULL, &y);
+  return y;
+}
+
+int
+MouseButtons (void)
+{
+  return SDL_GetMouseState (NULL, NULL);
+}
+#endif
