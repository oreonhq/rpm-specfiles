 breakage due to new library path detection in ROOT 6.38

---
 python/src/rootIO/__init__.py | 7 -------
 1 file changed, 7 deletions(-)

diff --git a/python/src/rootIO/__init__.py b/python/src/rootIO/__init__.py
index b05805d7..709d8bd8 100644
--- a/python/src/rootIO/__init__.py
+++ b/python/src/rootIO/__init__.py
@@ -1,8 +1 @@
-try:
- import platform
- if platform.system() != 'Darwin':
-   from ctypes import cdll
-   libCore = cdll.LoadLibrary("libCore.so")
-except:
-  print("An exception occurred while loading libCore.so with ctypes")
 from .pyHepMC3rootIO import *
