Subject: [PATCH 4/5] Revert to sqlglot 5.1.3

---
 mycli/packages/hybrid_redirection.py | 3 ++-
 pyproject.toml                       | 2 +-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/mycli/packages/hybrid_redirection.py b/mycli/packages/hybrid_redirection.py
index 1937daf..4cc29e5 100644
--- a/mycli/packages/hybrid_redirection.py
+++ b/mycli/packages/hybrid_redirection.py
@@ -2,6 +2,7 @@ import functools
 import logging
 
 import sqlglot
+import sqlglot.tokens
 
 from mycli.compat import WIN
 from mycli.packages.special.delimitercommand import DelimiterCommand
@@ -130,7 +131,7 @@ def get_redirect_components(command: str) -> tuple[str | None, str | None, str |
     """Get the parts of a hybrid shell-style redirect command."""
 
     try:
-        tokens = sqlglot.tokenize(command)
+        tokens = sqlglot.tokens.Tokenizer().tokenize(command)
     except sqlglot.errors.TokenError:
         return None, None, None, None
 
diff --git a/pyproject.toml b/pyproject.toml
index 3ac5740..fe12944 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -15,7 +15,7 @@ dependencies = [
     "prompt_toolkit>=3.0.6,<4.0.0",
     "PyMySQL >= 0.9.2",
     "sqlparse>=0.3.0,<0.6.0",
-    "sqlglot[rs] == 27.*",
+    "sqlglot[rs] >= 5.1.3",
     "configobj >= 5.0.5",
     "cli_helpers[styles] >= 2.9.0",
     "pyperclip >= 1.8.1",
