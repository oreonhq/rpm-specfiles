From 2bcbeef391a637dc5dac607fc5555b65a659fb76 Mon Sep 17 00:00:00 2001
From: Cristian Le <git@lecris.dev>
Date: Mon, 9 Mar 2026 17:37:45 +0100
Subject: [PATCH 1/2] Build internal libraries as STATIC

---
 KCW/PP/CMakeLists.txt | 2 +-
 QEHeat/CMakeLists.txt | 2 +-
 cmake/qeHelpers.cmake | 1 +
 3 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/KCW/PP/CMakeLists.txt b/KCW/PP/CMakeLists.txt
index bb92ae7f3..38cc07e31 100644
--- a/KCW/PP/CMakeLists.txt
+++ b/KCW/PP/CMakeLists.txt
@@ -1,6 +1,6 @@
 set(src_kcwpp bcast_kcw_pp_input.f90 input_pp_summary.f90 kcw_pp_readin.f90 read_hr.f90 kcw_bands.f90 sh_setup.f90)
 
-qe_add_library(qe_kcwpp ${src_kcwpp})
+qe_add_library(qe_kcwpp STATIC ${src_kcwpp})
 target_link_libraries(
     qe_kcwpp
     PRIVATE qe_pw
diff --git a/QEHeat/CMakeLists.txt b/QEHeat/CMakeLists.txt
index d64d1315c..a1f26ea56 100644
--- a/QEHeat/CMakeLists.txt
+++ b/QEHeat/CMakeLists.txt
@@ -14,7 +14,7 @@ set(src_qeheat
     src/scf_result.f90
 )
 
-qe_add_library(qe_qeheat ${src_qeheat})
+qe_add_library(qe_qeheat STATIC ${src_qeheat})
 target_link_libraries(qe_qeheat
     PRIVATE
     qe_phonon_ph
diff --git a/cmake/qeHelpers.cmake b/cmake/qeHelpers.cmake
index 4bc11ffc2..519f0556d 100644
--- a/cmake/qeHelpers.cmake
+++ b/cmake/qeHelpers.cmake
@@ -186,6 +186,7 @@ function(qe_add_library LIB)
     set_target_properties(${LIB} PROPERTIES
         SOVERSION ${PROJECT_VERSION_MAJOR}
         VERSION ${PROJECT_VERSION}
+        POSITION_INDEPENDENT_CODE True
     )
     _qe_add_target(${LIB} ${ARGN})
 endfunction(qe_add_library)
-- 
