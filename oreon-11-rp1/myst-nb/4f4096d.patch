diff --git a/myst_nb/_compat.py b/myst_nb/_compat.py
index 2ff16ebc..6fded98b 100644
--- a/myst_nb/_compat.py
+++ b/myst_nb/_compat.py
@@ -1,3 +1,5 @@
+from typing import Any
+
 from docutils.nodes import Element
 
 
@@ -5,3 +7,13 @@ def findall(node: Element):
     # findall replaces traverse in docutils v0.18
     # note a difference is that findall is an iterator
     return getattr(node, "findall", node.traverse)
+
+
+def get_env_app(env: Any):
+    """Return the Sphinx app without triggering deprecated accessors."""
+    # This is the new Sphinx app behavior
+    app = getattr(env, "_app", None)
+    if app is None:
+        # This was removed in Sphinx 9
+        app = env.app
+    return app
