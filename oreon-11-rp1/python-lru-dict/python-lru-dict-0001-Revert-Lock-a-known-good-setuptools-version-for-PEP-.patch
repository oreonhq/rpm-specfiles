From: Peter Lemenkov <lemenkov@gmail.com>
Date: Thu, 31 Jul 2025 19:25:39 +0200
Subject: [PATCH] Revert "Lock a known-good setuptools version for PEP 517
 builds."

This reverts commit 7da9fa3a74bddcfb1420bbe15e2c00c2c9ea8533.

diff --git a/pyproject.toml b/pyproject.toml
index 2290e19..6ed5a94 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,7 +1,3 @@
-[build-system]
-requires = ["setuptools==80.9.0"]
-build-backend = "setuptools.build_meta"
-
 [project]
 name = "lru-dict"
 version = "1.4.1"
@@ -38,6 +34,10 @@ test = [
     "pytest",
 ]
 
+[build-system]
+requires = ["setuptools>=61", "wheel"]
+build-backend = "setuptools.build_meta"
+
 [tool.cibuildwheel]
 test-extras = ["test"]
 test-sources = ["test"]
