From 9b646045ca2f8e5768e06a89745aad0af25bf8cc Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Miro=20Hron=C4=8Dok?= <miro@hroncok.cz>
Date: Mon, 24 Aug 2026 18:08:11 +0200
Subject: [PATCH] Allow building this package with flit-core 4

The package already uses a [project] table in pyproject.toml,
and it is compatible with the latest flit-core release.
---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index db49010..72e0641 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,5 +1,5 @@
 [build-system]
-requires = ["flit_core >=3.2.0,<4"]
+requires = ["flit_core >=3.2.0,<5"]
 build-backend = "flit_core.buildapi"
 
 [project]
