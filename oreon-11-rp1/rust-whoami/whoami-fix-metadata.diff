 [lib]
 name = "whoami"
@@ -75,37 +66,9 @@
 optional = true
 default-features = false
 
-[target.'cfg(all(target_arch = "wasm32", not(target_os = "wasi"), not(daku)))'.dependencies.web-sys]
-version = "0.3.85"
-features = [
-    "Navigator",
-    "Document",
-    "Window",
-    "Location",
-]
-optional = true
-default-features = false
 
-[target.'cfg(all(target_arch = "wasm32", target_os = "wasi"))'.dependencies.wasite]
-version = "1.0.2"
-features = []
