--- whoami-2.1.2/Cargo.toml
+++ whoami-2.1.2/Cargo.toml
@@ -49,21 +49,12 @@
 repository = "https://github.com/ardaku/whoami"
 
 [features]
-default = [
-    "std",
-    "wasi-wasite",
-    "wasm-web",
-]
+default = ["std"]
 force-stub = []
 std = [
     "dep:libc",
-    "dep:libredox",
