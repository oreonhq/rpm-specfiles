From eabac98229dbea55b0cd781c7a401544b0089af6 Mon Sep 17 00:00:00 2001
From: Kan-Ru Chen <kanru@kanru.info>
Date: Sun, 11 Jan 2026 11:58:14 +0900
Subject: [PATCH] delete sqlite-bundled feature

---
 Cargo.toml       | 1 -
 capi/Cargo.toml  | 1 -
 tools/Cargo.toml | 1 -
 3 files changed, 3 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index d546d77..455d232 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -28,7 +28,6 @@ tempfile = { workspace = true }
 [features]
 default = []
 sqlite = ["dep:rusqlite"]
-sqlite-bundled = ["sqlite", "rusqlite/bundled"]
 
 [workspace]
 members = ["capi", "fuzzer", "tests/testhelper", "tools"]
diff --git a/capi/Cargo.toml b/capi/Cargo.toml
index 517dd9e..149550f 100644
--- a/capi/Cargo.toml
+++ b/capi/Cargo.toml
@@ -19,4 +19,3 @@ tempfile = { workspace = true }
 
 [features]
 sqlite = ["chewing/sqlite"]
-sqlite-bundled = ["sqlite", "chewing/sqlite-bundled"]
diff --git a/tools/Cargo.toml b/tools/Cargo.toml
index 893b7e3..f5753d7 100644
--- a/tools/Cargo.toml
+++ b/tools/Cargo.toml
@@ -17,4 +17,3 @@ optional = true
 [features]
 mangen = ["dep:clap_mangen"]
 sqlite = ["chewing/sqlite"]
-sqlite-bundled = ["sqlite", "chewing/sqlite-bundled"]
-- 
2.52.0

