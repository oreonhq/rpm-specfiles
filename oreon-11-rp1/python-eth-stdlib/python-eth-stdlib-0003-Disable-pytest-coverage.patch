From: Peter Lemenkov <lemenkov@gmail.com>
Date: Sun, 12 Jan 2025 21:01:08 +0100
Subject: [PATCH] Disable pytest coverage

* https://docs.fedoraproject.org/en-US/packaging-guidelines/Python/#_linters

Signed-off-by: Peter Lemenkov <lemenkov@gmail.com>

diff --git a/.coveragerc b/.coveragerc
deleted file mode 100644
index 8f2b5f9..0000000
--- a/.coveragerc
+++ /dev/null
@@ -1,10 +0,0 @@
-# coverage.py configuration
-# https://coverage.readthedocs.io/en/latest/config.html
-[run]
-branch = True
-
-[report]
-ignore_errors = True
-show_missing = True
-skip_empty = True
-sort = cover
diff --git a/pyproject.toml b/pyproject.toml
index 1742e32..e92d4b9 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,9 +1,12 @@
+[project]
+license = "LGPL-3.0-or-later"
+license-files = [ "COPYING.LESSER", ]
+
 [tool.poetry]
 name = "eth-stdlib"
 version = "0.2.7"
 description = "Ethereum Standard Library for Python"
 authors = ["Edward Amor <edward.amor3@gmail.com>"]
-license = "LGPL-3.0-or-later"
 readme = "README.md"
 repository = "https://github.com/skellet0r/eth-stdlib"
 documentation = "https://eth-stdlib.readthedocs.io/en/latest"
@@ -39,7 +42,6 @@ mypy = "^0.971"
 [tool.poetry.group.test.dependencies]
 pytest = "^7.1.3"
 hypothesis = "^6.54.5"
-pytest-cov = "^3.0.0"
 
 [tool.poetry.group.docs.dependencies]
 Sphinx = {version = "^5.2.2", allow-prereleases = true}
@@ -55,6 +57,3 @@ line-length = 100
 [tool.isort]
 profile = "black"
 line_length = 100
-
-[tool.pytest.ini_options]
-addopts = "--cov src/ --cov-report term --cov-report html --no-cov-on-fail"
