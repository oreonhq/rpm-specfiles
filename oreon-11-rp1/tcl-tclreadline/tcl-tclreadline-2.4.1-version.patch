From 0d793fc3ac647af977400b5673121bffcd57f6e3 Mon Sep 17 00:00:00 2001
From: Robert Scheck <robert@fedoraproject.org>
Date: Sat, 22 Feb 2025 15:18:13 +0100
Subject: [PATCH] Perform forgotten bump to 2.4.1

---
 configure    | 26 +++++++++++++-------------
 configure.ac |  2 +-
 2 files changed, 14 insertions(+), 14 deletions(-)

diff --git a/configure b/configure
index 55defad..fae8905 100755
--- a/configure
+++ b/configure
@@ -1,7 +1,7 @@
 #! /bin/sh
 # From configure.ac Revision.
 # Guess values for system-dependent variables and create Makefiles.
-# Generated by GNU Autoconf 2.71 for tclreadline 2.4.0.
+# Generated by GNU Autoconf 2.71 for tclreadline 2.4.1.
 #
 #
 # Copyright (C) 1992-1996, 1998-2017, 2020-2021 Free Software Foundation,
@@ -609,8 +609,8 @@ MAKEFLAGS=
 # Identity of this package.
 PACKAGE_NAME='tclreadline'
 PACKAGE_TARNAME='tclreadline'
-PACKAGE_VERSION='2.4.0'
-PACKAGE_STRING='tclreadline 2.4.0'
+PACKAGE_VERSION='2.4.1'
+PACKAGE_STRING='tclreadline 2.4.1'
 PACKAGE_BUGREPORT=''
 PACKAGE_URL=''
 
@@ -1337,7 +1337,7 @@ if test "$ac_init_help" = "long"; then
   # Omit some internal or obsolete options to make the list less imposing.
   # This message is too long to be a string in the A/UX 3.1 sh.
   cat <<_ACEOF
-\`configure' configures tclreadline 2.4.0 to adapt to many kinds of systems.
+\`configure' configures tclreadline 2.4.1 to adapt to many kinds of systems.
 
 Usage: $0 [OPTION]... [VAR=VALUE]...
 
@@ -1408,7 +1408,7 @@ fi
 
 if test -n "$ac_init_help"; then
   case $ac_init_help in
-     short | recursive ) echo "Configuration of tclreadline 2.4.0:";;
+     short | recursive ) echo "Configuration of tclreadline 2.4.1:";;
    esac
   cat <<\_ACEOF
 
@@ -1512,7 +1512,7 @@ fi
 test -n "$ac_init_help" && exit $ac_status
 if $ac_init_version; then
   cat <<\_ACEOF
-tclreadline configure 2.4.0
+tclreadline configure 2.4.1
 generated by GNU Autoconf 2.71
 
 Copyright (C) 2021 Free Software Foundation, Inc.
@@ -1716,7 +1716,7 @@ cat >config.log <<_ACEOF
 This file contains any messages produced by compilers while
 running configure, to aid debugging if configure makes a mistake.
 
-It was created by tclreadline $as_me 2.4.0, which was
+It was created by tclreadline $as_me 2.4.1, which was
 generated by GNU Autoconf 2.71.  Invocation command line was
 
   $ $0$ac_configure_args_raw
@@ -2478,9 +2478,9 @@ ac_config_headers="$ac_config_headers config.h"
 
 
 
-MAJOR="`echo '2.4.0' | cut -d. -f 1`"
-MINOR="`echo '2.4.0' | cut -d. -f 2`"
-PATCHLEVEL="`echo '2.4.0' | cut -d. -f 3`"
+MAJOR="`echo '2.4.1' | cut -d. -f 1`"
+MINOR="`echo '2.4.1' | cut -d. -f 2`"
+PATCHLEVEL="`echo '2.4.1' | cut -d. -f 3`"
 VERSION=$MAJOR.$MINOR
 PATCHLEVEL_STR=$VERSION.$PATCHLEVEL
 
@@ -3004,7 +3004,7 @@ fi
 
 # Define the identity of the package.
  PACKAGE='tclreadline'
- VERSION='2.4.0'
+ VERSION='2.4.1'
 
 
 printf "%s\n" "#define PACKAGE \"$PACKAGE\"" >>confdefs.h
@@ -6005,7 +6005,7 @@ cat >>$CONFIG_STATUS <<\_ACEOF || ac_write_fail=1
 # report actual input values of CONFIG_FILES etc. instead of their
 # values after options handling.
 ac_log="
-This file was extended by tclreadline $as_me 2.4.0, which was
+This file was extended by tclreadline $as_me 2.4.1, which was
 generated by GNU Autoconf 2.71.  Invocation command line was
 
   CONFIG_FILES    = $CONFIG_FILES
@@ -6073,7 +6073,7 @@ ac_cs_config_escaped=`printf "%s\n" "$ac_cs_config" | sed "s/^ //; s/'/'\\\\\\\\
 cat >>$CONFIG_STATUS <<_ACEOF || ac_write_fail=1
 ac_cs_config='$ac_cs_config_escaped'
 ac_cs_version="\\
-tclreadline config.status 2.4.0
+tclreadline config.status 2.4.1
 configured by $0, generated by GNU Autoconf 2.71,
   with options \\"\$ac_cs_config\\"
 
diff --git a/configure.ac b/configure.ac
index 529be7f..394f89c 100644
--- a/configure.ac
+++ b/configure.ac
@@ -8,7 +8,7 @@ dnl Copyright (c) 1998 - 2014, Johannes Zellner <johannes@zellner.org>
 dnl This software is copyright under the BSD license.
 dnl ---
 
-AC_INIT([tclreadline],[2.4.0])
+AC_INIT([tclreadline],[2.4.1])
 AC_CONFIG_SRCDIR([tclreadline.c])
 AC_CONFIG_HEADERS(config.h)
 AC_PREREQ([2.71])
