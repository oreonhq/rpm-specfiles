From: "Benjamin A. Beasley" <code@musicinmybrain.net>
Date: Sun, 10 Sep 2023 09:53:23 -0400
Subject: [PATCH] =?UTF-8?q?In=20tests,=20don=E2=80=99t=20assume=20Python?=
 =?UTF-8?q?=20is=20called=20python?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Use sys.executable instead.
---
 tests/test_cli.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/tests/test_cli.py b/tests/test_cli.py
index 6dca14c..ca2cdac 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -14,6 +14,7 @@
 from collections import namedtuple
 from os.path import basename, exists
 from subprocess import PIPE, Popen
+import sys
 import time
 
 # Local imports
@@ -38,7 +39,7 @@ def invoke(args):
         stderr=PIPE,
         cwd=PROJECT_DIR
     )
-    proc = Popen(['python', '-m', 'qtsass'] + args, **kwargs)
+    proc = Popen([sys.executable, '-m', 'qtsass'] + args, **kwargs)
     return proc
 
 
