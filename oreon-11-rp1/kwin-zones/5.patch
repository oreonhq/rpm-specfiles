From fedb4ae1fd883fd1441f67008bf93f6f4d22e650 Mon Sep 17 00:00:00 2001
From: Aleix Pol <aleixpol@kde.org>
Date: Mon, 1 Sep 2025 18:05:01 +0200
Subject: [PATCH 3/3] Include xdg-shell

For some reason we fail to build otherwise with a cryptic linker error:

/usr/bin/ld: /tmp/ccPUbdYy.ltrans0.ltrans.o:(.data.rel+0x18): undefined
reference to `xdg_toplevel_interface'
collect2: error: ld returned 1 exit status
---
 src/CMakeLists.txt | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index ca9baec..f4046f6 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -12,6 +12,10 @@ if (NOT ONLY_CLIENT_BUILD)
         PROTOCOL ext-zones-v1.xml
         BASENAME ext-zones-v1
     )
+    ecm_add_qtwayland_server_protocol(KWinZones
+        PROTOCOL ${WaylandProtocols_DATADIR}/stable/xdg-shell/xdg-shell.xml
+        BASENAME xdg-shell
+    )
     ecm_qt_declare_logging_category(KWinZones
         HEADER kwinzonescompositorlogging.h
         IDENTIFIER KWINZONES
