 spec/prawn/svg/css/stylesheets_spec.rb | 2 +-
 4 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/lib/prawn/svg/css/stylesheets.rb b/lib/prawn/svg/css/stylesheets.rb
index 519222b..75feb8d 100644
--- a/lib/prawn/svg/css/stylesheets.rb
+++ b/lib/prawn/svg/css/stylesheets.rb
@@ -119,7 +119,7 @@ def css_selector_to_xpath(selector)
           when '^='
             result << "[starts-with(@#{key}, #{xpath_quote value})]"
           when '$='
-            result << "[substring(@#{key}, string-length(@#{key}) - #{value.length - 1}) = #{xpath_quote value})]"
+            result << "[substring(@#{key}, string-length(@#{key}) - #{value.length - 1}) = #{xpath_quote value}]"
           when '*='
             result << "[contains(@#{key}, #{xpath_quote value})]"
           when '~='
