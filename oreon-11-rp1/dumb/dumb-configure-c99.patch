Fix generic C99 compatibility issues in autoconf-generated script
code.  These issues go away when re-running autoconf with any even
remotely-current version, so there is no need to upstream these
changes.

diff -ur dumb-0.9.3.orig/aclocal.m4 dumb-0.9.3/aclocal.m4
--- dumb-0.9.3.orig/aclocal.m4	2005-08-07 21:59:35.000000000 +0200
+++ dumb-0.9.3/aclocal.m4	2023-02-28 08:46:51.144766397 +0100
@@ -1785,10 +1785,6 @@
 #  endif
 #endif
 
-#ifdef __cplusplus
-extern "C" void exit (int);
-#endif
-
 void fnord() { int i=42;}
 int main ()
 {
@@ -1802,7 +1798,7 @@
       /* dlclose (self); */
     }
 
-    exit (status);
+    return status;
 }]
 EOF
   if AC_TRY_EVAL(ac_link) && test -s conftest${ac_exeext} 2>/dev/null; then
diff -ur dumb-0.9.3.orig/configure dumb-0.9.3/configure
--- dumb-0.9.3.orig/configure	2005-08-07 21:59:35.000000000 +0200
+++ dumb-0.9.3/configure	2023-02-28 08:46:51.120766650 +0100
@@ -2751,7 +2751,7 @@
   echo "$as_me:$LINENO: \$? = $ac_status" >&5
   (exit $ac_status); }; }; then
   for ac_declaration in \
-   '' \
+   '#include <stdlib.h>' \
    'extern "C" void std::exit (int) throw (); using std::exit;' \
    'extern "C" void std::exit (int); using std::exit;' \
    'extern "C" void exit (int) throw ();' \
@@ -4186,8 +4186,8 @@
   for (i = 0; i < 256; i++)
     if (XOR (islower (i), ISLOWER (i))
 	|| toupper (i) != TOUPPER (i))
-      exit(2);
-  exit (0);
+      return 2;
+  return 0;
 }
 _ACEOF
 rm -f conftest$ac_exeext
