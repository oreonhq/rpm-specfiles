discover:
    how: fmf
prepare:
  - name: install git-core
    how: install
    package: [git-core]
  - name: clone pyproject tests
    how: shell
    script: |
      git clone https://src.fedoraproject.org/rpms/pyproject-rpm-macros.git --depth=1 &&
      cd pyproject-rpm-macros && mv tests $TMT_PLAN_DATA
execute:
    how: tmt
