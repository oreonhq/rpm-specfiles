Do not call the undeclared exit function.  This avoids problems with
future compilers which do not support implicit function declarations.

Submitted upstream: <https://sourceforge.net/p/gqclient/bugs/155/>

diff --git a/acinclude.m4 b/acinclude.m4
index d050cc6afa46d072..50b6cea830b8ac75 100644
--- a/acinclude.m4
+++ b/acinclude.m4
@@ -53,7 +53,7 @@ AC_DEFUN([GC_TIMEZONE],
 				],
 			       [struct tm t;
 				t.tm_gmtoff = 0;
-				exit(0);
+				return 0;
 				],
 			       gq_cv_have_tm_gmtoff=yes
 			)
@@ -66,7 +66,7 @@ AC_DEFUN([GC_TIMEZONE],
 				],
 			       [struct tm t;
 				t.__tm_gmtoff = 0;
-				exit(0);
+				return 0;
 				],
 			       gq_cv_have___tm_gmtoff=yes
 			)
diff --git a/configure b/configure
index bfbd3b0d14e53b57..dca28a381ce7a305 100755
--- a/configure
+++ b/configure
@@ -6999,7 +6999,7 @@ main ()
 {
 struct tm t;
 				t.tm_gmtoff = 0;
-				exit(0);
+				return 0;
 
   ;
   return 0;
@@ -7057,7 +7057,7 @@ main ()
 {
 struct tm t;
 				t.__tm_gmtoff = 0;
-				exit(0);
+				return 0;
 
   ;
   return 0;
