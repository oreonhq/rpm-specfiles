diff -up Linux-Inotify2-2.3/t/01_inotify.t.orig Linux-Inotify2-2.3/t/01_inotify.t
--- Linux-Inotify2-2.3/t/01_inotify.t.orig	2021-08-02 14:31:07.426157370 +0200
+++ Linux-Inotify2-2.3/t/01_inotify.t	2021-08-02 14:31:59.138080965 +0200
@@ -5,10 +5,12 @@ my $in = Linux::Inotify2->new;
 ok ($in, "inotify handle created");
 
 # create directory for watch
-mkdir $$;
+use File::Temp qw/ tempdir /;
+my $dir = tempdir();
+mkdir $dir;
 
-my $watch = $in->watch ($$, IN_ALL_EVENTS);
