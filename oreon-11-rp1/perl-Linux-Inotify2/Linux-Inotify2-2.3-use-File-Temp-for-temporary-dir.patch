+ok ($watch, "watch created for directory $dir");
 
 $in->blocking (0);
 
@@ -17,7 +19,7 @@ $in->blocking (0);
   ok (@list==0, "non blocking: $!");
 }
 
-rmdir $$;
+rmdir $dir;
 
 {
   my @list = $in->poll;
@@ -27,6 +29,6 @@ rmdir $$;
