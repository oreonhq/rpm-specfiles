From: Fabio Valentini <decathorpe@gmail.com>
Date: Sat, 18 Jan 2025 17:14:11 +0100
Subject: [PATCH] skip doctests that pull in additional dependencies

---
 src/lib.rs | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/lib.rs b/src/lib.rs
index b0ab8f0..3dbf82c 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -31,7 +31,7 @@
 //!
 //! # StructOpt Example
 //!
-//! ```
+//! ```rust,ignore
 //! use log::*;
 //! use structopt::StructOpt;
 //!
@@ -70,7 +70,7 @@
 //!
 //! ## docopt Example
 //!
-//! ```rust
+//! ```rust,ignore
 //! use log::*;
 //! use docopt::Docopt;
 //! use serde::Deserialize;
@@ -109,7 +109,7 @@
 //!
 //! # clap Example
 //!
-//! ```
+//! ```rust,ignore
 //! use clap::{Arg, App, crate_version};
 //! use log::*;
 //! use std::str::FromStr;
