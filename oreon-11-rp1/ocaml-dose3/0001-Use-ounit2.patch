diff --git a/dose3.opam b/dose3.opam
index 061944b..33c4f8a 100644
--- a/dose3.opam
+++ b/dose3.opam
@@ -49,7 +49,7 @@ depends: [
   "ocamlgraph" {>= "2.0.0"}
   "re" {>= "1.2.2"}
   "stdlib-shims"
-  "ounit" {with-test}
+  "ounit2" {with-test}
   "conf-python-3" {with-test}
   "conf-python3-yaml" {with-test}
   "conf-dpkg" {with-test}
diff --git a/dune-project b/dune-project
index dd6558a..3c1c97a 100644
--- a/dune-project
+++ b/dune-project
@@ -41,7 +41,7 @@
