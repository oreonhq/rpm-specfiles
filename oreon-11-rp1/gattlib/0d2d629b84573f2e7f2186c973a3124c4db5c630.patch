From 0d2d629b84573f2e7f2186c973a3124c4db5c630 Mon Sep 17 00:00:00 2001
From: Olivier Martin <olivier@labapart.com>
Date: Thu, 9 May 2024 10:45:42 +0200
Subject: [PATCH] examples/nordic_uart: Port to new API

---
 CMakeLists.txt                     |   2 +-
 examples/nordic_uart/nordic_uart.c | 187 +++++++++++++++++++++--------
 2 files changed, 141 insertions(+), 48 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index f5d0991..c2032ca 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -120,7 +120,7 @@ if(GATTLIB_BUILD_EXAMPLES)
   add_subdirectory(examples/read_write)
   #add_subdirectory(examples/read_write_memory)
   add_subdirectory(examples/notification)
-  #add_subdirectory(examples/nordic_uart)
+  add_subdirectory(examples/nordic_uart)
   add_subdirectory(tests/test_continuous_connection)
 
   # Some examples require Bluez code and other DBus support
diff --git a/examples/nordic_uart/nordic_uart.c b/examples/nordic_uart/nordic_uart.c
index 88c8ef7..32526aa 100644
--- a/examples/nordic_uart/nordic_uart.c
+++ b/examples/nordic_uart/nordic_uart.c
@@ -2,7 +2,7 @@
  *
  *  GattLib - GATT Library
