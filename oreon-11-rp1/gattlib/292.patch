From 95ff48e7b22b8c17aa57c1b77d64a3de25119bc7 Mon Sep 17 00:00:00 2001
From: Benson Muite <bkmgit@users.noreply.github.com>
Date: Mon, 31 Mar 2025 11:06:22 +0300
Subject: [PATCH] Link to libpcre2-8 instead of libpcre

---
 CrossCompilation.cmake                          | 2 +-
 examples/ble_scan/CMakeLists.txt                | 4 ++--
 examples/discover/CMakeLists.txt                | 4 ++--
 examples/gatttool/CMakeLists.txt                | 4 ++--
 examples/nordic_uart/CMakeLists.txt             | 4 ++--
 examples/notification/CMakeLists.txt            | 4 ++--
 examples/read_write/CMakeLists.txt              | 4 ++--
 examples/read_write_memory/CMakeLists.txt       | 4 ++--
 tests/test_continuous_connection/CMakeLists.txt | 4 ++--
 9 files changed, 17 insertions(+), 17 deletions(-)

diff --git a/CrossCompilation.cmake b/CrossCompilation.cmake
index 5ce4ee8f..97303c6f 100644
--- a/CrossCompilation.cmake
+++ b/CrossCompilation.cmake
@@ -70,7 +70,7 @@ endif()
 include_directories($ENV{SYSROOT}/usr/include $ENV{SYSROOT}/usr/include/${TOOLCHAIN_MACHINE})
 
 # Workaround as some library are installed in $ENV{SYSROOT}/lib/${TOOLCHAIN_MACHINE}
-# such as libpcre.so (required by glib-2.0)
+# such as libpcre2-8.so (required by glib-2.0)
 link_directories($ENV{SYSROOT}/lib/${TOOLCHAIN_MACHINE})
 link_directories($ENV{SYSROOT}/usr/lib/${TOOLCHAIN_MACHINE})
 
diff --git a/examples/ble_scan/CMakeLists.txt b/examples/ble_scan/CMakeLists.txt
index 39c781b9..4c88847c 100644
--- a/examples/ble_scan/CMakeLists.txt
+++ b/examples/ble_scan/CMakeLists.txt
@@ -24,9 +24,9 @@ cmake_minimum_required(VERSION 3.22.0)
 find_package(PkgConfig REQUIRED)
 
 pkg_search_module(GATTLIB REQUIRED gattlib)
-pkg_search_module(PCRE REQUIRED libpcre)
+pkg_search_module(PCRE2-8 REQUIRED libpcre2-8)
 
 set(ble_scan_SRCS ble_scan.c)
 
 add_executable(ble_scan ${ble_scan_SRCS})
-target_link_libraries(ble_scan ${GATTLIB_LIBRARIES} ${GATTLIB_LDFLAGS} ${PCRE_LIBRARIES} pthread)
+target_link_libraries(ble_scan ${GATTLIB_LIBRARIES} ${GATTLIB_LDFLAGS} ${PCRE2-8_LIBRARIES} pthread)
