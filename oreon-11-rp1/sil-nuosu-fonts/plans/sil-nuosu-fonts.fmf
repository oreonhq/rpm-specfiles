summary: Fonts related tests
discover:
  how: fmf
  url: https://src.fedoraproject.org/tests/fonts
prepare:
  name: tmt
  how: install
  package: sil-nuosu-fonts
execute:
  how: tmt
environment:
  PACKAGE: sil-nuosu-fonts
  FONT_ALIAS: sans-serif
  FONT_FAMILY: Nuosu SIL
  FONT_LANG: ii
  DEFAULT_SANS: 1
  DEFAULT_SERIF: 1
  DEFAULT_MONO: 1
