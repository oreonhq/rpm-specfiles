diff -U4 -N -r anarch-f6a6a68a890716cd394c6fb2d00bd8123b51b18f--orig/get_savefile_path.c anarch-f6a6a68a890716cd394c6fb2d00bd8123b51b18f--patched/get_savefile_path.c
