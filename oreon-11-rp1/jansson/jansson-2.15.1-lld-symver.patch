From 1fac18f32cb51d1eadea71215a297b92febd97fd Mon Sep 17 00:00:00 2001
From: Oreon HQ <packaging@oreonhq.com>
Date: Mon, 23 Nov 2026 21:20:49 -0800
Subject: [PATCH] configure: version symbols with a version script when
 --default-symver is unavailable

---
 configure.ac    | 10 +++++++++-
 src/Makefile.am |  7 +++++--
 src/jansson.ver |  7 +++++++
 3 files changed, 21 insertions(+), 3 deletions(-)
 create mode 100644 src/jansson.ver

diff --git a/configure.ac b/configure.ac
index a982fe3..05adb89 100644
--- a/configure.ac
+++ b/configure.ac
@@ -142,10 +142,18 @@ AC_CHECK_DECL([__GLIBC__], [
     AC_LINK_IFELSE([AC_LANG_PROGRAM([[]], [[]])],
         [AC_MSG_RESULT([yes])
          JSON_SYMVER_LDFLAGS=-Wl,--default-symver],
-        [AC_MSG_RESULT([no])])
+        [AC_MSG_RESULT([no])
+         LDFLAGS="$saved_LDFLAGS -Wl,--version-script,$srcdir/src/jansson.ver"
+         AC_MSG_CHECKING([whether the linker accepts -Wl,--version-script])
+         AC_LINK_IFELSE([AC_LANG_PROGRAM([[]], [[]])],
+             [AC_MSG_RESULT([yes])
+              JSON_SYMVER_LDFLAGS='-Wl,--version-script,$(srcdir)/jansson.ver'
+              json_version_script=yes],
+             [AC_MSG_RESULT([no])])])
     LDFLAGS="$saved_LDFLAGS"
 ])
 AC_SUBST([JSON_SYMVER_LDFLAGS])
+AM_CONDITIONAL([JSON_VERSION_SCRIPT], [test "x$json_version_script" = "xyes"])
 
 AC_ARG_ENABLE([dtoa],
   [AS_HELP_STRING([--enable-dtoa], [Use dtoa for optimal floating point to string conversion])],
diff --git a/src/Makefile.am b/src/Makefile.am
index 32d40cf..3962cb0 100644
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -1,4 +1,4 @@
-EXTRA_DIST = jansson.def dtoa.c
+EXTRA_DIST = jansson.def jansson.ver dtoa.c
 
 include_HEADERS = jansson.h
 nodist_include_HEADERS = jansson_config.h
@@ -29,7 +29,10 @@ endif
 
 libjansson_la_LDFLAGS = \
 	-no-undefined \
-	-export-symbols-regex '^json_|^jansson_' \
 	-version-info 19:1:15 \
 	@JSON_SYMVER_LDFLAGS@ \
 	@JSON_BSYMBOLIC_LDFLAGS@
+
+if !JSON_VERSION_SCRIPT
+libjansson_la_LDFLAGS += -export-symbols-regex '^json_|^jansson_'
+endif
diff --git a/src/jansson.ver b/src/jansson.ver
new file mode 100644
index 0000000..b442117
--- /dev/null
+++ b/src/jansson.ver
@@ -0,0 +1,7 @@
+libjansson.so.4 {
+    global:
+        json_*;
+        jansson_*;
+    local:
+        *;
+};
-- 
2.47.3

