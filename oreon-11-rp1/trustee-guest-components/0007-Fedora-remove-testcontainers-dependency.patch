From b6a83275769dc174c721ec4ffb841ef666d89dfa Mon Sep 17 00:00:00 2001
From: Yan Fu <yafu@redhat.com>
Date: Wed, 22 Oct 2025 03:11:42 -0400
Subject: [PATCH 7/7] Fedora: remove testcontainers dependency
Content-type: text/plain

Not in Fedora, so skip tests that use it

Signed-off-by: Uri Lublin <uril@redhat.com>
Signed-off-by: Yan Fu <yafu@redhat.com>
---
 Cargo.toml                                               | 1 -
 attestation-agent/kbs_protocol/Cargo.toml                | 1 -
 attestation-agent/kbs_protocol/src/client/rcar_client.rs | 3 ++-
 3 files changed, 2 insertions(+), 3 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index a1d0ece..2d1cefe 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -40,7 +40,6 @@ serial_test = "3"
 sha2 = "0.10.9"
 strum = { version = "0.27", features = ["derive"] }
 tempfile = "3.24"
-testcontainers = "0.25"
 thiserror = "2.0"
 tokio = "1.47"
 toml = "0.9.10"
diff --git a/attestation-agent/kbs_protocol/Cargo.toml b/attestation-agent/kbs_protocol/Cargo.toml
index 281183a..3cd22aa 100644
--- a/attestation-agent/kbs_protocol/Cargo.toml
+++ b/attestation-agent/kbs_protocol/Cargo.toml
@@ -31,7 +31,6 @@ zeroize.workspace = true
 rstest.workspace = true
 serial_test.workspace = true
 tempfile.workspace = true
-testcontainers.workspace = true
 tokio = { workspace = true, features = ["rt", "macros", "fs", "process"] }
 
 [build-dependencies]
diff --git a/attestation-agent/kbs_protocol/src/client/rcar_client.rs b/attestation-agent/kbs_protocol/src/client/rcar_client.rs
index a8f9d57..28e2278 100644
--- a/attestation-agent/kbs_protocol/src/client/rcar_client.rs
+++ b/attestation-agent/kbs_protocol/src/client/rcar_client.rs
@@ -379,7 +379,8 @@ impl KbsClientCapabilities for KbsClient<Box<dyn EvidenceProvider>> {
     }
 }
 
-#[cfg(test)]
+// Fedora: no testcontainers so ignore the following test
+#[cfg(any())]
 mod test {
     use kbs_types::HashAlgorithm;
     use rstest::rstest;
-- 
2.53.0

