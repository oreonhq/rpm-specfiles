-#ifndef QT6CT_DATADIR
+#if !defined(QT6CT_IN_TREE) && !defined(QT6CT_DATADIR)
 #define QT6CT_DATADIR "/usr/share"
 #endif
 
@@ -104,7 +104,9 @@ QStringList Qt6CT::sharedStyleSheetPaths()
     {
         paths << (p + QStringLiteral("/qt6ct/qss"));
     }
+#ifndef QT6CT_IN_TREE
     paths << QStringLiteral(QT6CT_DATADIR"/qt6ct/qss");
+#endif
     paths.removeDuplicates();
     return paths;
