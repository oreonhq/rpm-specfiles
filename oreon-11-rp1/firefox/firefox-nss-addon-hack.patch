diff -up firefox-150.0.1/security/certverifier/NSSCertDBTrustDomain.cpp.nss-hack firefox-150.0.1/security/certverifier/NSSCertDBTrustDomain.cpp
--- firefox-150.0.1/security/certverifier/NSSCertDBTrustDomain.cpp.nss-hack
+++ firefox-150.0.1/security/certverifier/NSSCertDBTrustDomain.cpp
@@ -1582,6 +1582,15 @@ SECStatus InitializeNSS(const nsACString& dir, NSSDBConfig nssDbConfig,
   if (srv != SECSuccess) {
     return srv;
   }
+
+  /* Sets the NSS_USE_ALG_IN_ANY_SIGNATURE bit.
+   * does not change NSS_USE_ALG_IN_CERT_SIGNATURE,
+   * so policy will still disable use of sha1 in
+   * certificate related signature processing. */
+  srv = NSS_SetAlgorithmPolicy(SEC_OID_SHA1, NSS_USE_ALG_IN_ANY_SIGNATURE, 0);
+  if (srv != SECSuccess) {
+    NS_WARNING("Unable to use SHA1 for Add-ons, expect broken/disabled Add-ons. See https://bugzilla.redhat.com/show_bug.cgi?id=1908018 for details.");
+  }
 
