--- a/libstdc++-v3/acinclude.m4	2026-10-20 20:34:36.468218468 -0700
+++ b/libstdc++-v3/acinclude.m4	2026-10-20 20:34:36.492433877 -0700
@@ -5913,6 +5913,28 @@
   AC_LANG_RESTORE
 ])
 
+dnl
+dnl Check whether <setjmp.h> actually defines jmp_buf.
+dnl nvptx and gcn newlib declare setjmp without a jmp_buf type.
+dnl
+dnl Defines:
+dnl  HAVE_JMP_BUF
+dnl
+AC_DEFUN([GLIBCXX_CHECK_CSETJMP], [
+  AC_LANG_SAVE
+  AC_LANG_CPLUSPLUS
+  AC_MSG_CHECKING([for jmp_buf in <setjmp.h>])
+  AC_TRY_COMPILE([#include <setjmp.h>],
+    [jmp_buf env; return setjmp (env);],
+    [ac_jmp_buf=yes], [ac_jmp_buf=no])
+  AC_MSG_RESULT([$ac_jmp_buf])
+  if test "$ac_jmp_buf" = yes; then
+    AC_DEFINE([HAVE_JMP_BUF], [1],
+      [Define if jmp_buf is defined in <setjmp.h>.])
+  fi
+  AC_LANG_RESTORE
+])
+
 
