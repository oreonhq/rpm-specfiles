+
+struct R
+{
+  int a, b;
+  constexpr R () : a (0), b (1) { }
+  constexpr R (int x, int y) : a (x), b (y) {}
+};
+
+R *
+bar (int *p)
+{
+  return new R[64] { R (++*p, 43) };
