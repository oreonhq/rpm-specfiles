From: Oreon Packaging Team <packaging@oreonhq.com>
Subject: [OREON] configure: sanitize skipdirs/noconfigdirs before $notsupp

Strip tokens from skipdirs and noconfigdirs that are not real directory names:
compiler flags (-*), path fragments (*/*), assignments (*=*), and common
intermediate source/object suffixes. Complements PR bootstrap/124547
(gas_flag vs gas in gcc/configure) when a full compile command still leaks
into dir lists (bogus "*** not supported in subdirectories: -MMD -MP ...").

--- configure
+++ configure
@@ -10680,6 +10680,24 @@
    skipdirs="${skipdirs} ${target_configdirs}"
 fi
 
+# Oreon: sanitize skipdirs/noconfigdirs (compiler flags, paths, temp files; PR124547 class).
+__oreon_sd=""
+for __oreon_d in $skipdirs; do
+  case $__oreon_d in
+  ""|-*|*/*|*=*|*.o|*.lo|*.obj|*.c|*.cc|*.cpp|*.cxx|*.d|*.S|*.s|*.h|*.hh) ;;
+  *) __oreon_sd="$__oreon_sd $__oreon_d" ;;
+  esac
+done
+skipdirs=$__oreon_sd
+__oreon_sd=""
+for __oreon_d in $noconfigdirs; do
+  case $__oreon_d in
+  ""|-*|*/*|*=*|*.o|*.lo|*.obj|*.c|*.cc|*.cpp|*.cxx|*.d|*.S|*.s|*.h|*.hh) ;;
+  *) __oreon_sd="$__oreon_sd $__oreon_d" ;;
+  esac
+done
+noconfigdirs=$__oreon_sd
+
 # Remove the entries in $skipdirs and $noconfigdirs from $configdirs,
 # $build_configdirs and $target_configdirs.
 # If we have the source for $noconfigdirs entries, add them to $notsupp.
