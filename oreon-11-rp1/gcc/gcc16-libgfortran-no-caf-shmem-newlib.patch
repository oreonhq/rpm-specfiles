--- libgfortran/configure.ac
+++ libgfortran/configure.ac
@@ -351,6 +351,11 @@
   ], [
   enable_caf_shmem=false
   ])
+# Shared-memory coarrays need a full POSIX runtime.  Disable for newlib
+# accelerator libgfortran builds (nvptx, mips bare metal).
+if test "${hardwire_newlib:-0}" -eq 1; then
+  enable_caf_shmem=false
+fi
 AM_CONDITIONAL([ENABLE_CAF_SHMEM], [test x$enable_caf_shmem = xtrue])
 
