--- libgfortran/configure.ac
+++ libgfortran/configure.ac
@@ -351,6 +351,12 @@
   ], [
   enable_caf_shmem=false
   ])
+# NVPTX offload builds libgfortran without --with-newlib=yes, so hardwire_newlib
+# stays unset; caf_shmem still must be off (no process-shared pthread runtime).
+case "${host}" in
+  nvptx*)
+    enable_caf_shmem=false;;
+esac
 AM_CONDITIONAL([ENABLE_CAF_SHMEM], [test x$enable_caf_shmem = xtrue])
 
