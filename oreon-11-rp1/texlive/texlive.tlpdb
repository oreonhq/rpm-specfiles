name ptex
category Package
revision 38037
shortdesc A TeX system for publishing in Japanese
longdesc PTeX adds features related to vertical writing, and deals with
longdesc other problems in typesetting Japanese. A set of additions to a
longdesc TEXMF tree, for use with PTeX, may be found in package PTeX-
longdesc texmf. PTeX is distributed as WEB change files.
depend tex
depend latex
depend hyph-utf8
depend adobemapping
depend ipaex
depend japanese
depend japanese-otf
depend ptex.ARCH
execute AddFormat name=ptex   engine=ptex options="ptex.ini"
execute AddFormat name=eptex  engine=eptex options="*eptex.ini"                               patterns=language.def
execute AddFormat name=platex engine=eptex options="*platex.ini"                               patterns=language.dat
execute addKanjiMap ptex-@kanjiEmbed@@kanjiVariant@.map
execute addKanjiMap morisawa.map
