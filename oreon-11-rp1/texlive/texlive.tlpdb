depend hyph-utf8
depend ruhyphen
execute AddHyphen 	name=russian 	lefthyphenmin=2 	righthyphenmin=2 	file=loadhyph-ru.tex 	file_patterns=hyph-ru.pat.txt 	file_exceptions=hyph-ru.hyp.txt

