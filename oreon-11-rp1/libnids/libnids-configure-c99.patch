Avoid implicit declaration of exit, to improve compatibility with
future compilers which reject implicit function declarations by
default.  No need to upstream this because the issue goes away once
upstream re-generates the configure script with modern tooling.

diff --git a/configure b/configure
index 3417e7781874ee36..a4a0b9f0053b4a12 100755
--- a/configure
+++ b/configure
@@ -2258,7 +2258,7 @@ if { (eval echo "$as_me:$LINENO: \"$ac_compile\"") >&5
   echo "$as_me:$LINENO: \$? = $ac_status" >&5
   (exit $ac_status); }; }; then
   for ac_declaration in \
-   '' \
+   '#include <stdlib.h>' \
    'extern "C" void std::exit (int) throw (); using std::exit;' \
    'extern "C" void std::exit (int); using std::exit;' \
    'extern "C" void exit (int) throw ();' \
@@ -2911,8 +2911,8 @@ main ()
   for (i = 0; i < 256; i++)
     if (XOR (islower (i), ISLOWER (i))
 	|| toupper (i) != TOUPPER (i))
-      exit(2);
-  exit (0);
+      return 2;
+  return 0;
 }
 _ACEOF
 rm -f conftest$ac_exeext
