From b4551343f220023242b9384a221ef7f05a116257 Mon Sep 17 00:00:00 2001
From: "Benjamin A. Beasley" <code@musicinmybrain.net>
Date: Thu, 20 Feb 2025 10:39:52 -0500
Subject: [PATCH] Downstream-only: remove pytest-runner dependency

---
 setup.py | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/setup.py b/setup.py
index fd63283..2896df5 100644
--- a/setup.py
+++ b/setup.py
@@ -18,7 +18,7 @@ requirements = [
     'base58>=1.0.2,<3.0',
 ]
 
-setup_requirements = ['pytest-runner', ]
+setup_requirements = []
 
 test_requirements = [
     'pytest',
@@ -51,8 +51,6 @@ setup(
     keywords='multihash',
     packages=find_packages(include=['multihash']),
     setup_requires=setup_requirements,
-    test_suite='tests',
-    tests_require=test_requirements,
     url='https://github.com/multiformats/multihash',
     zip_safe=False,
 )
