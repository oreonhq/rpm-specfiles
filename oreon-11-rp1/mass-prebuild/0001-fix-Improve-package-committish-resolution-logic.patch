         if self.distgit in self.whatrequires.metalinks:
             meta = self.whatrequires.metalinks[self.distgit]
             if 'branch' in meta:
-                self.revdep_branch = meta['branch']
+                self.revdep_branch = meta['branch'].format(release=self.releasever)
 
         self._pkg_class = self._get_package_class()
         self._init_packages(config)
@@ -407,7 +407,7 @@ class MpbBackend:
     _chroot_strings = {
         'centos-stream': {'*': 'c{}s'},
         'fedora': {'rawhide': '{}', 'eln': 'rawhide', '*': 'f{}'},
-        'epel': {'*': 'el{}'},
+        'epel': {'*': 'epel{}'},
         'mageia': {'cauldron': '{}', '*': '{}'},  # To be checked
         'openmandriva': {'cooker': 'master', 'rolling': '{}'},  # To be checked
         'opensuse': {
@@ -436,6 +436,18 @@ class MpbBackend:
 
         return None, None, None
 
+    def get_distgit_branch(self, distgit):
+        """Return the default branch for a given distgit"""
+        if distgit not in self._chroot_strings:
+            return self.committish
+
+        branch_names = self._chroot_strings[distgit]
+        for bname, bformat in branch_names.items():
+            if bname in self.releasever or bname == '*':
+                return bformat.format(self.releasever)
+
+        return self.committish
+
     def _set_package_defaults(self, pkg, name, pkg_type):
         """Set package default values"""
         if 'build_order' in pkg and 'priority' in pkg:
