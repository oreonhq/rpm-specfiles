--- a/mass_prebuild/backend/package.py
+++ b/mass_prebuild/backend/package.py
@@ -255,25 +255,38 @@ class MpbPackage:
             (self.src_pkg_name,
              committish,
              self.nvr,
-             source) = self._owner.whatrequires.get_last_build(self.name, arch)
+             source) = self._owner.whatrequires.get_last_build(
+                 self.name,
+                 arch,
+                 is_revdep=bool(self.pkg_type & ALL_DEP_PKG)
+             )
 
             if committish:
                 break
 
         if self.committish == '@last_build':
-            self.committish = ''
-            if committish is not None:
+            if committish:
                 self.committish = committish
             else:
+                self.committish = ''
                 # Looks like there was an error while retrieving this package
                 # There is no existing valid build for any arch
                 self.pkg_type |= NO_BUILD
 
-        if not self.committish:
+        if not self.committish and not self.pkg_type & NO_BUILD:
             if self.pkg_type & ALL_DEP_PKG:
                 self.committish = self._owner.revdep_branch
             else:
-                self.committish = self._owner.committish
+                # Check if there is a 'main' override in the metalinks for the current distgit
+                distgit = self._owner.distgit
+                if distgit and distgit in self._owner.whatrequires.metalinks:
+                    meta = self._owner.whatrequires.metalinks[distgit]
+                    if 'main' in meta:
+                        distgit = meta['main']
+
+                self.committish = self._owner.get_distgit_branch(distgit)
+
+        self._logger.debug(f"Package {self.name}: committish set to '{self.committish}'")
 
         if self.src_type == 'distgit':
             self.src = source
