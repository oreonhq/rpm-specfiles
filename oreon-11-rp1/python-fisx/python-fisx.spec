%global source0_hash 8d3b6099136e27a34b859395903744d5097fb012e4593699a063eaa9dd057a31
Name:           python-fisx
Version:        1.3.2
Release:        1%{?dist}
Summary:        Calculate X-ray fluorescence intensities
License:        MIT
URL:            https://github.com/vasole/fisx
Source0:        https://github.com/vasole/fisx/archive/v%{version}/fisx-%{version}.tar.gz
# oreon:deps
BuildRequires:  pyproject-rpm-macros
BuildRequires:  python3-devel
BuildRequires:  python3dist(numpy) >= 2.0.0
Requires:       python3-fisx = %{version}-%{release}
# /oreon:deps
%description

%package     -n python3-fisx
Summary: %summary
%description -n python3-fisx

%prep

test "%{source0_hash}" = "none" || { f="%{SOURCE0}"; test -f "$f" || { echo "oreon: missing Source0 $f" >&2; exit 1; }; h=$(sha256sum "$f" | awk '{print $1}'); test "$h" = "%{source0_hash}" || { echo "oreon: Source0 hash mismatch" >&2; exit 1; }; }

%autosetup -n fisx-%{version}
# Remove Cythonized C++ sources:
# https://docs.fedoraproject.org/en-US/packaging-guidelines/Python/#_using_cython
grep -FrinIl 'Generated by Cython' python/ | xargs -r -t rm -v

%build

%pyproject_wheel
%install
%pyproject_install
%oreon_autofiles python3-fisx usr/lib/python3*/site-packages/fisx* usr/lib64/python3*/site-packages/fisx* usr/bin/*
%oreon_autofiles main usr/lib/python3*/site-packages/fisx* usr/lib64/python3*/site-packages/fisx* usr/bin/*

%check

%pyproject_check_import
%{py3_test_envvars} %{python3} -m fisx.tests.testAll
%files
%files -n python3-fisx -f %{oreon_filedir}/python3-fisx.list

%changelog

%autochangelog
