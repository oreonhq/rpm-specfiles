Fix historic autoconf C99 compatibility issues.

The issue goes away once upstream re-runs autoconf, until then
this patch will keep applying.  So there is no need to upstream it.

diff --git a/configure b/configure
index 8ad2fd8221349d29..a8a8bb1593be6f8c 100755
--- a/configure
+++ b/configure
@@ -2297,7 +2297,7 @@ if { (eval echo "$as_me:$LINENO: \"$ac_compile\"") >&5
   echo "$as_me:$LINENO: \$? = $ac_status" >&5
   (exit $ac_status); }; }; then
   for ac_declaration in \
-   '' \
+   '#include <stdlib.h>' \
    'extern "C" void std::exit (int) throw (); using std::exit;' \
    'extern "C" void std::exit (int); using std::exit;' \
    'extern "C" void exit (int) throw ();' \
@@ -4362,8 +4362,8 @@ main ()
   for (i = 0; i < 256; i++)
     if (XOR (islower (i), ISLOWER (i))
 	|| toupper (i) != TOUPPER (i))
-      exit(2);
-  exit (0);
+      return 2;
+  return 0;
 }
 _ACEOF
 rm -f conftest$ac_exeext
