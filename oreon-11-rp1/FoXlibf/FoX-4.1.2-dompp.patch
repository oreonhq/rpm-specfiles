@@ -5294,7 +5294,7 @@ if test x$wxml_yes$wcml_yes$wkml_yes$sax
     if test x$wcml_no = x; then wcml_yes=wcml_lib; fi
     if test x$wkml_no = x; then wkml_yes=wkml_lib; fi
     if test x$sax_no = x; then sax_yes=sax_lib; fi
