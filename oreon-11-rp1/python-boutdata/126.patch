From c71c25c29fda78efdf73e5970d0e3125af90f92a Mon Sep 17 00:00:00 2001
From: David Bold <dave@ipp.mpg.de>
Date: Wed, 18 Jun 2025 11:31:03 +0200
Subject: [PATCH 3/4] Allow pickling of BoutOutputs

This is needed so that multithreading works with python 3.14.
---
 src/boutdata/data.py | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/boutdata/data.py b/src/boutdata/data.py
index 247dc3d..7a8a2e1 100644
--- a/src/boutdata/data.py
+++ b/src/boutdata/data.py
@@ -1628,6 +1628,13 @@ def _collect_parallel(self, varname):
             self._shared_buffer[global_slices].copy(), attributes=var_attributes
         )
 
+    def __getstate__(self):
+        new = self.__dict__.copy()
+        new.pop('_file0')
+        new.pop('_root_file')
+        new.pop('_workers')
+        return new
+
     def _worker_function(self, connection, proc_list, shared_buffer_raw):
         data_files = [DataFile(self._file_list[i]) for i in proc_list]
         dim_sizes = tuple(self.grid_info["sizes"][d] for d in ("t", "x", "y", "z"))

