              break;
           default:
-             exit(1);
+             return 1;
        }
    }
    fprintf(rf, isGNU ? "yes" : "no");
-   exit(0);
+   return 0;
 }
 ]])],[
 ac_cv_sys_gnu_getopt="`cat conftestresult`"
