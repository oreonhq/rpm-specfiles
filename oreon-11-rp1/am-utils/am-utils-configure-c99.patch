--- a/m4/macros/check_fs_mntent.m4
+++ b/m4/macros/check_fs_mntent.m4
@@ -165,15 +165,15 @@ do
   [[
 #include <sys/param.h>
 #include <sys/mount.h>
-main()
+int main(void)
 {
   int i;
   struct vfsconf vf;
   i = getvfsbyname("$ac_fs_tmp", &vf);
   if (i < 0)
-    exit(1);
+    return 1;
   else
-    exit(0);
+    return 0;
 }
   ]])], [eval "ac_cv_fs_$ac_fs_name=yes"
       break
diff --git a/m4/macros/check_gnu_getopt.m4 b/m4/macros/check_gnu_getopt.m4
