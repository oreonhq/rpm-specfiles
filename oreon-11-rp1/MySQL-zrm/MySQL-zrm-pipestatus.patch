+# Runs command via system() and returns $PIPESTATUS
+sub systemPipe()
+{
+        my $pipestatus = tmpnam();
+	my $r = system($_[0].";echo \$PIPESTATUS > $pipestatus");
+        unless (open(PIPESTATUS, $pipestatus)) {
+                &printAndDie( "Could not read pipestatus file for pipe exitcode ".$pipestatus."\n" );
+        }
+        my $pipe_exit = <PIPESTATUS>;
+        chomp($pipe_exit);
+        close(PIPESTATUS);
+        unlink($pipestatus);
+        return($r or $pipe_exit);
+}
