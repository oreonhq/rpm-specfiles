+        except Exception:
+            print("warning!!! some locks leaves of dir %s" % self._wd)
+
+    def test_pull_deleted_file_of_removed_dir(self):
+        os.chdir(self._wd)
+        import_cmd = ['hgimportsvn', self.svn_url, self.test_hg]
