Date: Wed, 1 Feb 2023 10:15:09 +0100
Subject: [PATCH] Disable TestServer

---
 cmd/mockserver/server_test.go | 21 ---------------------
 1 file changed, 21 deletions(-)

diff --git a/cmd/mockserver/server_test.go b/cmd/mockserver/server_test.go
index d7480f4..8e7abe6 100644
--- a/cmd/mockserver/server_test.go
+++ b/cmd/mockserver/server_test.go
@@ -17,12 +17,10 @@ package main
 import (
 	"bufio"
 	"bytes"
-	"io/ioutil"
 	"log"
 	"net"
 	"sync"
 	"testing"
-	"time"
 
 	"github.com/google/go-dap"
 )
@@ -75,25 +73,6 @@ func expectMessage(t *testing.T, r *bufio.Reader, want []byte) {
 	}
 }
 
-func TestServer(t *testing.T) {
-	log.SetOutput(ioutil.Discard)
-	port := "54321"
-	go func() {
-		err := server(port)
-		if err != nil {
-			log.Fatal("Could not start server:", err)
-		}
-	}()
-	// Give server time to start listening before clients connect
-	time.Sleep(100 * time.Millisecond)
-
-	var wg sync.WaitGroup
-	wg.Add(2)
-	go client(t, port, &wg)
-	go client(t, port, &wg)
-	wg.Wait()
-}
-
 func client(t *testing.T, port string, wg *sync.WaitGroup) {
 	defer wg.Done()
 	conn, err := net.Dial("tcp", ":"+port)
-- 
