[Unit]
Description=smtprelay Go SMTP Relay
Documentation=https://github.com/decke/smtprelay/blob/master/smtprelay.ini
After=network.target

[Service]
Type=simple
User=smtprelay
Group=smtprelay
ExecStart=/usr/bin/smtprelay -config /etc/smtprelay/smtprelay.ini
TimeoutStopSec=5s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
