Subject: [PATCH] Adjust test_sign_bad_pkey to work with cryptography 45

Signed-off-by: Carl George <carlwgeorge@gmail.com>
---
 fasjson_client/tests/unit/test_cli_get_cert.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/fasjson_client/tests/unit/test_cli_get_cert.py b/fasjson_client/tests/unit/test_cli_get_cert.py
index 3543e19..785dab5 100644
--- a/fasjson_client/tests/unit/test_cli_get_cert.py
+++ b/fasjson_client/tests/unit/test_cli_get_cert.py
@@ -272,6 +272,8 @@ def test_sign_bad_pkey(invoker, tmp_path, mocker, fixture_dir):
         " incorrect, it may be encrypted with an unsupported algorithm, or it"
         " may be an unsupported key type (e.g. EC curves with explicit"
         " parameters).\n",
+        # cryptography >= 45
+        "Error: can't load the private key: Unable to load PEM file.",
     )
     print(result.output)
     assert any(result.output.startswith(msg) for msg in expected_msgs)
