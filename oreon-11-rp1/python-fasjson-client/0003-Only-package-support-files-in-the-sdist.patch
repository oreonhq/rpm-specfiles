From: =?UTF-8?q?Aur=C3=A9lien=20Bompard?= <aurelien@bompard.org>
Date: Fri, 11 Apr 2025 10:20:08 +0200
Subject: [PATCH] Only package support files in the sdist
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Aurélien Bompard <aurelien@bompard.org>
(cherry picked from commit 0cd6106581d9cf85e790b3c9fa2842070c46113b)
---
 pyproject.toml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 65e58cb..a672e44 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -15,8 +15,8 @@ repository = "https://github.com/fedora-infra/fasjson-client"
 homepage = "https://github.com/fedora-infra/fasjson-client"
 
 include = [
-  "tox.ini",
-  "config.toml.example",
+  { path = "tox.ini", format = "sdist" },
+  { path = "config.toml.example", format = "sdist" },
 ]
 
 keywords = ['security']
-- 
