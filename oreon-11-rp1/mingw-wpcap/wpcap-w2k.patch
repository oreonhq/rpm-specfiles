+#include <winsock2.h>
+#include <wspiapi.h>
+
+char * WINAPI
+WspiapiStrdup (const char *pszString)
+{
+  char *rstr;
+  size_t szlen;
+
+  if(!pszString)
+    return NULL;
+  szlen = strlen(pszString) + 1;
+  rstr = (char *) WspiapiMalloc (szlen);
+  if (!rstr)
+    return NULL;
+  strcpy (rstr, pszString);
+  return rstr;
+}
