+            datetime(2024, 4, 28, 12, 0, tzinfo=timezone.utc),
+            datetime(2024, 4, 28, 12, 0),
+            None,
+        ),
+        (
+            "April 28, 2024 12:00 PM UTC",
+            datetime(2024, 4, 28, 12, 0),
