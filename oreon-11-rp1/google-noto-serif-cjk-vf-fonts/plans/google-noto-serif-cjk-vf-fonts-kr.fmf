summary: Fonts related tests
discover:
  how: fmf
  url: https://src.fedoraproject.org/tests/fonts
prepare:
  name: tmt
  how: install
  package: google-noto-serif-cjk-vf-fonts
execute:
  how: tmt
environment:
  PACKAGE: google-noto-serif-cjk-vf-fonts
  FONT_ALIAS: serif
  FONT_FAMILY: Noto Serif CJK KR
  FONT_LANG: ko
  DEFAULT_SERIF: 1
  FONT_VALIDATE_INDEXES: 1,131073,196609,262145,327681,393217,458753
