summary: Fonts related tests
discover:
  how: fmf
  url: https://src.fedoraproject.org/tests/fonts
prepare:
  name: tmt
  how: install
  package: google-noto-serif-cjk-vf-fonts
execute:
  how: tmt
environment:
  PACKAGE: google-noto-serif-cjk-vf-fonts
  FONT_ALIAS: serif
  FONT_FAMILY: Noto Serif CJK JP
  FONT_LANG: ja
  DEFAULT_SERIF: 1
  FONT_VALIDATE_INDEXES: 0,131072,196608,262144,327680,393216,458752
