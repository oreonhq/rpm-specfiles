From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Peter Jones <pjones@redhat.com>
Date: Thu, 4 Sep 2014 15:52:08 -0400
Subject: [PATCH 201/356] Minimize the sort ordering for .debug and -rescue-
 kernels.

Resolves: rhbz#1065360
Signed-off-by: Peter Jones <pjones@redhat.com>
---
 util/grub-mkconfig_lib.in | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/util/grub-mkconfig_lib.in b/util/grub-mkconfig_lib.in
index 114ad2d..1066f0c 100644
--- a/util/grub-mkconfig_lib.in
+++ b/util/grub-mkconfig_lib.in
@@ -299,6 +299,14 @@ uses_abstraction () {
 }
 
 print_option_help () {
+    *-rescue*:*-rescue*) ;;
+    *?debug:*?debug) ;;
+    *-rescue*:*?debug) return 1 ;;
+    *?debug:*-rescue*) return 0 ;;
+    *-rescue*:*) return 1 ;;
+    *:*-rescue*) return 0 ;;
+    *?debug:*) return 1 ;;
+    *:*?debug) return 0 ;;
   if test x$print_option_help_wc = x; then
       if wc -L  </dev/null > /dev/null 2>&1; then
 	  print_option_help_wc=-L
