From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: x <x>
Date: Mon, 23 Nov 2026 22:31:55 -0800
Subject: [PATCH 356/356] restore mkconfig BLS/DTB/btrfs exports and minicmd
 exit status

---
 grub-core/commands/minicmd.c | 21 +++++++++++++++++----
 util/grub-mkconfig.in        |  5 ++++-
 2 files changed, 21 insertions(+), 5 deletions(-)

diff --git a/grub-core/commands/minicmd.c b/grub-core/commands/minicmd.c
index ff4ff02..d6f434d 100644
--- a/grub-core/commands/minicmd.c
+++ b/grub-core/commands/minicmd.c
@@ -186,11 +186,13 @@ grub_mini_cmd_lsmod (struct grub_command *cmd __attribute__ ((unused)),
 }
 
 /* exit */
-static grub_err_t __attribute__ ((noreturn))
+static grub_err_t
 grub_mini_cmd_exit (struct grub_command *cmd __attribute__ ((unused)),
-		    int argc __attribute__ ((unused)),
-		    char *argv[] __attribute__ ((unused)))
+		    int argc, char *argv[])
 {
+  int retval = 0;
+  unsigned long n;
+
 #ifdef GRUB_MACHINE_EFI
   /*
    * The "exit" command is often used to launch the next boot application.
@@ -198,7 +200,18 @@ grub_mini_cmd_exit (struct grub_command *cmd __attribute__ ((unused)),
    */
   grub_cryptodisk_erasesecrets ();
 #endif
-  grub_exit ();
+
+  if (argc > 1)
+    return grub_error (GRUB_ERR_BAD_ARGUMENT, N_("one argument expected"));
+
+  if (argc == 1)
+    {
+      n = grub_strtoul (argv[0], 0, 10);
+      if (n != ~0UL)
+	retval = n;
+    }
+
+  grub_exit (retval);
   /* Not reached.  */
 }
 
diff --git a/util/grub-mkconfig.in b/util/grub-mkconfig.in
index b93b48b..a42a0af 100644
--- a/util/grub-mkconfig.in
+++ b/util/grub-mkconfig.in
@@ -270,7 +270,10 @@ export GRUB_DEFAULT \
   GRUB_BADRAM \
   GRUB_OS_PROBER_SKIP_LIST \
   GRUB_DISABLE_SUBMENU \
-  GRUB_FORCE_EFI_ALL_VIDEO
+  GRUB_FORCE_EFI_ALL_VIDEO \
+  GRUB_DEFAULT_DTB \
+  SUSE_BTRFS_SNAPSHOT_BOOTING \
+  GRUB_ENABLE_BLSCFG
 
 if test "x${grub_cfg}" != "x"; then
   rm -f "${grub_cfg}.new"
