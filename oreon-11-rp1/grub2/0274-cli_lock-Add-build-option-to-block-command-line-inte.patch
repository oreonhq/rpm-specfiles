From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alec Brown <alec.r.brown@oracle.com>
Date: Wed, 24 Jan 2024 06:26:37 +0000
Subject: [PATCH 274/356] cli_lock: Add build option to block command line
 interface

Add functionality to disable command line interface access and editing of GRUB
menu entries if GRUB image is built with --disable-cli.

Signed-off-by: Alec Brown <alec.r.brown@oracle.com>
Reviewed-by: Vladimir Serbinenko <phcoder@gmail.com>
Reviewed-by: Daniel Kiper <daniel.kiper@oracle.com>
---
 grub-core/kern/main.c          | 28 ++++++++++++++++++++++++++++
 grub-core/kern/rescue_reader.c | 13 +++++++++++++
 include/grub/kernel.h          |  1 +
 include/grub/misc.h            |  2 ++
 include/grub/util/install.h    |  5 ++++-
 util/grub-install-common.c     |  4 ++++
 util/grub-mkimage.c            |  6 ++++++
 util/mkimage.c                 | 13 +++++++++++++
 8 files changed, 71 insertions(+), 1 deletion(-)

diff --git a/grub-core/kern/main.c b/grub-core/kern/main.c
index ee9e36b..edf6419 100644
--- a/grub-core/kern/main.c
+++ b/grub-core/kern/main.c
@@ -32,11 +32,14 @@
 #include <grub/parser.h>
 #include <grub/verify.h>
 #include <grub/types.h>
+#include <grub/types.h>
 
 #ifdef GRUB_MACHINE_PCBIOS
 #include <grub/machine/memory.h>
 #endif
 
+static bool cli_disabled = false;
+
 static bool cli_disabled = false;
 static bool cli_need_auth = false;
 
@@ -337,6 +340,28 @@ check_is_cli_disabled (void)
     }
 }
 
+bool
+grub_is_cli_disabled (void)
+{
+  return cli_disabled;
+}
+
+static void
+check_is_cli_disabled (void)
+{
+  struct grub_module_header *header;
+  header = 0;
+
+  FOR_MODULES (header)
+    {
+      if (header->type == OBJ_TYPE_DISABLE_CLI)
+	{
+	  cli_disabled = true;
+	  return;
+	}
+    }
+}
+
 static void
 reclaim_module_space (void)
 {
@@ -407,6 +432,9 @@ grub_main (void)
   /* Check if the CLI should be disabled */
   check_is_cli_disabled ();
 
+  /* Check if the CLI should be disabled */
+  check_is_cli_disabled ();
+
   /* It is better to set the root device as soon as possible,
      for convenience.  */
   grub_set_prefix_and_root ();
diff --git a/grub-core/kern/rescue_reader.c b/grub-core/kern/rescue_reader.c
index a71ada8..b756d27 100644
--- a/grub-core/kern/rescue_reader.c
+++ b/grub-core/kern/rescue_reader.c
@@ -78,6 +78,19 @@ grub_rescue_read_line (char **line, int cont,
 void __attribute__ ((noreturn))
 grub_rescue_run (void)
 {
+  /* Stall if the CLI has been disabled */
+  if (grub_is_cli_disabled ())
+    {
+      grub_printf ("Rescue mode has been disabled...\n");
+
+      do
+	{
+	  /* Do not optimize out the loop. */
+	  asm volatile ("");
+	}
+      while (1);
+    }
+
   /* Stall if the CLI has been disabled */
   if (grub_is_cli_disabled () || grub_is_cli_need_auth ())
     {
diff --git a/include/grub/kernel.h b/include/grub/kernel.h
index 05f1412..f9c7965 100644
--- a/include/grub/kernel.h
+++ b/include/grub/kernel.h
@@ -33,6 +33,7 @@ enum
   OBJ_TYPE_DTB,
   OBJ_TYPE_DISABLE_SHIM_LOCK,
   OBJ_TYPE_DISABLE_CLI
+  OBJ_TYPE_DISABLE_CLI
 };
 
 /* The module header.  */
diff --git a/include/grub/misc.h b/include/grub/misc.h
index 4bdabe3..ef15734 100644
--- a/include/grub/misc.h
+++ b/include/grub/misc.h
@@ -483,6 +483,8 @@ extern bool EXPORT_FUNC(grub_is_cli_disabled) (void);
 extern bool EXPORT_FUNC(grub_is_cli_need_auth) (void);
 extern void EXPORT_FUNC(grub_cli_set_auth_needed) (void);
 
+extern bool EXPORT_FUNC(grub_is_cli_disabled) (void);
+
 /* Must match softdiv group in gentpl.py.  */
 #if !defined(GRUB_MACHINE_EMU) && (defined(__arm__) || defined(__ia64__) || \
     (defined(__riscv) && (__riscv_xlen == 32)))
diff --git a/include/grub/util/install.h b/include/grub/util/install.h
index 44833e1..0be9d62 100644
--- a/include/grub/util/install.h
+++ b/include/grub/util/install.h
@@ -74,6 +74,8 @@
     1},                                                                 \
   { "disable-cli", GRUB_INSTALL_OPTIONS_DISABLE_CLI, 0, 0,		\
     N_("disabled command line interface access"), 0 },			\
+  { "disable-cli", GRUB_INSTALL_OPTIONS_DISABLE_CLI, 0, 0,		\
+    N_("disabled command line interface access"), 0 },			\
   { "x509key",   'x', N_("FILE"), 0,					\
       N_("embed FILE as an x509 certificate for appended signature checking"), 0}, \
   { "appended-signature-size", GRUB_INSTALL_OPTIONS_APPENDED_SIGNATURE_SIZE,  \
@@ -142,7 +144,8 @@ enum grub_install_options {
   GRUB_INSTALL_OPTIONS_SBAT,
   GRUB_INSTALL_OPTIONS_DISABLE_SHIM_LOCK,
   GRUB_INSTALL_OPTIONS_DISABLE_CLI,
-  GRUB_INSTALL_OPTIONS_APPENDED_SIGNATURE_SIZE
+  GRUB_INSTALL_OPTIONS_APPENDED_SIGNATURE_SIZE,
+  GRUB_INSTALL_OPTIONS_DISABLE_CLI
 };
 
 extern char *grub_install_source_directory;
diff --git a/util/grub-install-common.c b/util/grub-install-common.c
index f634dff..c8a378f 100644
--- a/util/grub-install-common.c
+++ b/util/grub-install-common.c
@@ -473,6 +473,7 @@ static grub_compression_t compression;
 static int disable_cli;
 static size_t appsig_size;
 static size_t appsig_size;
+static int disable_cli;
 
 int
 grub_install_parse (int key, char *arg)
@@ -527,6 +528,9 @@ grub_install_parse (int key, char *arg)
 			  * (nx509keys + 1));
       x509keys[nx509keys++] = xstrdup (arg);
       return 1;
+    case GRUB_INSTALL_OPTIONS_DISABLE_CLI:
+      disable_cli = 1;
+      return 1;
 
     case GRUB_INSTALL_OPTIONS_VERBOSITY:
       verbosity++;
diff --git a/util/grub-mkimage.c b/util/grub-mkimage.c
index a47b878..7038126 100644
--- a/util/grub-mkimage.c
+++ b/util/grub-mkimage.c
@@ -85,6 +85,7 @@ static struct argp_option options[] = {
   {"sbat", 's', N_("FILE"), 0, N_("SBAT metadata"), 0},
   {"disable-shim-lock", GRUB_INSTALL_OPTIONS_DISABLE_SHIM_LOCK, 0, 0, N_("disable shim_lock verifier"), 0},
   {"disable-cli", GRUB_INSTALL_OPTIONS_DISABLE_CLI, 0, 0, N_("disable command line interface access"), 0},
+  {"disable-cli", GRUB_INSTALL_OPTIONS_DISABLE_CLI, 0, 0, N_("disable command line interface access"), 0},
   {"appended-signature-size", 'S', N_("SIZE"), 0, N_("Add a note segment reserving SIZE bytes for an appended signature"), 0},
   {"verbose",     'v', 0,      0, N_("print verbose messages."), 0},
   {"appended-signature-size", 'S', N_("SIZE"), 0, N_("Add a note segment reserving SIZE bytes for an appended signature"), 0},
@@ -139,6 +140,7 @@ struct arguments
   int disable_shim_lock;
   int disable_cli;
   size_t appsig_size;
+  int disable_cli;
   const struct grub_install_image_target_desc *image_target;
   grub_compression_t comp;
 };
@@ -284,6 +286,10 @@ argp_parser (int key, char *arg, struct argp_state *state)
       arguments->disable_cli = 1;
       break;
 
+    case GRUB_INSTALL_OPTIONS_DISABLE_CLI:
+      arguments->disable_cli = 1;
+      break;
+
     case 'v':
       verbosity++;
       break;
diff --git a/util/mkimage.c b/util/mkimage.c
index 364ecac..c94121e 100644
--- a/util/mkimage.c
+++ b/util/mkimage.c
@@ -995,6 +995,9 @@ grub_install_generate_image (const char *dir, const char *prefix,
   if (disable_cli)
     total_module_size += sizeof (struct grub_module_header);
 
+  if (disable_cli)
+    total_module_size += sizeof (struct grub_module_header);
+
   if (config_path)
     {
       config_size = ALIGN_ADDR (grub_util_get_image_size (config_path) + 1);
@@ -1190,6 +1193,16 @@ grub_install_generate_image (const char *dir, const char *prefix,
       offset += sizeof (*header);
     }
 
+  if (disable_cli)
+    {
+      struct grub_module_header *header;
+
+      header = (struct grub_module_header *) (kernel_img + offset);
+      header->type = grub_host_to_target32 (OBJ_TYPE_DISABLE_CLI);
+      header->size = grub_host_to_target32 (sizeof (*header));
+      offset += sizeof (*header);
+    }
+
   if (config_path)
     {
       struct grub_module_header *header;
