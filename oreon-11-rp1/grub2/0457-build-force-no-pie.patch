From 1889a12ae1152f9f078c08a578a0e81671b37a0a Mon Sep 17 00:00:00 2001
From: Daniel Kolesa <q66@chimera-linux.org>
Date: Sun, 21 Apr 2024 01:02:08 +0000
Subject: [PATCH 457/461] build: force -no-pie

---
 configure.ac | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/configure.ac b/configure.ac
index f1a69fa..a117707 100644
--- a/configure.ac
+++ b/configure.ac
@@ -1317,7 +1317,7 @@ if test x"$efiemu_excuse" = x ; then
   if test x"$grub_cv_target_cc_efiemu64_link_format" = xunknown; then
     efiemu_excuse="no suitable link format for efiemu64 found"
   else
-    EFIEMU64_LINK_FORMAT="-Wl,$grub_cv_target_cc_efiemu64_link_format"
+    EFIEMU64_LINK_FORMAT="-Wl,$grub_cv_target_cc_efiemu64_link_format -no-pie"
   fi
 fi
 if test x"$enable_efiemu" = xyes && test x"$efiemu_excuse" != x ; then
-- 
2.47.3

