--- aubit4glsrc/node/Aubit4GLWeb/app/Commands/Prompt.js	1969-12-31 19:00:00.000000000 -0500
+++ aubit4gl-aubit4gl_code-r12987-aubit4glsrc-trunk/node/Aubit4GLWeb/app/Commands/Prompt.js	2025-10-21 09:12:48.000000000 -0400
@@ -0,0 +1,117 @@
+Ext.define('Aubit4GLWeb.Commands.Prompt',{
+    extend: 'Aubit4GLWeb.Commands.Base',
+    statics: {
+      isContextAware: false,
+      execute: function (currentApplication, d) {
+        var win
+        var dtype = d.dtype_hint & 0xffff
+        var dtype_sz = d.dtype_hint >> 16
+        var prmpt = {
+          noTailItemsInToolbar: true,
+          activeApplication: currentApplication,
+          events: d.events,
+          action: function (id, type) {
+            var val = {
+              ID: id
+            }
+            currentApplication.sendResponse(val, prmpt.activeApplication)
+            prmpt.ContextDeactivate()
+          },
+          ContextActivate: function () {
+            if (!win) {
+              cfg = {
+                cls: 'PROMPT' + d.fieldattribute.trim(),
+                listeners: {
+                  specialkey: function (field, e) {
+                    if (e.getKey() == e.ENTER) {
+                      win.OK()
+                    }
+                    if (e.getKey() == e.ESC) {
+                      win.Cancel()
+                    }
+                  }
+                }
+              }
+
+              // Restrict to the length of the string..
+              // we can extend this later for vtypes for datatypes..
+              if (dtype == 0 && dtype_sz) {
+                cfg.enforceMaxLength = true
+                cfg.maxLength = dtype_sz
+              }
+
+              var tField = Ext.widget('textfield', cfg)
+
+              var toolbar = generateToolbar(
+                prmpt,
+                d.events[0].events,
+                function (toolbarActionId, eventType) {
+                  prmpt.action(toolbarActionId, eventType)
+                }
+              )
+
+              win = Ext.create('Ext.window.Window', {
+                modal: true,
+                title: d.text,
+                cls: 'PROMPT' + d.promptattribute.trim(),
+                minWidth: 200,
+                closable: false,
+                layout: 'fit',
+                items: [tField],
+                tbar: toolbar,
+                OK: function () {
+                  var val = {
+                    ID: 'ACCEPT',
+                    SVS: [{ Value: tField.getValue() }]
+                  }
+                  currentApplication.sendResponse(val, prmpt.activeApplication)
+                  win.close()
+                },
+                Cancel: function () {
+                  var val = { ID: 'INTERRUPT', SVS: [{ Value: '' }] }
+                  currentApplication.sendResponse(val, prmpt.activeApplication)
+                  win.close()
+                },
+                listeners: {
+                  close: function () {
+                    console.log('close prompt')
+                  }
+                },
+                buttons: [
+                  {
+                    text: 'Ok',
+                    handler: function () {
+                      win.OK()
+                    }
+                  },
+                  {
+                    text: 'Cancel',
+                    handler: function () {
+                      win.Cancel()
+                    }
+                  }
+                ]
+              })
+            }
+            win.show()
+          },
+          ContextDeactivate: function () {
+            // Do nothing
+            win.hide()
+          },
+          ContextFree: function () {
+            if (win) {
+              win.close()
+              win = null
+            }
+          }
+        }
+
+        currentApplication.Contexts['C' + d.context] = prmpt
+      }
+    }
+  },
+  function () {
+    Aubit4GLWeb.Commands.register('PROMPT', this)
+  }
+)
