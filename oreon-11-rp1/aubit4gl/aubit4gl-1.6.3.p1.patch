diff -ruN aubit4glsrc/node/Aubit4GLWeb/app/Commands/FrontCall.js aubit4gl-aubit4gl_code-r12987-aubit4glsrc-trunk/node/Aubit4GLWeb/app/Commands/FrontCall.js
--- aubit4glsrc/node/Aubit4GLWeb/app/Commands/FrontCall.js	1969-12-31 19:00:00.000000000 -0500
+++ aubit4gl-aubit4gl_code-r12987-aubit4glsrc-trunk/node/Aubit4GLWeb/app/Commands/FrontCall.js	2025-10-23 04:22:19.000000000 -0400
@@ -0,0 +1,173 @@
+Ext.define('Aubit4GLWeb.Commands.FrontCall', {
+extend: "Aubit4GLWeb.Commands.Base", 
+
+statics: {
+	frontCallMagicID: -123,	
+	isContextAware:false, 
+	lastResult:{},
+	sendLastResult: function(currentApplication) {
+		var val=Aubit4GLWeb.Commands.FrontCall.lastResult[currentApplication];
+
+		// If it's a function - call it to get the value (async)
+		if (Ext.isFunction(val)) {
+			val(function(v) {
+				Aubit4GLWeb.Commands.FrontCall.lastResult[currentApplication]=v;
+				Aubit4GLWeb.Commands.FrontCall.sendLastResult(currentApplication);
+			});
+			return;
+		} 
+
+		if (!val) {
+			console.error("No last result for frontcall");
+			return;
+		}
+
+		var syncValues = {
+			SVS: []
+		}
+	
+            var a;
+            for (a = 0; a < val.length; a++) {
+              var valAsString=val[a];
+			  if (!Ext.isString(valAsString)) {
+			   valAsString=Ext.JSON.encode(val[a]);
+			  }
+              var itm = {               
+                Value: valAsString
+              }
+			  
+              syncValues.SVS.push(itm)
+			}
+            
+
+		currentApplication.sendResponse( {
+			ID: Aubit4GLWeb.Commands.FrontCall.frontCallMagicID,
+			FN:'FRONTCALL',
+			SVS: syncValues.SVS
+		}, currentApplication);
+
+		delete Aubit4GLWeb.Commands.FrontCall.lastResult[currentApplication]
+	},
+	execute: function( currentApplication, d) {
+		var args=Aubit4GLWeb.Commands.Base.decodeVSIntoArray(d);
+		var expects=asInt(d.expect);
+
+		console.log("Aubit4GLWeb.Commands.FrontCall");
+		console.dir(args);
+
+		switch (d.name) {
+			case "ui.extjs.executejavascript":
+				Aubit4GLWeb.Commands.FrontCall.lastResult[currentApplication]= [eval(args[0])];
+				break;
+
+			case "ui.extjs.setapplicationname":
+				document.title=args[0];
+				Aubit4GLWeb.Commands.FrontCall.lastResult[currentApplication]=[];
+				break;
+
+			case "ui.extjs.setscreenname":
+				if ( currentApplication.windows["screen"] &&  currentApplication.windows["screen"] &&  currentApplication.windows["screen"]) {
+					currentApplication.windows["screen"].setTitle(args[0]);
+					Aubit4GLWeb.Commands.FrontCall.lastResult[currentApplication]=[];
+				}
+				break;
+
+					case "ui.extjs.setgetkeymessage":
+					getKeyMessage=args[0];
+					Aubit4GLWeb.Commands.FrontCall.lastResult[currentApplication]=[];
+				
+				break;
+
+				case "ui.extjs.prompt":					
+						Aubit4GLWeb.Commands.FrontCall.lastResult[currentApplication] =function(cb) {
+							Ext.Msg.prompt(args[0], args[1], function(btn, text) {
+								if (btn != 'ok') text=null;
+								cb([text]);
+							}, this, false, args[2]);
+						};
+						break;
+
+				case "ui.extjs.messagebox":
+					var buttons = []
+						switch (asInt(args[2])) {
+						case 0:
+							buttons = Ext.MessageBox.OK;
+							break
+						case 1:
+							buttons =Ext.MessageBox.OKCANCEL;
+							break
+
+						case 2:
+							buttons={
+							retry: 'Retry',
+							cancel: 'Cancel',
+							};
+							break
+						case 3:
+							buttons = Ext.MessageBox.YESNOCANCEL;
+							break
+						case 4:
+							buttons =Ext.MessageBox.YESNO;
+							break
+						default:
+								buttons =Ext.MessageBox.OK;
+							break
+						}
+
+
+						var icon;
+						/*
+						INFO    : Ext.baseCSSPrefix + 'msgbox-info'
+						WARNING : Ext.baseCSSPrefix + 'msgbox-warning'
+						QUESTION: Ext.baseCSSPrefix + 'msgbox-question'
+						ERROR   : Ext.baseCSSPrefix + 'msgbox-error'
+						*/
+						switch (asInt(args[2])) {
+							case 0: icon = Ext.Msg.INFO; break;
+							case 1: icon = Ext.Msg.INFO; break;	
+							case 2: icon = Ext.Msg.QUESTION; break;
+							case 3: icon = Ext.Msg.QUESTION; break;
+							case 4: icon = Ext.Msg.QUESTION; break;
+							default: icon = Ext.Msg.INFO; break;
+						}
+
+						Aubit4GLWeb.Commands.FrontCall.lastResult[currentApplication] =function(cb) {
+
+							Ext.Msg.show({
+								title: args[0],
+								msg: args[1],
+								message: args[1],
+								buttons: buttons,
+								icon: icon,
+								fn: function(btnCode) {
+									var btn=-1;
+									switch (btnCode) {
+										case 'ok': btn = 1; break;
+										case 'yes': btn = 1; break;
+										case 'cancel': btn = 2; break;
+										case 'retry': btn = 3; break;								
+										case 'no': btn = 3; break;
+									}
+
+									cb([btn]);									
+								}	
+							});
+						};
+					break;
+			default:
+				console.error("Unhandled frontcall "+ d.name)
+				break;
+		}
+	
+
+	}
+   }
+},
+ function() {
+	Aubit4GLWeb.Commands.register("FRONTCALL", this);
+});
+
+
+
+
+
diff -ruN aubit4glsrc/node/Aubit4GLWeb/app/Commands/GetKey.js aubit4gl-aubit4gl_code-r12987-aubit4glsrc-trunk/node/Aubit4GLWeb/app/Commands/GetKey.js
--- aubit4glsrc/node/Aubit4GLWeb/app/Commands/GetKey.js	1969-12-31 19:00:00.000000000 -0500
+++ aubit4gl-aubit4gl_code-r12987-aubit4glsrc-trunk/node/Aubit4GLWeb/app/Commands/GetKey.js	2025-10-23 04:22:19.000000000 -0400
@@ -0,0 +1,106 @@
+Ext.define('Aubit4GLWeb.Commands.GetKey', {
+extend: "Aubit4GLWeb.Commands.Base", 
+statics: {
+	isContextAware:false, 
+	execute: function( currentApplication, d) {
+		if (!currentApplication.currentWindow) {
+			// Fallback to modal window with key capture capability
+			var fallbackWin = Ext.create('Ext.window.Window', {
+				modal: true,
+				title: 'Get Key',
+				cls: 'GetKey',
+				minWidth: 300,
+				closable: false,
+				layout: 'fit',
+				html: getKeyMessage,
+				bbar: {
+					items: [
+						'->',
+						{
+							text: 'OK',
+							handler: function() {
+								var val = {ID: "ACCEPT", LASTKEY: "2016"};
+								currentApplication.sendResponse(val, currentApplication);
+								fallbackWin.close();
+							}
+						},
+						{
+							text: 'Cancel',
+							handler: function() {
+								var val = {ID: "ACCEPT", LASTKEY: "2011"};
+								currentApplication.sendResponse(val, currentApplication);
+								fallbackWin.close();
+							}
+						}
+					]
+				},
+				listeners: {
+					afterrender: function() {
+						// Make window focusable and focus it
+						this.el.set({tabIndex: -1});
+						this.focus();
+						
+						// Add key listener to capture all keys - try KeyNav first, fallback to DOM events
+						var self = this;
+						try {
+							this.keyNav = new Ext.util.KeyNav({
+								target: this.el,
+								defaultEventAction: 'preventDefault',
+								scope: this,
+								// Handle arrow keys specifically
+								up: function(e) { this.handleKey(e, "UP"); },
+								down: function(e) { this.handleKey(e, "DOWN"); },
+								left: function(e) { this.handleKey(e, "LEFT"); },
+								right: function(e) { this.handleKey(e, "RIGHT"); },
+								// Handle all other keys
+								defaultHandler: function(e) { this.handleKey(e); }
+							});
+						} catch (keyNavError) {
+							console.log('Fallback KeyNav failed, using DOM events:', keyNavError);
+							// Direct DOM event listener as fallback
+							this.domKeyListener = function(e) {
+								self.handleKey(e);
+							};
+							this.el.dom.addEventListener('keydown', this.domKeyListener, true);
+						}
+					},
+					beforeclose: function() {
+						// Clean up key navigation
+						if (this.keyNav) {
+							this.keyNav.destroy();
+						}
+						if (this.domKeyListener && this.el && this.el.dom) {
+							this.el.dom.removeEventListener('keydown', this.domKeyListener, true);
+						}
+					}
+				},
+				handleKey: function(e, keyName) {
+					var key = keyName || "";
+					
+					// If no specific key name provided, check for control combinations
+					if (!key && e.ctrlKey) {
+						key = "CONTROL-" + String.fromCharCode(e.keyCode);
+					}
+					
+					var x = e.keyCode;
+					if (key && Aubit4GLWeb.FGLUtils && Aubit4GLWeb.FGLUtils.getKeyCodeFromKeyName) {
+						x = Aubit4GLWeb.FGLUtils.getKeyCodeFromKeyName(key);
+					}
+					
+					var val = {ID: "ACCEPT", LASTKEY: x};
+					currentApplication.sendResponse(val, currentApplication);
+					this.close();
+				}
+			});
+			
+			fallbackWin.show();
+		} else {
+			currentApplication.currentWindow.setGetKey(d, currentApplication);
+		}
+		return;
+	}
+   }
+},
+ function() {
+	Aubit4GLWeb.Commands.register("GETKEY", this);
+});
