+    env.AFGLSERVER = '127.0.0.1';
+
+    const conn = new Client();
+
+    conn.on('ready', () => {
+        console.log("SSH ready, setting up callback tunnel");
+
+        // forward remotePort on SSH server to localPort (Node callbackServer)
+        conn.forwardOut('127.0.0.1', 0, '127.0.0.1', executionPort, (err, tunnelStream) => {
+            if (err) {
+                socket.emit('servererror', { errorMsg: "SSH port forward failed: " + err });
+                return;
+            }
+
+            console.log("Tunnel established");
+
+            // Set up child object similar to setuid_runner
+            const child = {
+                sshConn: conn,
+                associatedProgramSocket: tunnelStream,
+                associatedWebSocket: socket,
+                programName: data.program,
+                username: data.username
+            };
+            childProcesses[guid] = child;
+
+            // Remote command environment
+            const cmd = `bash -lc 'CONNECTIONGUID="${guid}" AFGLPORT="${executionPort}" AFGLSERVER="127.0.0.1" source /home/aubit4gl/aubit4glsrc/node/baseProgs/runProgram.sh ${data.program}'`;
+            console.log("SSH exec command:", cmd);
+
+            conn.exec(cmd, (err, sshStream) => {
+                if (err) {
+                    socket.emit('servererror', { errorMsg: "SSH exec failed: " + err });
+                    return;
+                }
+
+                // Forward stdout/stderr to the WebSocket
+                sshStream.on('data', d => {
+                    socket.emit('stdout', { guid, data: d.toString(), a: 2 });
+                });
+                sshStream.stderr.on('data', d => {
+                    socket.emit('stderr', { guid, data: d.toString(), a: 1 });
+                });
+
+                sshStream.on('close', code => {
+                    console.log("SSH program closed with code", code);
+                    socket.emit('programComplete', { guid, code });
+                    socket.disconnect();
+                    conn.end();
+                    delete childProcesses[guid];
+                });
+            });
+
+            // Process triggers from UI and send through the callback tunnel
+            socket.on('trigger', d => {
+                if (!child.associatedProgramSocket) {
+                    console.log("Program socket not yet connected, cannot send trigger");
