+// publically editable file to set the icons for buttons..
+
+var menuPosition='top'; // 'top'
+
+// Make the menu toolbar resizable ?
+var menuToolbarResizable=false;
+
+// Menu text position - either the header of the panel - or inline like a normal 4gl menu
+var menuTextPosition='inline'; // header or inline
+
+// Try to create 4gl windows as extjs windows (false creates panels)
+var windowsAsWindows =false;
+
+// if we're using real windows - do we want to create a header (allows dragging of the window)
+var windowHasHeader =false;
+
+// Hide the menu bar when not in use
+var menuHiddenWhenNotUsed=true;
+
+// Always dock the menu bar at the top (or whereever) instead of inline in the form
+var dockedMenuLine=false;
+
+
+var screenHeight=24;
+var screenWidth=80;
+
+// Show actions in toolbar
+// if this is set to false - its assumed actions are on buttons on the forms.
+var showActionInToolbar=false;
+
+var windowsHaveMinimumSize=false;
+
+
+var headerTitle="Aubit4GL Web Portal";
+var getKeyMessage='<div style="padding: 1px; text-align: center;">Press any key or click OK/Cancel</div>';
+
+function getProgramName(nm) {
+if (Ext.String.endsWith(nm,"fgldemo.4ae")) {
+	return "Informix 4GL FGL Demo";
+}
+return nm;
+}
+
+function getIconClass(nm, parentFormName, parentWindowName) {
+	//console.log("getIconClass : " + nm+" "+parentFormName+" "+parentWindowName);
+	
+
+        switch(nm) {
+
+		case "Query": return "icon-"+nm;
+		case "Next": return "icon-"+nm;
+		case "Previous": return "icon-"+nm;
+		case "Add": return "icon-"+nm;
+		case "Update": return "icon-"+nm;
+		case "Remove": return "icon-"+nm;
+		case "Delete": return "icon-"+nm;
+		case "Screen": return "icon-"+nm;
+		case "Master": return "icon-"+nm;
+		case "Detail": return "icon-"+nm;
+		case "Exit": return "icon-"+nm;
+		case "Output": return "icon-output";
+		case "Current": return "icon-current";
+
+		case "6":
+			if (parentFormName=="custform") {
+				return "hide";
+			}
+			break;
+		case "25":
+			if (parentFormName=="custform") {
+				return "hide";
+			}
+			break;
+        }
+        
+        // Fallback to FontAwesome icons for undefined actions
+        return getFontAwesomeIcon(nm);
+}
+
+// FontAwesome icon mapping for common actions
+function getFontAwesomeIcon(actionName) {
+    var iconMap = {
+        // Common CRUD operations
+        "Create": "x-fa fa-plus",
+        "New": "x-fa fa-plus",
+        "Save": "x-fa fa-save",
+        "Edit": "x-fa fa-edit",
+        "Modify": "x-fa fa-edit",
+        "Copy": "x-fa fa-copy",
+        "Duplicate": "x-fa fa-copy",
+        "Print": "x-fa fa-print",
+        "Export": "x-fa fa-download",
+        "Import": "x-fa fa-upload",
+        "Search": "x-fa fa-search",
+        "Find": "x-fa fa-search",
+        "Filter": "x-fa fa-filter",
+        "Sort": "x-fa fa-sort",
+        "Refresh": "x-fa fa-sync-alt",
+        "Reload": "x-fa fa-redo",
+        "Reset": "x-fa fa-undo",
+        "Clear": "x-fa fa-eraser",
+        "Cancel": "x-fa fa-times",
+        "Close": "x-fa fa-times",
+        "Confirm": "x-fa fa-check",
+        "Accept": "x-fa fa-check",
+        "OK": "x-fa fa-check",
+        "Yes": "x-fa fa-check",
+        "No": "x-fa fa-times",
+        
+        // Navigation
+        "First": "x-fa fa-fast-backward",
+        "Last": "x-fa fa-fast-forward",
+        "Back": "x-fa fa-arrow-left",
+        "Forward": "x-fa fa-arrow-right",
+        "Up": "x-fa fa-arrow-up",
+        "Down": "x-fa fa-arrow-down",
+        "Home": "x-fa fa-home",
+        "Menu": "x-fa fa-bars",
+        
+        // File operations
+        "Open": "x-fa fa-folder-open",
+        "File": "x-fa fa-file",
+        "Folder": "x-fa fa-folder",
+        "Upload": "x-fa fa-upload",
+        "Download": "x-fa fa-download",
+        
+        // System actions
+        "Settings": "x-fa fa-cog",
+        "Config": "x-fa fa-cog",
+        "Configuration": "x-fa fa-cog",
+        "Options": "x-fa fa-sliders-h",
+        "Preferences": "x-fa fa-user-cog",
+        "Tools": "x-fa fa-tools",
+        "Help": "x-fa fa-question-circle",
+        "Info": "x-fa fa-info-circle",
+        "About": "x-fa fa-info-circle",
+        "Warning": "x-fa fa-exclamation-triangle",
+        "Error": "x-fa fa-exclamation-circle",
+        "Success": "x-fa fa-check-circle",
+        
+        // User actions
+        "Login": "x-fa fa-sign-in-alt",
+        "Logout": "x-fa fa-sign-out-alt",
+        "User": "x-fa fa-user",
+        "Profile": "x-fa fa-user-circle",
+        "Account": "x-fa fa-user-circle",
+        
+        // Data operations
+        "Report": "x-fa fa-chart-bar",
+        "Chart": "x-fa fa-chart-line",
+        "Graph": "x-fa fa-chart-pie",
+        "Table": "x-fa fa-table",
+        "List": "x-fa fa-list",
+        "View": "x-fa fa-eye",
+        "Show": "x-fa fa-eye",
+        "Hide": "x-fa fa-eye-slash",
+        
+        // Communication
+        "Email": "x-fa fa-envelope",
+        "Mail": "x-fa fa-envelope",
+        "Message": "x-fa fa-comment",
+        "Chat": "x-fa fa-comments",
+        "Phone": "x-fa fa-phone",
+        "Contact": "x-fa fa-address-book"
+    };
+    
+    // Check for exact match first
+    if (iconMap[actionName]) {
+        return iconMap[actionName];
+    }
+    
+    // Check for case-insensitive match
+    var lowerActionName = actionName.toLowerCase();
+    for (var key in iconMap) {
+        if (key.toLowerCase() === lowerActionName) {
+            return iconMap[key];
+        }
+    }
+    
+/*
+    // Check for partial matches (contains)
+    for (var key in iconMap) {
+        if (lowerActionName.indexOf(key.toLowerCase()) !== -1 || key.toLowerCase().indexOf(lowerActionName) !== -1) {
+            return iconMap[key];
+        }
+    }
+*/
+    
+    // Default fallback icon for unrecognized actions
+    return "";
+}
+
+
+
+function getKeyDescription(nm, parentFormName, parentWindowName) {
+	console.log("getKeyDescription : " + nm+" "+parentFormName+" "+parentWindowName);
+	switch (nm) {
+		case "3000":
+			if (parentFormName=="custform") {
+				return "Get help form the current field";
+			}
+			break;
+		case "3001":
+			if (parentFormName=="custform") {
+				return "Return to the menu";
+			}
+			break;
+	}
+}
+
+function getKeyName(nm, parentFormName, parentWindowName) {
+	console.log("getKeyName : " + nm+" "+parentFormName+" "+parentWindowName);
+	switch (nm) {
+		case "3000":
+			if (parentFormName=="custform") {
+				return "Help";
+			}
+			break;
+		case "3001":
+			if (parentFormName=="custform") {
+				return "Quit";
+			}
+			break;
+	}
+}
