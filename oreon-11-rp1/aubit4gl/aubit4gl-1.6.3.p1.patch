--- aubit4glsrc/node/Aubit4GLWeb/app/Commands/Construct.js	1969-12-31 19:00:00.000000000 -0500
+++ aubit4gl-aubit4gl_code-r12987-aubit4glsrc-trunk/node/Aubit4GLWeb/app/Commands/Construct.js	2025-10-21 09:12:48.000000000 -0400
@@ -0,0 +1,195 @@
+Ext.define( "Aubit4GLWeb.Commands.Construct", {
+    extend: "Aubit4GLWeb.Commands.Base",
+    statics: {
+      isContextAware: true,
+      execute: function (currentApplication, d) {
+        var construct = Ext.create("Aubit4GLWeb.Commands.Construct", {
+          currentApplication: currentApplication,
+          d: d
+        });
+        return construct;
+      }
+    },
+    constructor: function (config) {
+      var construct = this;
+
+      this.currentApplication = config.currentApplication;
+      this.d = config.d;
+      var flds = findFields(config.currentApplication, config.d.fieldlist);
+      var a;
+
+      for (a = 0; a < flds.length; a++) {
+        flds[a].setFormFieldValue(flds[a], "");
+      }
+
+      Ext.apply(construct, {
+        first: true,
+        active: false,
+        nextfield: function (fldName) {
+          var fld = findField(this.currentApplication, {
+            name: fldName
+          });
+          if (fld && fld.length == 1 && fld[0].focus) {
+            construct.nextFieldOnActivate = fld[0];
+          }
+        },
+        onEnter: function (fld) {
+          var me = this;
+          nextFieldNext(fld, me.Fields);
+        },
+
+        beforeField: function (eventId) {
+          construct.action(eventId, "BeforeField");
+        },
+        afterField: function (eventId) {
+          construct.action(eventId, "AfterField");
+        },
+
+        contextType: Aubit4GLWeb.FGLContextType.contextConstruct,
+        activeWindow: this.currentApplication.currentWindow,
+        activeApplication: this.currentApplication,
+        events: this.d.events,
+        OriginalFields: this.d.fieldlist,
+        Columns: this.d.columns,
+        Fields: flds,
+        getLastFocusFieldName: function () {
+          if (construct.lastFocusField) {
+            return construct.lastFocusField.A4GL_fullname;
+          }
+          return null;
+        },
+        getSyncValues: function () {
+          var syncValues = {
+            SVS: []
+          };
+          var a;
+          for (a = 0; a < construct.Fields.length; a++) {
+            var fldVal = construct.Fields[a].getFormFieldValue(
+              construct.Fields[a]
+            );
+            var itm = {
+              FN: construct.Fields[a].A4GL_colname,
+              Value: fldVal,
+              FT: construct.Fields[a].A4GL_sqlType,
+              T: construct.Fields[a].isTouched(construct.Fields[a])
+            };
+            syncValues.SVS.push(itm);
+          }
+          return syncValues;
+        },
+        action: function (toolbarActionId, eventType) {
+          switch (eventType) {
+            case "INTERRUPT":
+              var val = { ID: "INTERRUPT" };
+              construct.ContextDeactivate();
+              this.currentApplication.sendResponse(
+                val,
+                construct.activeApplication
+              );
+              break;
+
+            // Need to get field values for these
+            // too..
+            case "ACCEPT":
+              var val = {
+                ID: "ACCEPT",
+                INFIELD: construct.getLastFocusFieldName()
+              };
+
+              if (!fieldsValid(construct.Fields, "CONSTRUCT")) {
+                Ext.MessageBox.alert("Some fields are invalid!");
+                return;
+              }
+
+              Ext.apply(val, construct.getSyncValues());
+              // @todo - Check isFormFieldValid
+              construct.ContextDeactivate();
+              //console.dir(val);
+              this.currentApplication.sendResponse(
+                val,
+                construct.activeApplication
+              );
+              break;
+
+            default:
+              var val = {
+                ID: toolbarActionId,
+                INFIELD: construct.getLastFocusFieldName()
+              };
+
+              Ext.apply(val, construct.getSyncValues());
+              construct.ContextDeactivate();
+              this.currentApplication.sendResponse(
+                val,
+                construct.activeApplication
+              );
+              break;
+          }
+        }
+      });
+
+      construct.toolbar = generateToolbar(
+        construct,
+        this.d.events[0].events,
+        function (toolbarActionId, eventType) {
+          construct.action(toolbarActionId, eventType);
+        }
+      );
+
+      this.currentApplication.Contexts["C" + this.d.context] = construct;
+    },
+
+    ContextActivate: function () {
+      var construct = this;
+      console.log("Construct : ContextActivate");
+      construct.active = true;
+      construct.activeWindow.ensureCurrent();
+      construct.activeWindow.setMenu(construct.toolbar);
+      construct.toolbar.enable();
+      construct.toolbar.setVisible(true);
+      enableActiveFields(this.currentApplication, construct.Fields, construct);
+
+      if (construct.first) {
+        console.log("Construct : first");
+        if (construct.Fields && construct.Fields.length > 0) {
+          console.log("Fields : " + construct.Fields.length);
+          var a;
+          for (a = 0; a < construct.Fields.length; a++) {
+            if (
+              construct.Fields[a].currentContext &&
+              construct.Fields[a].fldIsEnabled &&
+              !(construct.Fields[a].readOnly || construct.Fields[a].disabled)
+            ) {
+              console.log("Setting focus ...");
+
+              construct.Fields[a].focus(false, 10);
+              break;
+            }
+          }
+        }
+      }
+      construct.first = false;
+      if (construct.nextFieldOnActivate) {
+        construct.nextFieldOnActivate.focus();
+        construct.nextFieldOnActivate = 0;
+      }
+    },
+    ContextDeactivate: function () {
+      var construct = this;
+      construct.active = false;
+      construct.toolbar.setVisible(false);
+      disableAllFields(this.currentApplication);
+    },
+    ContextFree: function () {
+      var construct = this;
+      if (construct.active) {
+        construct.ContextDeactivate();
+      }
+      delete this.currentApplication.Contexts["C" + this.d.context];
+      construct.activeWindow.removeMenu(construct.toolbar);
+    }
+  },
+  function () {
+    Aubit4GLWeb.Commands.register("CONSTRUCT", this);
+  }
+);
