--- aubit4glsrc/node/Aubit4GLWeb/app/Commands/ProgramStop.js	1969-12-31 19:00:00.000000000 -0500
+++ aubit4gl-aubit4gl_code-r12987-aubit4glsrc-trunk/node/Aubit4GLWeb/app/Commands/ProgramStop.js	2025-10-29 11:22:23.000000000 -0400
@@ -0,0 +1,51 @@
+Ext.define( "Aubit4GLWeb.Commands.ProgramStop", {
+    extend: "Aubit4GLWeb.Commands.Base",
+    statics: {
+      isContextAware: false,
+      execute: function (currentApplication, d) {
+
+    	currentApplication.stopping=true;
+                if (d.exitcode===undefined) d.exitcode=-1;
+
+                if (d.line &&!d.data) {
+                        d.data=d.line;
+                }
+
+                // Clear any loading state for chained applications
+                if (currentApplication.setLoading) {
+                  currentApplication.setLoading(false);
+                }
+
+                // Clean up the application from the arrays
+                var appIndex = Aubit4GLWeb.Helpers.Application.applications.indexOf(currentApplication);
+                if (appIndex > -1) {
+                  Aubit4GLWeb.Helpers.Application.applications.splice(appIndex, 1);
+                }
+                delete Aubit4GLWeb.Helpers.Application.applicationsByPid[currentApplication.pid];
+                
+                
+                // Only reload the page if this is the last application
+                var reloadCallback=function() {
+                if (Aubit4GLWeb.Helpers.Application.applications.length === 0) {
+                  console.log("No more running applications, reloading page");
+                  location.href = location.href;
+                }
+              };
+
+                if (d.data) {
+                        var str=Ext.pluck(d.data, "data").join("<br/>")
+                        Ext.Msg.alert( "Program stopped - edit code : " +d.exitcode, str, reloadCallback);
+                } else {
+                        Ext.Msg.alert( "Program stopped - edit code : " +d.exitcode, "", reloadCallback);
+                }
+                currentApplication.mainScreen.close();
+                currentApplication.mainScreen.destroy();
+
+
+      }
+    }
+  },
+  function () {
+    Aubit4GLWeb.Commands.register("PROGRAMSTOP", this);
+  }
+);
