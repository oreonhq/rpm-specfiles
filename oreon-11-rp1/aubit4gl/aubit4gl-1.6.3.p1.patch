+    if (screenPanel && screenPanel.items) {
+      screenPanel.items.each(function(item) {
+        if (item.el) {
+          var z = parseInt(item.el.getStyle('z-index') || '1000', 10);
+          if (z >= maxZ) maxZ = z;
+        }
+      });
+    }
+    var newZ = maxZ + 20;
+    win.el.setStyle('z-index', newZ);
+    currentApplication.currentWindow = win;
+    console.log('Forced ' + windowName + ' to front with z-index ' + newZ);
+    return newZ;
+  }
+  return false;
+}
+
+
+
+function trackWindowPositions() {
+    console.log("=== WINDOW POSITIONS ===");
+    var currentApplication =Aubit4GLWeb.Helpers.Application.applications[0];
+    Object.keys(currentApplication.windows).forEach(function(name) {
+        if (name !== 'screen') {
+            var win = currentApplication.windows[name];
+            if (win && win.el) {
+                var x = win.el.getX();
+                var y = win.el.getY();
+                var z = win.el.getStyle('z-index');
+                console.log(name + ':', {
+                    x: x, 
+                    y: y, 
+                    z: z,
+                    visible: win.isVisible()
+                });
+            }
+        }
+    });
+    console.log("========================");
+}
