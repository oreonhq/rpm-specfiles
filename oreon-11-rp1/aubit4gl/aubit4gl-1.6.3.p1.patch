+Ext.define('Aubit4GLWeb.Commands.OpenForm', {
+extend: "Aubit4GLWeb.Commands.Base", 
+statics: {
+	isContextAware:false, 
+	execute: function( currentApplication, d) {
+  	if (d.data) {
+			var fObj=Ext.JSON.decode(d.data);
+			var dt="";
+			if (Ext.isArray(fObj.Data)) {
+				dt=fObj.Data.join("");
+			} else {
+				dt=fObj.Data;
+			}
+			var frmCfg=createForm(dt, d.formname, currentApplication);
+			
+
+			if (frmCfg) { 
+				var frm=Ext.widget(frmCfg);
+				currentApplication.Forms[d.formname]={
+					source: d.source,
+					form: frm
+				}
+			} else {
+				currentApplication.sendError({errMsg:'Invalid form'});
+			}
+		} else {
+			if (d.xmlform) {
+				var dt="";
+				if (d.xmlform[0].data===undefined && d.xmlform[0].$t) {
+					d.xmlform[0].data=d.xmlform[0].$t;
+				}
+				if (Ext.isArray(d.xmlform[0].data)) {
+					dt=d.xmlform[0].data.join("");
+				} else {
+					dt=d.xmlform[0].data;
+				}
+				var frmCfg=createForm(dt, d.formname, currentApplication);
+				if (frmCfg) { 
+					var frm=Ext.widget(frmCfg);
+					currentApplication.Forms[d.formname]={
+						source: d.source,
+						form: frm
+					}
+				} else {
+					currentApplication.sendError({errMsg:'Invalid form'});
+				}
+			}
+		}
+   }
+}
+},
+ function() {
+	Aubit4GLWeb.Commands.register("OPENFORM", this);
+});
