diff -ruN aubit4glsrc/Dockerfile aubit4gl-aubit4gl_code-r12987-aubit4glsrc-trunk/Dockerfile
--- aubit4glsrc/Dockerfile	1969-12-31 19:00:00.000000000 -0500
+++ aubit4gl-aubit4gl_code-r12987-aubit4glsrc-trunk/Dockerfile	2025-09-29 08:22:35.000000000 -0400
@@ -0,0 +1,49 @@
+# Base image: Debian Bookworm
+FROM debian:bookworm-slim
+
+# Environment
+ENV AUBITDIR="/aubit4glsrc"
+ENV LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$AUBITDIR/lib"
+ENV PATH="$PATH:$AUBITDIR/bin:/opt/ibm/informix/lib:/opt/ibm/informix/lib/esql"
+ENV INFORMIXDIR="/opt/ibm/informix"
+ENV A4GL_UI="TUI"
+ENV A4GL_SQLTYPE="pg8"
+ENV A4GL_DBDATE="DMY4"
+ENV DEBIAN_FRONTEND=noninteractive
+
+# Install dependencies
+
+RUN apt-get update && apt-get install -y \
+    wget build-essential autoconf bison flex gdb valgrind curl \
+    libncurses5 libncurses5-dev libncursesw5-dev pkg-config iodbc unixodbc \
+    libecpg-dev libglib2.0-dev doxygen cvs splint expect texi2html \
+    libgmp-dev perl-doc gawk libsigsegv2 sqlite3 libglade2-dev mg \
+    screen htop openjdk-17-jre nodejs npm subversion \
+    libmariadb-dev libmariadb-dev-compat \
+     plocate \
+    && rm -rf /var/lib/apt/lists/*
+
+# disable libhpdf-dev for now..
+
+# Install global npm modules
+RUN npm install -g express net userid guid xml2json xml-js compression xml-escape passwd-linux
+
+# Download & extract Aubit4GL
+RUN wget https://www.aubit.com/aubit4gl/src/aubit4glsrc.1.6.3.tar.gz \ 
+    && tar xf aubit4glsrc.1.6.3.tar.gz -C / \
+    && rm aubit4glsrc.1.6.3.tar.gz
+
+WORKDIR $AUBITDIR
+
+# Configure/build/install Aubit4GL
+RUN ./configure --prefix=/aubit4glbin && make -j$(nproc) 
+#RUN (./configure && make && make install) || (echo "Configure failed - opening shell"; exec bash)
+#RUN ./configure 
+
+# Create Informix mount point (user must supply the SDK)
+VOLUME /opt/ibm/informix
+
+# Default working directory for 4GL source
+WORKDIR /work
+
+CMD ["/bin/bash"]
