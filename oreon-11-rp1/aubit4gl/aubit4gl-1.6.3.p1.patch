+function xdisplayAt(currentApplication, d) {
+  Ext.suspendLayouts();
+  var x = parseInt(d.x, 10) - 1; // 4GL has origin at 1,1
+  var y = parseInt(d.y, 10) - 1;
+  if (!currentApplication.currentWindow.labels) {
+    currentApplication.currentWindow.labels = [];
+  }
+
+  if (!currentApplication.currentWindow.labels[y]) {
+    currentApplication.currentWindow.labels[y] = [];
+  }
+  var ln = currentApplication.currentWindow.labels[y];
+
+  if (!d.data) d.data = "";
+  var lineLn = d.data.length;
+
+  if (d.clrline != "0") {
+    lineLn = 512;
+  }
+
+  var c;
+  for (c = 0; c < lineLn; c++) {
+    if (ln[c + x]) {
+      ln[c + x].destroy();
+    }
+  }
+
+  for (c = 0; c < d.data.length; c++) {
+    var cfg = {
+      xtype: "box",
+      autoEl: "label",
+      ignoreFit: true,
+      html: Ext.String.htmlEncode(d.data.substr(c, 1)),
+      cls: "displayAt_" + d.attribute.trim(),
+      style: {
+        position: "absolute",
+        top: "" + y * yMultiplier + "px",
+        left: "" + (x + c) * xMultiplier + "px",
+        "text-align": "center",
+        width: xMultiplier + "px",
+        height: yMultiplier + "px"
+      }
+    };
+    var lbl = currentApplication.currentWindow.items.items[0].add(cfg);
+
+    ln[x + c] = lbl;
+  }
+
+  Ext.resumeLayouts();
+}
