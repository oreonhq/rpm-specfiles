+// Debug helper function for z-order issues
+function debugZOrder(currentApplication) {
+  console.log('=== Z-Order Debug Information ===');
+  var screenPanel = currentApplication.windows["screen"];
+  if (screenPanel && screenPanel.items) {
+    var panels = [];
+    screenPanel.items.each(function(item, index) {
+      var zIndex = item.el ? parseInt(item.el.getStyle('z-index') || '0', 10) : 'no-el';
+      var visible = item.isVisible ? item.isVisible() : 'unknown';
+      var name = item.A4GL_name || item.itemId || 'unnamed';
+      var rendered = item.rendered || false;
+      panels.push({
+        index: index,
+        name: name,
+        zIndex: zIndex,
+        visible: visible,
+        rendered: rendered
+      });
+    });
+    
+    // Sort by z-index to see the layering order
+    panels.sort(function(a, b) {
+      if (a.zIndex === 'no-el') return -1;
+      if (b.zIndex === 'no-el') return 1;
+      return a.zIndex - b.zIndex;
+    });
+    
+    console.log('Panels sorted by z-index (bottom to top):');
+    panels.forEach(function(panel) {
+      console.log(`  ${panel.name}: z-index=${panel.zIndex}, visible=${panel.visible}, rendered=${panel.rendered}`);
+    });
+  }
+  console.log('Current window:', currentApplication.currentWindow ? currentApplication.currentWindow.A4GL_name : 'none');
+  console.log('Window stack:', currentApplication.windowsStack);
+  console.log('All windows:', Object.keys(currentApplication.windows));
+  console.log('================================');
+}
