+++ aubit4gl-aubit4gl_code-r12987-aubit4glsrc-trunk/node/Aubit4GLWeb/app/Commands/WaitForEvent.js	2025-10-24 09:36:59.000000000 -0400
@@ -0,0 +1,34 @@
+Ext.define('Aubit4GLWeb.Commands.WaitForEvent', {
+extend: "Aubit4GLWeb.Commands.Base", 
+statics: {
+	isContextAware:false, 
+	execute: function( currentApplication, d) {
+  	var context=d.context;
+		if (context=="FRONTCALL") {
+			// Special case - this is a call from the front end to the back end
+			Aubit4GLWeb.Commands.FrontCall.sendLastResult(currentApplication);
+			return;
+		}
+
+		if (context=="GETKEY") {
+			// Special case - this is a GET KEY request
+			return;
+		}
+
+		var c=currentApplication.Contexts["C"+context];
+		if (!c) {
+			console.log("WAITFOREVENT No context:"+d.context);
+			//alert("WAITFOREVENT No context:"+d.context);
+			return;
+		}
+		if (c.ContextActivate) {
+			c.ContextActivate(d);
+		}
+		console.log("Now - wait for event ..");
+		console.dir(c);
+   }
+}
+},
+ function() {
+	Aubit4GLWeb.Commands.register("WAITFOREVENT", this);
+});
