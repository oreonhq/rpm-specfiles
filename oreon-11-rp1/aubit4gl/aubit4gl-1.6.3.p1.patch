+// Helper function to force z-order refresh
+function refreshZOrder(currentApplication) {
+  var screenPanel = currentApplication.windows["screen"];
+  if (screenPanel && screenPanel.items) {
+    var baseZ = 1000;
+    var panelCount = 0;
+    
+    // First pass: set z-index based on creation order (windowsStack)
+    var stack = currentApplication.windowsStack.slice().reverse(); // reverse to get creation order
+    
+    stack.forEach(function(windowName, index) {
+      if (windowName !== 'screen') {
+        var win = currentApplication.windows[windowName];
+        if (win && win.el) {
+          var newZ = baseZ + index + 1;
+          win.el.setStyle('z-index', newZ);
+          console.log('refreshZOrder: Set ' + windowName + ' to z-index ' + newZ);
+          panelCount++;
+        }
+      }
+    });
+    
+    // Bring current window to top
+    if (currentApplication.currentWindow && currentApplication.currentWindow !== screenPanel) {
+      if (currentApplication.currentWindow.el) {
+        var topZ = baseZ + panelCount + 10;
+        currentApplication.currentWindow.el.setStyle('z-index', topZ);
+        console.log('refreshZOrder: Current window ' + currentApplication.currentWindow.A4GL_name + ' set to top z-index ' + topZ);
+      }
+    }
+  }
+}
