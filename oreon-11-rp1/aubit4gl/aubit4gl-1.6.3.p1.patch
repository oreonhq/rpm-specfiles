+/* Z-Order and Background Fix for 4GL Panels */
+
+.solid-background-panel {
+    background-color: #ffffff !important;
+    background-image: none !important;
+}
+
+.solid-background-panel .x-panel-body {
+    background-color: #ffffff !important;
+    background-image: none !important;
+}
+
+.solid-background-panel .x-panel-body-default {
+    background-color: #ffffff !important;
+    background-image: none !important;
+}
+
+/* Ensure form areas have solid backgrounds */
+.formArea {
+    background-color: #ffffff !important;
+    background-image: none !important;
+}
+
+/* Z-index management for overlapping panels */
+.BorderWindow, .BorderlessWindow {
+    position: relative !important;
+}
+
+/* Prevent ExtJS absolute layout from repositioning existing panels */
+.x-panel.solid-background-panel {
+    position: absolute !important;
+}
+
