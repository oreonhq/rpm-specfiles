+Ext.define('Aubit4GLWeb.Commands.Base', {
+requires :[
+	"Aubit4GLWeb.Commands"
+],
+statics: {
+decodeVSIntoArray: function(d) {
+	var vs;
+	if (d.vs) {
+		vs=d.vs;
+		if (Ext.isArray(d.vs)) {
+			if (d.vs.length==1) {
+				vs=d.vs[0];
+			} else {
+				alert("Expecting just one in the array");
+			}
+		}
+		var dt=[];
+		Ext.Array.each(vs.v, function(v) {
+			dt.push(v.data);
+		});
+		return dt;
+	}
+	return [];
+}
+},
+ContextActivate: function() {},
+ContextDeactivate: function() {},
+ContextFree: function() {}
+
