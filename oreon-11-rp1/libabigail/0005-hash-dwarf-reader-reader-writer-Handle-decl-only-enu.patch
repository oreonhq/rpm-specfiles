     </function-type>
-    <class-decl name='S' is-struct='yes' visibility='default' is-declaration-only='yes' hash='0ace7ede05bd13a4' id='type-id-6'/>
+    <class-decl name='S' is-struct='yes' visibility='default' size-in-bits='48' is-declaration-only='yes' hash='0ace7ede05bd13a4' id='type-id-6'/>
     <typedef-decl name='S' type-id='type-id-6' size-in-bits='48' hash='0ace7ede05bd13a4' id='type-id-1'/>
     <typedef-decl name='U' type-id='type-id-7' size-in-bits='56' hash='6f9ec0aef70234cb' id='type-id-3'/>
-    <union-decl name='U' visibility='default' is-declaration-only='yes' hash='6f9ec0aef70234cb' id='type-id-7'/>
+    <union-decl name='U' visibility='default' size-in-bits='56' is-declaration-only='yes' hash='6f9ec0aef70234cb' id='type-id-7'/>
   </abi-types>
   <abi-instr address-size='64'>
       <function-decl name='fn0' type-id='type-id-5' mangled-name='fn0' visibility='default' binding='global' size-in-bits='64' elf-symbol-id='fn0'/>
