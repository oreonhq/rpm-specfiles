From e3dd2aeb4aa4744abcfb47e8c8d052b0413b5712 Mon Sep 17 00:00:00 2001
From: Dodji Seketeli <dodji@seketeli.org>
Date: Mon, 2 Nov 2026 17:30:26 +0100
Subject: [PATCH] hash,dwarf-reader,reader,writer: Handle decl-only enums with
 size

Some DWARVES can express a non-resolved decl-only enum that has size
information.  In that case, the ABIXML writer forgets to emit the size
information and only emits the decl-only-ness.  That can lead to
spurious self-comparison changes related to loss of size information.
Fixed thus.  The patch also fixes some related issues I came across
while reading the code.

	* src/abg-dwarf-reader.cc (get_opaque_version_of_type): Set
	decl-only-ness for opaque enums.
	* src/abg-hash.cc (enum_type_decl::hash::operator()(const
	enum_type_decl& t)): Hash the definition of the decl-only enums.
	* src/abg-reader.cc (build_enum_type_decl): Read size information
	on decl-only enums.
	* src/abg-writer.cc (write_common_type_info): Look through
	decl-only types and emit size information even for decl-only
	types.
	* tests/data/test-read-btf/test1.o.abi: Adjust.
	* tests/data/test-read-dwarf/PR22015-libboost_iostreams.so.abi:
	Likewise.
	* tests/data/test-read-dwarf/PR22122-libftdc.so.abi: Likewise.
	* tests/data/test-read-dwarf/PR27700/test-PR27700.abi: Likewise.

Signed-off-by: Dodji Seketeli <dodji@seketeli.org>
---
 src/abg-dwarf-reader.cc                                  | 1 +
 src/abg-hash.cc                                          | 3 +--
 src/abg-reader.cc                                        | 9 +++++++++
 src/abg-writer.cc                                        | 6 ++++--
 tests/data/test-read-btf/test1.o.abi                     | 4 ++--
 .../test-read-dwarf/PR22015-libboost_iostreams.so.abi    | 6 +++---
 tests/data/test-read-dwarf/PR22122-libftdc.so.abi        | 2 +-
 tests/data/test-read-dwarf/PR27700/test-PR27700.abi      | 2 +-
 8 files changed, 22 insertions(+), 11 deletions(-)

diff --git a/src/abg-dwarf-reader.cc b/src/abg-dwarf-reader.cc
index 136a6682..0add1af7 100644
--- a/src/abg-dwarf-reader.cc
+++ b/src/abg-dwarf-reader.cc
@@ -14090,6 +14090,7 @@ get_opaque_version_of_type(reader&				rdr,
 							    underlying_type,
 							    enumeratorz,
 							    linkage_name));
+	  enum_type->set_is_declaration_only(true);
 	  enum_type->set_is_artificial(die_is_artificial(type_die));
 	  enum_type = is_enum_type(rdr.maybe_associate_die_to_type(type_die,
 								   enum_type));
diff --git a/src/abg-hash.cc b/src/abg-hash.cc
index a25f0579..1df0f34f 100644
--- a/src/abg-hash.cc
+++ b/src/abg-hash.cc
@@ -949,8 +949,7 @@ enum_type_decl::hash::operator()(const enum_type_decl& t) const
   if (t.get_is_declaration_only() && t.get_definition_of_declaration())
     {
       enum_type_decl_sptr e = is_enum_type(t.get_definition_of_declaration());
-
-      hash_t v = hash_as_basic_then_ptr_ref_or_typedef_type(e);
+      hash_t v = operator()(*e);
       return v;
     }
 
diff --git a/src/abg-reader.cc b/src/abg-reader.cc
index 9d48142c..475aa8ce 100644
--- a/src/abg-reader.cc
+++ b/src/abg-reader.cc
@@ -5817,10 +5817,19 @@ build_enum_type_decl(reader&	rdr,
       return result;
     }
 
+  size_t size_in_bits = 0, alignment_in_bits = 0;
+  read_size_and_alignment(node, size_in_bits, alignment_in_bits);
+
   enum_type_decl_sptr t(new enum_type_decl(name, loc,
 					   underlying_type,
 					   enums, linkage_name));
 
+  if (size_in_bits || alignment_in_bits)
+    {
+      t->set_size_in_bits(size_in_bits);
+      t->set_alignment_in_bits(alignment_in_bits);
+    }
+
   t->set_is_anonymous(is_anonymous);
   t->set_is_artificial(is_artificial);
   t->set_is_declaration_only(is_decl_only);
diff --git a/src/abg-writer.cc b/src/abg-writer.cc
index b8828c8a..8a0803db 100644
--- a/src/abg-writer.cc
+++ b/src/abg-writer.cc
@@ -2179,13 +2179,15 @@ write_common_type_info(const type_base_sptr& t,
 		       write_context& ctxt,
 		       const string& id)
 {
-  decl_base_sptr d = is_decl(t);
+  decl_base_sptr d = look_through_decl_only(is_decl(t));
 
   ostream& o = ctxt.get_ostream();
 
   write_is_non_reachable(t, o);
 
-  if (!d || (d && !d->get_is_declaration_only()))
+  if (!d || (d && (!d->get_is_declaration_only()
+		   || t->get_size_in_bits()
+		   || t->get_alignment_in_bits())))
     {
       if (!is_qualified_type(t) && !is_array_type(t))
 	write_size_and_alignment(t, o);
