+        <class-decl name='basic_string&lt;char,std::char_traits&lt;char&gt;,std::allocator&lt;char&gt;&gt;' visibility='default' size-in-bits='256' is-declaration-only='yes' hash='35ad60ae8262b955' id='type-id-125'/>
