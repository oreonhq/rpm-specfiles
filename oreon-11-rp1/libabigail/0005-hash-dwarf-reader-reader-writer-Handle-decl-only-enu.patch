-        <class-decl name='basic_string&lt;wchar_t,std::char_traits&lt;wchar_t&gt;,std::allocator&lt;wchar_t&gt;&gt;' visibility='default' is-declaration-only='yes' hash='6e5702fb5aff44b2' id='type-id-126'/>
+        <class-decl name='basic_string&lt;wchar_t,std::char_traits&lt;wchar_t&gt;,std::allocator&lt;wchar_t&gt;&gt;' visibility='default' size-in-bits='256' is-declaration-only='yes' hash='6e5702fb5aff44b2' id='type-id-126'/>
