diff -rupN pleaser-0.5.6.orig/bintest/test_17_token_timeout_network/test.sh pleaser-0.5.6/bintest/test_17_token_timeout_network/test.sh
--- pleaser-0.5.6.orig/bintest/test_17_token_timeout_network/test.sh	1970-01-01 00:00:00.000000000 +0000
+++ pleaser-0.5.6/bintest/test_17_token_timeout_network/test.sh	2025-06-06 20:28:19.000000000 +0000
@@ -0,0 +1,39 @@
+#!/bin/sh
+
+set -e
+
+apt-get update
+apt-get -y install expect
+
+echo "warm password token"
+cat <<'EOT' | su -s /bin/bash ed
+
+echo 'spawn expect'
+cat <<'EOF' | expect
+spawn bash
+send "/usr/bin/please -w\r"
+expect -re ".*password.*"
+send "password\r"
+expect "$"
+puts "warmed password"
+
+send "sleep 1\r"
+expect "$"
+send "please id\r"
+expect "root"
+
+send "sleep 3\r"
+expect "$"
+
+send "please id\r"
+expect {
+    -re ".*password.*" {
+        puts "found password prompt"
+        exit 0
+    }
+}
+puts "token did not timeout"
+exit 1
+EOF
+EOT
+
