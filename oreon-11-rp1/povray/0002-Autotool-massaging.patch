From 7ccb8cf51d3477087437cca4a5ea53cabda2b2da Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ralf=20Cors=C3=A9pius?= <corsepiu@fedoraproject.org>
Date: Sat, 18 Jan 2014 18:18:13 +0100
Subject: [PATCH 2/3] Autotool massaging.

---
 unix/config/acx_pthread.m4 | 4 ++--
 unix/configure.ac          | 1 +
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/unix/config/acx_pthread.m4 b/unix/config/acx_pthread.m4
index 798d6d1c..c43724e7 100644
--- a/unix/config/acx_pthread.m4
+++ b/unix/config/acx_pthread.m4
@@ -78,7 +78,7 @@
 AC_DEFUN([ACX_PTHREAD], [
 AC_REQUIRE([AC_CANONICAL_HOST])
 AC_LANG_SAVE
-AC_LANG_C
+AC_LANG_PUSH([C])
 acx_pthread_ok=no
 
 # We used to check for pthread.h first, but this fails if pthread.h
@@ -267,5 +267,5 @@ else
         acx_pthread_ok=no
         $2
 fi
-AC_LANG_RESTORE
+AC_LANG_POP([])
 ])dnl ACX_PTHREAD
diff --git a/unix/configure.ac b/unix/configure.ac
index 3335781e..1cc04f99 100644
--- a/unix/configure.ac
+++ b/unix/configure.ac
@@ -184,6 +184,7 @@ Programs
 CFLAGS="$CFLAGS"
 AC_PROG_CC
 AC_PROG_CPP
+AM_PROG_AR
 
 # Force checking essential (ANSI-compliant) headers.
 AC_CHECK_HEADERS([stdlib.h])
-- 
2.31.1

