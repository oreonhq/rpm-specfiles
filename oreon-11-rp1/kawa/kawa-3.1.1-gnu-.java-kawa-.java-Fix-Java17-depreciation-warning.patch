From dd940c01f4ee9dd3263bca844f035bc4a31c76c4 Mon Sep 17 00:00:00 2001
From: Per Bothner <per@bothner.com>
Date: Wed, 22 Sep 2021 08:33:11 -0700
Subject: [PATCH 1/1] gnu/**/*.java, kawa/**/*.java: Fix Java17 depreciation
 warnings.

Mostly like 'new Double(x)' -> 'Double.valueOf(x)'.
---
 gnu/bytecode/ConstantValueAttr.java |  8 ++++----
 gnu/bytecode/Method.java            | 14 --------------
 gnu/ecmascript/BinaryOp.java        |  2 +-
 gnu/ecmascript/Lexer.java           |  4 ++--
 gnu/expr/LetExp.java                |  2 +-
 gnu/expr/LitTable.java              | 16 ++++++++--------
 gnu/kawa/functions/AddOp.java       | 10 +++++-----
 gnu/kawa/functions/MultiplyOp.java  |  6 +++---
 gnu/kawa/lispexpr/LangPrimType.java |  2 +-
 gnu/kawa/reflect/CompileInvoke.java |  4 ++--
 gnu/kawa/util/RangeTable.java       |  6 +++---
 gnu/lists/Convert.java              | 24 ++++++++++++------------
 gnu/text/Options.java               |  2 +-
 gnu/xquery/lang/XQParser.java       |  6 +++---
 gnu/xquery/util/ArithOp.java        |  8 ++++----
 gnu/xquery/util/NumberValue.java    |  2 +-
 16 files changed, 51 insertions(+), 65 deletions(-)

diff --git a/gnu/bytecode/ConstantValueAttr.java b/gnu/bytecode/ConstantValueAttr.java
index af37e4c21..e484828b8 100644
--- a/gnu/bytecode/ConstantValueAttr.java
+++ b/gnu/bytecode/ConstantValueAttr.java
@@ -25,18 +25,18 @@ public class ConstantValueAttr extends Attribute
 	value = ((CpoolString) entry).getString().getString();
 	break;
       case ConstantPool.INTEGER:
-	value = new Integer(((CpoolValue1) entry).value);
+	value = Integer.valueOf(((CpoolValue1) entry).value);
 	break;
       case ConstantPool.LONG:
-	value = new Long(((CpoolValue2) entry).value);
+	value = Long.valueOf(((CpoolValue2) entry).value);
 	break;
       case ConstantPool.FLOAT:
 	float f = Float.intBitsToFloat(((CpoolValue1) entry).value);
-	value = new Float(f);
+	value = Float.valueOf(f);
 	break;
       case ConstantPool.DOUBLE:
 	double d = Double.longBitsToDouble(((CpoolValue2) entry).value);
-	value = new Double(d);
+	value = Double.valueOf(d);
 	break;
       }
     return value;
