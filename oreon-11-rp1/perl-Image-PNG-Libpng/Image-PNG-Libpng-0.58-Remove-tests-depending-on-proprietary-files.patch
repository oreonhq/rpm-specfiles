From ffbdd687bfef9892db556529fdcfddd44c2d0baa Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Petr=20P=C3=ADsa=C5=99?= <ppisar@redhat.com>
Date: Tue, 27 Apr 2021 11:06:14 +0200
Subject: [PATCH] Remove tests depending on proprietary files
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

t/tantei-san.png was generated from examples/luv.png to mimic
properties of the original image expected by the tests:

    $ convert examples/luv.png -extent 293x281 -colors 256 t/tantei-san.png

https://github.com/benkasminbullock/image-png-libpng/issues/36
Signed-off-by: Petr Písař <ppisar@redhat.com>
---
 MANIFEST         |   4 +---
 t/PLTE.t         |   6 +++---
 t/tantei-san.png | Bin 0 -> 9945 bytes
 3 files changed, 4 insertions(+), 6 deletions(-)
 create mode 100644 t/tantei-san.png

diff --git a/MANIFEST b/MANIFEST
index 7ec0cae..9ee703e 100644
--- a/MANIFEST
+++ b/MANIFEST
@@ -8,8 +8,6 @@ examples/get-www-png-out.txt
 examples/get-www-png.pl
 examples/grayface.png
 examples/libpng-write.pl
-examples/life-gray.png
-examples/life.png
 examples/luv.png
 examples/mono.png
 examples/picked-wave.png
@@ -268,7 +266,7 @@ t/split-alpha/basn6a16-alpha.bin
 t/split-alpha/basn6a16-data.bin
 t/sPLT.t
 t/supports.t
-t/tantei-san.png
+t/tantei-san.png                         convert examples/luv.png -extent 293x281 -colors 256 t/tantei-san.png
 t/test.png
 t/tIME.t
 t/transformations.t
diff --git a/t/PLTE.t b/t/PLTE.t
index 0058a8f..bebe39e 100644
--- a/t/PLTE.t
+++ b/t/PLTE.t
@@ -17,9 +17,9 @@ my $colors = Image::PNG::Libpng::get_PLTE ($png);
 #     my $color = $colors->[$i];
 #     print "$i: Red: $color->{red} green: $color->{green} blue: $color->{blue}\n";
 # }
-ok ($colors->[10]->{red} == 10);
-ok ($colors->[20]->{green} == 20);
-ok ($colors->[100]->{blue} == 100);
+ok ($colors->[10]->{red} == 136);
+ok ($colors->[20]->{green} == 247);
+ok ($colors->[100]->{blue} == 154);
 close $file or die $!;
 
 # Local Variables:
diff --git a/t/tantei-san.png b/t/tantei-san.png
new file mode 100644
index 0000000000000000000000000000000000000000..50bc465ccb2641f8556a71caa5424909c94f0e5c
