%global source0_hash 89c5c6665337f56fd2db36bc3805a5619709d51fb136e51937072f63fcc717a7

%{!?oreon_bootstrap:%global oreon_bootstrap %{nil}}
%bcond bootstrap 0
%oreon_bootstrap

%global apiversion 1.15

Name:           cppunit
Version:        1.15.1
Release:        1%{?dist}
Summary:        C++ unit testing framework
License:        LGPL-2.1-or-later
URL:            https://www.freedesktop.org/wiki/Software/cppunit/
Source0:        https://dev-www.libreoffice.org/src/%{name}-%{version}.tar.gz
Patch0:         run-tests-in-deterministic-order.patch

BuildRequires:  oreon-rpm-macros
BuildRequires:  doxygen
BuildRequires:  gcc-c++
BuildRequires:  graphviz
BuildRequires:  make

%description
CppUnit is the C++ port of the famous JUnit framework for unit testing.
Test output is in XML for automatic testing and GUI based for supervised
tests.

%package devel
Summary:        Libraries and headers for cppunit development
Requires:       %{name}%{?_isa} = %{version}-%{release}
Provides:       pkgconfig(cppunit) = %{version}

%description devel
This package contains the libraries and headers necessary for developing
programs that use cppunit.

%package doc
Summary:        HTML formatted API documentation for cppunit
BuildArch:      noarch

%description doc
The cppunit-doc package contains HTML formatted API documentation generated by
the popular doxygen documentation generation tool.

%prep
%oreon_sha256
%autosetup -p1

%build
%configure --enable-doxygen --disable-static --disable-silent-rules
sed -i \
    -e 's|^hardcode_libdir_flag_spec=.*|hardcode_libdir_flag_spec=""|g' \
    -e 's|^runpath_var=LD_RUN_PATH|runpath_var=DIE_RPATH_DIE|g' \
    libtool
%make_build

%install
%make_install
rm -f %{buildroot}%{_libdir}/*.la
rm -rf %{buildroot}%{_datadir}/doc/cppunit %{buildroot}%{_datadir}/%{name}/html

rm -rf __dist-examples __dist-examples-dir
cp -a examples __dist-examples
make -C __dist-examples distclean
find __dist-examples \( -name Makefile.in -o -name .gitignore -o -name '*.opt' -o -name '*.sln' -o -name '*.vcproj' \) -exec rm {} \;
mkdir __dist-examples-dir
mv __dist-examples __dist-examples-dir/examples

%check
%make_build check

%ldconfig_scriptlets

%files
%license COPYING
%doc AUTHORS NEWS README THANKS TODO BUGS doc/FAQ
%{_bindir}/DllPlugInTester
%{_libdir}/libcppunit-%{apiversion}.so.1
%{_libdir}/libcppunit-%{apiversion}.so.1.*

%files devel
%{_includedir}/cppunit
%{_libdir}/libcppunit.so
%{_libdir}/pkgconfig/cppunit.pc

%files doc
%license COPYING
%doc __dist-examples-dir/examples/
%doc doc/html

%changelog
%autochangelog
