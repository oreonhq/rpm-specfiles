From 991f1caa678cbb5e486c5d847e1617f275e7184b Mon Sep 17 00:00:00 2001
From: Alexey Gladkov <legion@kernel.org>
Date: Mon, 19 Oct 2026 18:32:59 +0200
Subject: [PATCH] vlock: ensure locked VT is active when locking all consoles

vlock -a is documented to lock all console sessions and disable VT
switching, telling the user that the entire console display is locked.
This guarantee relies entirely on holding VT_PROCESS mode on the active
VT because vlock refuses switch requests only when its own VT is in the
foreground (change_console() in the kernel consults only fg_console).

If a VT switch occurs before VT_SETMODE takes effect during startup,
or if vlock -a is invoked on a background VT (e.g. "chvt 2; vlock -a" or
via an idle timer), VT_SETMODE succeeds on the background terminal
without protecting anything. Another console remains active with
unrestricted switching, while vlock reports success and falsely claims
the display is locked.

Resolve the current VT number via TIOCGDEV and pull the terminal to
the foreground using VT_ACTIVATE and VT_WAITACTIVE after entering
VT_PROCESS mode. If the VT is already active, the kernel performs no
switch. If activation or waiting fails, restore the previous VT mode and
fail rather than claiming a lock that is not enforced.

Reported-by: Vitezslav Crhonek <vcrhonek@redhat.com>
Signed-off-by: Alexey Gladkov <legion@kernel.org>
---
 src/vlock/vt.c | 38 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/src/vlock/vt.c b/src/vlock/vt.c
index e8bc5da..97aaca2 100644
--- a/src/vlock/vt.c
+++ b/src/vlock/vt.c
@@ -31,6 +31,7 @@
 #include <signal.h>
 #include <sys/vt.h>
 #include <sys/ioctl.h>
+#include <sys/sysmacros.h>
 #include <sys/wait.h>
 
 #include "vlock.h"
@@ -170,6 +171,21 @@ int init_vt(const char *tty)
 
 	if (o_lock_all) {
 		struct vt_mode vtm = ovtm;
+		unsigned int dev;
+
+		if (ioctl(vfd, TIOCGDEV, &dev) < 0) {
+			kbd_warning(errno, "ioctl TIOCGDEV");
+			fprintf(stderr,
+			        _("The entire console display cannot be locked.\n"));
+			return 0;
+		}
+
+		if (!minor(dev) || minor(dev) > MAX_NR_CONSOLES) {
+			kbd_warning(0, "invalid virtual console number: %u", minor(dev));
+			fprintf(stderr,
+			        _("The entire console display cannot be locked.\n"));
+			return 0;
+		}
 
 		vtm.mode   = VT_PROCESS; /* Process controls switching. */
 		vtm.relsig = SIGUSR1;    /* Signal to raise on release request, handled by release_vt(). */
@@ -180,12 +196,34 @@ int init_vt(const char *tty)
 			kbd_warning(errno, "ioctl VT_SETMODE");
 			return 0;
 		}
+
+		/*
+		 * Ensure our VT is in the foreground. If it is already active,
+		 * the kernel does nothing.
+		 */
+		if (ioctl(vfd, VT_ACTIVATE, minor(dev)) < 0) {
+			kbd_warning(errno, "ioctl VT_ACTIVATE");
+			goto activate_fail;
+		}
+
+		while (ioctl(vfd, VT_WAITACTIVE, minor(dev)) < 0) {
+			if (errno != EINTR) {
+				kbd_warning(errno, "ioctl VT_WAITACTIVE");
+				goto activate_fail;
+			}
+		}
 	}
 
 	if (is_vt)
 		init_screen();
 
 	return 1;
+
+activate_fail:
+	ioctl(vfd, VT_SETMODE, &ovtm);
+	fprintf(stderr,
+	        _("The entire console display cannot be locked.\n"));
+	return 0;
 }
 
 void restore_vt(void)
