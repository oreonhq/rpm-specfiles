Fix the following error when ./configure checks for strlcat / strlcpy:

configure:21415: checking for strlcat
configure:21463: g++ -c -Wnon-virtual-dtor -Wno-long-long -Wundef -Wall -W -Wpointer-arith ...

conftest.cc:11:17: error: 'void std::exit(int)' has not been declared within 'std'
   11 | extern "C" void std::exit (int) throw (); using std::exit;
      |                 ^~~
<built-in>: note: only here as a 'friend'
diff -up kbilliards-0.8.7b/configure~ kbilliards-0.8.7b/configure
--- kbilliards-0.8.7b/configure~	2023-07-27 19:24:08.000000000 +0200
+++ kbilliards-0.8.7b/configure	2023-07-27 20:37:51.673169258 +0200
@@ -3072,8 +3072,6 @@ if { (eval echo "$as_me:$LINENO: \"$ac_c
   (exit $ac_status); }; }; then
   for ac_declaration in \
    '' \
-   'extern "C" void std::exit (int) throw (); using std::exit;' \
-   'extern "C" void std::exit (int); using std::exit;' \
    'extern "C" void exit (int) throw ();' \
    'extern "C" void exit (int);' \
    'void exit (int);'
@@ -3806,8 +3804,6 @@ else
 fi
 for ac_declaration in \
    '' \
-   'extern "C" void std::exit (int) throw (); using std::exit;' \
-   'extern "C" void std::exit (int); using std::exit;' \
    'extern "C" void exit (int) throw ();' \
    'extern "C" void exit (int);' \
    'void exit (int);'
