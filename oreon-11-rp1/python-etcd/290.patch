From 428691b699307b7bd08f1dbb09da82eba2597d4d Mon Sep 17 00:00:00 2001
From: "Benjamin A. Beasley" <code@musicinmybrain.net>
Date: Wed, 7 Aug 2024 20:23:19 -0400
Subject: [PATCH] Do not include tests in bdists/wheels

---
 setup.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/setup.py b/setup.py
index 8bbc4d3..ade54a9 100644
--- a/setup.py
+++ b/setup.py
@@ -29,7 +29,7 @@
     author_email="jplana@gmail.com",
     url="http://github.com/jplana/python-etcd",
     license="MIT",
-    packages=find_packages("src"),
+    packages=find_packages("src", exclude=["*.tests", "*.tests.*"]),
     package_dir={"": "src"},
     include_package_data=True,
     zip_safe=False,
