From: Peter Lemenkov <lemenkov@gmail.com>
Date: Mon, 22 Aug 2022 22:58:30 +0200
Subject: [PATCH] Pass source files through epp before edoc gen

Signed-off-by: Peter Lemenkov <lemenkov@gmail.com>

diff --git a/rebar.config b/rebar.config
index e075edf..1a0d446 100644
--- a/rebar.config
+++ b/rebar.config
@@ -4,6 +4,7 @@
 %% $ rebar -C rebar.proper.config get-deps compile
 %% $ rebar -C rebar.proper.config eunit skip_deps=true
 %%
+{edoc_opts, [{preprocess, true}]}.
 {erl_opts, [{platform_define, "^[0-9]+", namespaced_dicts}, warnings_as_errors]}.
 {cover_enabled, true}.
 {eunit_opts, [verbose, {report,{eunit_surefire,[{dir,"."}]}}]}.
