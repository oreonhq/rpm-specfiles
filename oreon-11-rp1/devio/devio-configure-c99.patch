Avoid references to an undeclared exit function.  These issues are in
autoconf-generated code, so they will go away if the configure script
is ever regenerated.  Therefore, this patch has not been submitted
upstream.

diff --git a/configure b/configure
index 611e9d694ae66806..10e70f7d8630a9a5 100755
--- a/configure
+++ b/configure
@@ -2565,7 +2565,7 @@ if { (eval echo "$as_me:$LINENO: \"$ac_compile\"") >&5
   echo "$as_me:$LINENO: \$? = $ac_status" >&5
   (exit $ac_status); }; }; then
   for ac_declaration in \
-   '' \
+   '#include <stdlib.h>' \
    'extern "C" void std::exit (int) throw (); using std::exit;' \
    'extern "C" void std::exit (int); using std::exit;' \
    'extern "C" void exit (int) throw ();' \
@@ -3239,8 +3239,8 @@ main ()
   for (i = 0; i < 256; i++)
     if (XOR (islower (i), ISLOWER (i))
 	|| toupper (i) != TOUPPER (i))
-      exit(2);
-  exit (0);
+      return 2;
+  return 0;
 }
 _ACEOF
 rm -f conftest$ac_exeext
