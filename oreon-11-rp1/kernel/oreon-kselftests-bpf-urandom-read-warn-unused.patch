From: Oreon Packaging
Subject: bpf selftests: use read() result in urandom_read host helper

-Wunused-result (often with -Werror from distro flags) fails on ignored read().

---
 tools/testing/selftests/bpf/urandom_read.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/tools/testing/selftests/bpf/urandom_read.c b/tools/testing/selftests/bpf/urandom_read.c
--- a/tools/testing/selftests/bpf/urandom_read.c
+++ b/tools/testing/selftests/bpf/urandom_read.c
@@ -36,7 +36,8 @@ static noinline void urandom_read(int fd, int count)
 	int i;
 
 	for (i = 0; i < count; ++i) {
-		read(fd, buf, BUF_SIZE);
+		ssize_t __r = read(fd, buf, BUF_SIZE);
+		(void)__r;
 
 		/* trigger USDTs defined in executable itself */
 		urand_read_without_sema(i, count, BUF_SIZE);
