From: Oreon Packaging
Subject: bpf selftests: suppress warn_unused_result in trigger_module_test helpers

trigger_module_test_read() and trigger_module_test_write() intentionally
ignore the read()/write() return values (they're only used to trigger
BPF probes, not to check I/O results). gcc -Werror=unused-result from
distro build flags turns this into a fatal error. Cast to void.

---
 tools/testing/selftests/bpf/test_progs.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tools/testing/selftests/bpf/test_progs.c b/tools/testing/selftests/bpf/test_progs.c
--- a/tools/testing/selftests/bpf/test_progs.c
+++ b/tools/testing/selftests/bpf/test_progs.c
@@ -1071,7 +1071,7 @@ int trigger_module_test_read(int read_sz)
 	if (!ASSERT_GE(fd, 0, "testmod_file_open"))
 		return err;
 
-	read(fd, NULL, read_sz);
+	(void)read(fd, NULL, read_sz);
 	close(fd);
 
 	return 0;
@@ -1095,7 +1095,7 @@ int trigger_module_test_write(int write_sz)
 	if (!ASSERT_GE(fd, 0, "testmod_file_open")) {
 		free(buf);
 		return err;
 	}
 
-	write(fd, buf, write_sz);
+	(void)write(fd, buf, write_sz);
 	close(fd);
 	free(buf);
 	return 0;
