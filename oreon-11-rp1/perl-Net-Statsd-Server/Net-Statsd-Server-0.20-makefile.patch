+++ b/MANIFEST
@@ -8,11 +8,11 @@ META.yml
 Makefile.PL
 README
 TODO
-bin/exampleConfig.js
-bin/localConfig.js
-bin/logConfig.js
-bin/rrdConfig.js
-bin/statsd
