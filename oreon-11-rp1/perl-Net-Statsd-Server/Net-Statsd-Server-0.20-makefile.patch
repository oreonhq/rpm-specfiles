index 8ba5926..4df0534 100644
--- a/Makefile.PL
+++ b/Makefile.PL
@@ -14,11 +14,7 @@ my %WriteMakefileArgs = (
   },
   "DISTNAME" => "Net-Statsd-Server",
   "EXE_FILES" => [
-    "bin/exampleConfig.js",
-    "bin/localConfig.js",
-    "bin/logConfig.js",
-    "bin/rrdConfig.js",
-    "bin/statsd"
