 You can also specify a requirements file, to be passed on to pip, and activate another virtualenv with workon:
diff --git a/tox.ini b/tox.ini
index c0e5599..4481075 100644
--- a/tox.ini
+++ b/tox.ini
@@ -1,6 +1,6 @@
 [tox]
 skip_missing_interpreters=True
-envlist = py{36,37,38,39}-{linux,windows}, pypy
+envlist = py{36,37,38,39}-{linux,windows}, pypy3
 
 [gh-actions]
 python =
@@ -18,9 +18,4 @@ PLATFORM =
 passenv = CI HOME
 # HOME needed until https://github.com/saghul/pythonz/pull/82 will be merged
 commands = py.test -rw []
-deps =
-    -r{toxinidir}/requirements.txt
-    pypy: shutilwhich
-    pypy: pathlib>=1.0.1
-    pypy: mock
-    pypy: backports.shutil_get_terminal_size
+deps = -r{toxinidir}/requirements.txt
