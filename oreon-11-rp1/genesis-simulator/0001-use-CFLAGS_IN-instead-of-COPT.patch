From: "Ankur Sinha (Ankur Sinha Gmail)" <sanjay.ankur@gmail.com>
Date: Sat, 6 Aug 2022 15:34:36 +0100
Subject: [PATCH 1/2] use CFLAGS_IN instead of COPT

---
 genesis/src/par/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/genesis/src/par/Makefile b/genesis/src/par/Makefile
index 1bb8663..b8550f3 100644
--- a/genesis/src/par/Makefile
+++ b/genesis/src/par/Makefile
@@ -10,7 +10,7 @@
 
 SHELL           =       /bin/sh
 CC              =       $(CC)
-CFLAGS 		= 	$(COPT) -D$(OS) -D$(MACHINE) $(DEC_HACK)
+CFLAGS 		= 	$(CFLAGS_IN) -D$(OS) -D$(MACHINE) $(DEC_HACK)
 
 INSTALL_DIR	= 	$(INSTALLDIR)
 INSTALL_LIB 	= 	$(INSTALL_DIR)/lib
