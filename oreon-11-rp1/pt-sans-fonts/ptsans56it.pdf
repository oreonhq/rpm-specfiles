																		<h2 class="entry-title">
															<a href="https://info.paratype.ru/velikie-shrifty-baskerville/">Великие Шрифты. Baskerville</a>
														</h2>

																			<div class="entry-meta below-title">
									<span class="entry-share">
				<span class="entry-share-text">
					Поделиться				</span> <!-- .entry-share-text -->
				
				<span class="entry-share-wrap">
					<span class="entry-share-inner-wrap">
						<a class="share-facebook" rel="nofollow" target="_blank" href="http://www.facebook.com/sharer.php?u=https://info.paratype.ru/velikie-shrifty-baskerville/&amp;t=%D0%92%D0%B5%D0%BB%D0%B8%D0%BA%D0%B8%D0%B5+%D0%A8%D1%80%D0%B8%D1%84%D1%82%D1%8B.+Baskerville" title="Facebook">Facebook</a>
						
						<a class="share-twitter" rel="nofollow" target="_blank" href="https://twitter.com/intent/tweet?text=Великие Шрифты. Baskerville&url=https://info.paratype.ru/velikie-shrifty-baskerville/" title="в Твиттере">Twitter</a>
						
						<a class="share-pinterest" rel="nofollow" target="_blank" href="https://pinterest.com/pin/create/button/?url=https://info.paratype.ru/velikie-shrifty-baskerville/&media=https://info.paratype.ru/wp-content/uploads/2019/05/thumb_baskerville_rc.svg&description=%D0%92%D0%B5%D0%BB%D0%B8%D0%BA%D0%B8%D0%B5+%D0%A8%D1%80%D0%B8%D1%84%D1%82%D1%8B.+Baskerville">Pinterest</a>
						
						<a class="share-mail" rel="nofollow" target="_blank" href="mailto:?subject=I wanted you to see this post&body=Check out this post: Великие Шрифты. Baskerville https://info.paratype.ru/velikie-shrifty-baskerville/" title="Email this post to a friend">по почте</a>
					</span> <!-- .entry-share-inner-wrap -->
