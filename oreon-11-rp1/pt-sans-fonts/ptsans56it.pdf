																		<h2 class="entry-title">
															<a href="https://info.paratype.ru/shriftovaya-sistema-pt-sans-pt-serif-i-pt-mono/">Шрифтовая система PT Sans, PT Serif и PT Mono</a>
														</h2>

																			<div class="entry-meta below-title">
									<span class="entry-share">
				<span class="entry-share-text">
					Поделиться				</span> <!-- .entry-share-text -->
				
				<span class="entry-share-wrap">
					<span class="entry-share-inner-wrap">
						<a class="share-facebook" rel="nofollow" target="_blank" href="http://www.facebook.com/sharer.php?u=https://info.paratype.ru/shriftovaya-sistema-pt-sans-pt-serif-i-pt-mono/&amp;t=%D0%A8%D1%80%D0%B8%D1%84%D1%82%D0%BE%D0%B2%D0%B0%D1%8F+%D1%81%D0%B8%D1%81%D1%82%D0%B5%D0%BC%D0%B0+PT+Sans%2C+PT+Serif+%D0%B8+PT+Mono" title="Facebook">Facebook</a>
						
						<a class="share-twitter" rel="nofollow" target="_blank" href="https://twitter.com/intent/tweet?text=Шрифтовая система PT Sans, PT Serif и PT Mono&url=https://info.paratype.ru/shriftovaya-sistema-pt-sans-pt-serif-i-pt-mono/" title="в Твиттере">Twitter</a>
						
