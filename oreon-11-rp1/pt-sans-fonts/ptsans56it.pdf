.glyphslist {
padding-left:30px;
}

/*uppercase*/
.glyphtooltip_uc {
  position: relative;
  display: inline-block;
  font-family: 'PT Serif Expert', 'Newton Regular', 'Hafiz Regular';
  width: 50px !important;
  text-align: center;
  height: 70px !important; 
  border-radius: 6px;
  padding: 16px 2px;
  margin: 4px 2px;
  font-size: 1.5em;
  background-color: #F5F5F0;
}

.glyphslist_uc div.glyphtooltip {
  background-color: #AAAA9A ! important;
}

/* Tooltip text */
  
.glyphtooltip_uc .glyphtooltiptext {
  visibility: hidden;
  width: 120px;
  background-color: black;
  color: #fff;
  text-align: center;
  font-family: 'Clincher Mono';
  padding: 5px 0;
  border-radius: 7px;
  position: absolute;
  left:48px;
  z-index: 1000;
}
.glyphtooltip_uc:hover .glyphtooltiptext {
  visibility: visible;
}

