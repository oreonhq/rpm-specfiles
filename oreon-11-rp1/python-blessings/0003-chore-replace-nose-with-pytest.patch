From c9cf1d4bf78480a26c45cf4f4b6df5186ed52eb2 Mon Sep 17 00:00:00 2001
From: Jamison Lahman <jamison@lahman.dev>
Date: Thu, 28 Aug 2025 01:50:45 -0700
Subject: [PATCH] chore: replace nose with pytest

(cherry picked from commit 50655345d28627b6fe00210afa253ed0551c8dee)
---
 blessings/tests.py | 14 +++++++++-----
 setup.py           |  3 +--
 tox.ini            |  4 ++--
 3 files changed, 12 insertions(+), 9 deletions(-)

diff --git a/blessings/tests.py b/blessings/tests.py
index 1ee238b..2360e7b 100644
--- a/blessings/tests.py
+++ b/blessings/tests.py
@@ -13,8 +13,7 @@ from curses import tigetstr, tparm
 from functools import partial
 import sys
 
-from nose import SkipTest
-from nose.tools import eq_
+import pytest
 from six import StringIO
 
 # This tests that __all__ is correct, since we use below everything that should
@@ -25,6 +24,11 @@ from blessings import *
 TestTerminal = partial(Terminal, kind='xterm-256color')
 
 
+def eq_(a, b):
+    """Assert equality of two objects."""
+    assert a == b
+
+
 def unicode_cap(cap):
     """Return the result of ``tigetstr`` except as Unicode."""
     return tigetstr(cap).decode('latin1')
@@ -44,7 +48,7 @@ def test_capability():
     """
     t = TestTerminal()
     if not t.is_a_tty:
-        raise SkipTest
+        pytest.skip()
     sc = unicode_cap('sc')
     eq_(t.save, sc)
     eq_(t.save, sc)  # Make sure caching doesn't screw it up.
@@ -73,7 +77,7 @@ def test_height_and_width():
     """Assert that ``height_and_width()`` returns ints."""
     t = TestTerminal()  # kind shouldn't matter.
     if not t.is_a_tty:
-        raise SkipTest()
+        pytest.skip()
     assert isinstance(t.height, int)
     assert isinstance(t.width, int)
 
@@ -185,7 +189,7 @@ def test_number_of_colors_without_tty():
     """``number_of_colors`` should return 0 when there's no tty."""
     # Hypothesis: once setupterm() has run and decided the tty supports 256
     # colors, it never changes its mind.
-    raise SkipTest
+    pytest.skip()
 
     t = TestTerminal(stream=StringIO())
     eq_(t.number_of_colors, 0)
diff --git a/setup.py b/setup.py
index 01488fc..b515c3e 100644
--- a/setup.py
+++ b/setup.py
@@ -20,8 +20,7 @@ setup(
     license='MIT',
     packages=find_packages(exclude=['ez_setup']),
     install_requires=['six'],
-    tests_require=['nose'],
-    test_suite='nose.collector',
+    tests_require=['pytest'],
     url='https://github.com/erikrose/blessings',
     include_package_data=True,
     python_requires='>=2.7, !=3.0.*, !=3.1.*, !=3.2.*, !=3.3.*',
diff --git a/tox.ini b/tox.ini
index 558601e..6fd2f90 100644
--- a/tox.ini
+++ b/tox.ini
@@ -2,7 +2,7 @@
 envlist = py{27,34,35,36,py}
 
 [testenv]
-commands = nosetests blessings
+commands = pytest -s blessings/tests.py
 deps =
-    nose
+    pytest
     six
-- 
2.50.1

