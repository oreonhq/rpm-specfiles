-        set(libclang_lib_dir "${SHIBOKEN_WRAPPER_HOST_CLANG_LIB_PATH}")
-    elseif(orig_libclang_lib_dir AND EXISTS "${orig_libclang_lib_dir}")
-        set(libclang_lib_dir "${orig_libclang_lib_dir}")
-    else()
-        # find libclang
-        find_libclang()
-    endif()
-
-    if(libclang_lib_dir)
-        list(APPEND path_dirs "${libclang_lib_dir}")
-    endif()
