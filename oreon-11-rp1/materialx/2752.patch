From 3a30d52697d7e1be9ef87a9e00e6fbc17fe9e69c Mon Sep 17 00:00:00 2001
From: qbisi <qbisicwate@gmail.com>
Date: Mon, 19 Jan 2026 12:47:35 +0800
Subject: [PATCH 1/3] find X11 with components Xt

---
 source/MaterialXRenderGlsl/CMakeLists.txt | 7 +------
 source/MaterialXRenderHw/CMakeLists.txt   | 7 +------
 source/MaterialXRenderMsl/CMakeLists.txt  | 8 +-------
 3 files changed, 3 insertions(+), 19 deletions(-)

diff --git a/source/MaterialXRenderGlsl/CMakeLists.txt b/source/MaterialXRenderGlsl/CMakeLists.txt
index 32e68a5f36..2ae516e690 100644
--- a/source/MaterialXRenderGlsl/CMakeLists.txt
+++ b/source/MaterialXRenderGlsl/CMakeLists.txt
@@ -9,12 +9,7 @@ if(APPLE)
     find_library(COCOA_FRAMEWORK Cocoa)
     find_package(OpenGL REQUIRED)
 elseif(UNIX)
-    find_package(X11 REQUIRED)
-    # Note - can't just require the Xt component because FindX11 in cmake 3.1
-    # doesn't support it
-    if(NOT X11_Xt_FOUND)
-        message(FATAL_ERROR "Error in building MaterialXRenderGlsl: Xt was not found")
-    endif()
+    find_package(X11 REQUIRED COMPONENTS Xt)
 
     if(SKBUILD)
         set(OpenGL_GL_PREFERENCE LEGACY)
diff --git a/source/MaterialXRenderHw/CMakeLists.txt b/source/MaterialXRenderHw/CMakeLists.txt
index d3adfb5b8f..d4ec96d8e3 100644
--- a/source/MaterialXRenderHw/CMakeLists.txt
+++ b/source/MaterialXRenderHw/CMakeLists.txt
@@ -7,12 +7,7 @@ if(APPLE)
         find_library(COCOA_FRAMEWORK Cocoa)
     endif()
 elseif(UNIX)
-    find_package(X11 REQUIRED)
-    # Note - can't just require the Xt component because FindX11 in cmake 3.1
-    # doesn't support it
-    if(NOT X11_Xt_FOUND)
-        message(FATAL_ERROR "Error in building MaterialXRenderHw: Xt was not found")
-    endif()
+    find_package(X11 REQUIRED COMPONENTS Xt)
 endif()
 
 mx_add_library(MaterialXRenderHw
diff --git a/source/MaterialXRenderMsl/CMakeLists.txt b/source/MaterialXRenderMsl/CMakeLists.txt
index b9db15a7cf..f188c18a4e 100644
--- a/source/MaterialXRenderMsl/CMakeLists.txt
+++ b/source/MaterialXRenderMsl/CMakeLists.txt
@@ -11,13 +11,7 @@ if(APPLE)
         find_package(OpenGL REQUIRED)
     endif()
 elseif(UNIX)
-    find_package(X11 REQUIRED)
-    # Note - can't just require the Xt component because FindX11 in cmake 3.1
-    # doesn't support it
-    if(NOT X11_Xt_FOUND)
-        message(FATAL_ERROR "Error in building MaterialXRenderMsl: Xt was not found")
-    endif()
-
+    find_package(X11 REQUIRED COMPONENTS Xt)
     find_package(OpenGL REQUIRED)
 endif()
 

From dbecc39705277b9e0c4770b199504d3ee357aa60 Mon Sep 17 00:00:00 2001
From: qbisi <qbisicwate@gmail.com>
Date: Mon, 19 Jan 2026 12:48:37 +0800
Subject: [PATCH 2/3] propagate X11 dependency

---
 cmake/modules/MaterialXConfig.cmake.in | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/cmake/modules/MaterialXConfig.cmake.in b/cmake/modules/MaterialXConfig.cmake.in
index 2d61920318..892aab2114 100644
--- a/cmake/modules/MaterialXConfig.cmake.in
+++ b/cmake/modules/MaterialXConfig.cmake.in
@@ -39,6 +39,10 @@ if(@MATERIALX_BUILD_RENDER@ AND @MATERIALX_INSTALL_RESOURCES@)
     set_and_check(MATERIALX_RESOURCES_DIR "@PACKAGE_CMAKE_INSTALL_PREFIX@/resources")
 endif()
 
+if(UNIX AND NOT APPLE)
+    find_dependency(X11 REQUIRED COMPONENTS Xt)
+endif()
+
 check_required_components(@CMAKE_PROJECT_NAME@)
 
 @EXPORT_ALIASES@

From d798775052a7c1a14713cd9c6badbf60c5b01ac7 Mon Sep 17 00:00:00 2001
From: qbisi <qbisicwate@gmail.com>
Date: Mon, 19 Jan 2026 12:43:59 +0800
Subject: [PATCH 3/3] optionally propagate OpenGL dependency

---
 cmake/modules/MaterialXConfig.cmake.in | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/cmake/modules/MaterialXConfig.cmake.in b/cmake/modules/MaterialXConfig.cmake.in
index 892aab2114..6731afb843 100644
--- a/cmake/modules/MaterialXConfig.cmake.in
+++ b/cmake/modules/MaterialXConfig.cmake.in
@@ -41,6 +41,10 @@ endif()
 
 if(UNIX AND NOT APPLE)
     find_dependency(X11 REQUIRED COMPONENTS Xt)
+    if("RenderGlsl" IN_LIST MaterialX_FIND_COMPONENTS)
+        find_dependency(OpenGL REQUIRED)
+        set(MaterialX_RenderGlsl_FOUND TRUE)
+    endif()
 endif()
 
 check_required_components(@CMAKE_PROJECT_NAME@)
