%package -n texlive-fifinddo-info
Summary:        German HTML beamer presentation on nicetext and morehype
Version:        svn29349
License:        LPPL-1.3c
Requires:       texlive-base
Requires:       texlive-kpathsea
Provides:       texlive-fifinddo-info-doc = %{epoch}:%{version}-%{release}
