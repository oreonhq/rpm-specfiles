License:        LPPL-1.3c
Requires:       texlive-base
Requires:       texlive-kpathsea
Provides:       texlive-csquotes-de-doc = %{epoch}:%{version}-%{release}
Obsoletes:      texlive-csquotes-de-doc <= 11:%{version}

%description -n texlive-csquotes-de
