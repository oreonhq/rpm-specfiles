From 0364c0e025cc18f424238211056a7be77ee2a52c Mon Sep 17 00:00:00 2001
From: Sergei Trofimovich <slyich@gmail.com>
Date: Sat, 7 May 2022 08:43:33 +0100
Subject: [PATCH] pty_spawn.c: fix '_copy' build on clang

Without the change build on clang-13 fails as:

      pty_spawn.c:160:6: error: non-void function '_copy' should return a value [-Wreturn-type]
                  return;
                  ^
---
 bicon/pty_spawn.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/bicon/pty_spawn.c b/bicon/pty_spawn.c
index 21ab737..220e632 100644
--- a/bicon/pty_spawn.c
+++ b/bicon/pty_spawn.c
@@ -93,7 +93,7 @@ _xwrite (
   }
 }
 
-static int
+static void
 _copy (
   int master_fd,
   reader master_read,
-- 
2.35.1

From 48720c0f22197d4d5f7b0f5162a3d8f071e6e8a8 Mon Sep 17 00:00:00 2001
From: Takao Fujiwara <tfujiwar@redhat.com>
Date: Wed, 31 Jan 2024 14:05:20 +0900
Subject: [PATCH] bjoining_log2cuni.c: Fix arg in fribidi_log2vis()

fribidi_log2vis() asks FriBidiParType.
---
 bjoining/bjoining_log2cuni.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/bjoining/bjoining_log2cuni.c b/bjoining/bjoining_log2cuni.c
index 7c2f54c..ec1e893 100644
--- a/bjoining/bjoining_log2cuni.c
+++ b/bjoining/bjoining_log2cuni.c
@@ -21,7 +21,7 @@ bjoining_log2cuni (
   if (0 == (options & (B_LOGICAL_OUTPUT | B_LOGICAL_OUTPUT_LOG2CUNI)))
     {
       f = f
-	&& fribidi_log2vis ((FriBidiChar *) str, len, &ptype,
+	&& fribidi_log2vis ((FriBidiChar *) str, len, (FriBidiParType * )&ptype,
 			    (FriBidiChar *) vis, NULL, NULL, NULL);
     }
   else
-- 
2.45.0

