<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
<match>
  <test name="lang" compare="contains">
    <string>en</string>
  </test>
  <test name="lang" compare="contains">
    <string>ru</string>
  </test>
  <test name="family">
    <string>sans</string>
  </test>
  <edit name="family" mode="prepend">
    <string>PT Astra Sans</string>
  </edit>
</match>

<alias>
  <family>PT Astra Sans</family>
  <default>
    <family>sans</family>
  </default>
</alias>
</fontconfig>

