@@ -0,0 +1,111 @@
+import pytest
+
+from cargo2rpm.target import (
+    applies_to_any_linux,
+    dependency_applies_to_host,
+    extract_target_from_header,
+    host_cfgs,
+    strip_foreign_target_tables,
+)
+
+
+def test_host_cfgs_has_linux_basics():
+    cfgs = host_cfgs()
+    assert 'unix' in cfgs
+    assert any(c.startswith('target_os="') for c in cfgs)
+    assert any(c.startswith('target_arch="') for c in cfgs)
+
+
+@pytest.mark.parametrize(
+    ("target", "expected"),
+    [
+        (None, True),
+        ('cfg(unix)', True),
+        ('cfg(windows)', False),
+        ('cfg(target_os = "linux")', True),
+        ('cfg(target_os = "hermit")', False),
+        ('cfg(not(windows))', True),
+        ('cfg(any(target_os = "android", target_os = "linux"))', True),
+        ('cfg(target_os = "freebsd")', False),
+        ('cfg(docsrs)', False),
+        ('x86_64-pc-windows-msvc', False),
+        ('x86_64-unknown-linux-gnu', True),
+    ],
+)
+def test_dependency_applies_to_host(target, expected):
+    assert dependency_applies_to_host(target) is expected
+
+
+@pytest.mark.parametrize(
+    ("target", "expected"),
+    [
+        (None, True),
+        ('cfg(unix)', True),
+        ('cfg(windows)', False),
+        ('cfg(target_os = "linux")', True),
+        ('cfg(all(target_arch = "aarch64", target_os = "linux"))', True),
+        ('cfg(all(target_arch = "loongarch64", target_os = "linux"))', True),
+        ('cfg(target_os = "android")', False),
+        ('cfg(target_os = "redox")', False),
+        ('cfg(target_os = "hermit")', False),
+        ('cfg(target_os = "dragonfly")', False),
+        ('cfg(all(target_arch = "wasm32", not(target_os = "wasi")))', False),
+        ('cfg(target_vendor = "apple")', False),
+        ('aarch64-linux-android', False),
+        ('x86_64-unknown-linux-gnu', True),
+    ],
+)
+def test_applies_to_any_linux(target, expected):
+    assert applies_to_any_linux(target) is expected
+
+
+@pytest.mark.parametrize(
+    ("header", "expected"),
+    [
+        ("target.'cfg(windows)'.dependencies", "cfg(windows)"),
+        ('target."cfg(windows)".dependencies.winapi', "cfg(windows)"),
+        ('target."cfg(target_os = \\"redox\\")".dependencies.redox_users', 'cfg(target_os = "redox")'),
+        (
+            "target.'cfg(all(target_arch = \"aarch64\", target_os = \"linux\"))'.dependencies.libc",
+            'cfg(all(target_arch = "aarch64", target_os = "linux"))',
+        ),
+        ("target.x86_64-pc-windows-msvc.dependencies", "x86_64-pc-windows-msvc"),
+        ("target.aarch64-linux-android.dependencies.libc", "aarch64-linux-android"),
+    ],
+)
+def test_extract_target_from_header(header, expected):
+    assert extract_target_from_header(header) == expected
+
+
+def test_strip_foreign_target_tables():
+    text = """[package]
+name = "demo"
+version = "0.1.0"
+
+[target."cfg(unix)".dependencies.libc]
+version = "0.2"
+
+[target."cfg(target_os = \\"redox\\")".dependencies.redox_users]
+version = "0.4"
+
+[target."cfg(windows)".dependencies.winapi]
+version = "0.3"
+
+[target.'cfg(all(target_arch = "aarch64", target_os = "linux"))'.dependencies.libc]
+version = "0.2"
+
+[target."cfg(all(target_arch = \\"wasm32\\", not(target_os = \\"wasi\\")))".dependencies.instant]
+version = "0.1"
+
+[target."cfg(target_os = \\"dragonfly\\")".dependencies.errno-dragonfly]
+version = "0.1"
+"""
+    out = strip_foreign_target_tables(text)
+    assert "cfg(unix)" in out
+    assert "aarch64" in out and "linux" in out
+    assert "redox" not in out
+    assert "windows" not in out
+    assert "wasm32" not in out
+    assert "dragonfly" not in out
+    assert "instant" not in out
+    assert "errno-dragonfly" not in out
