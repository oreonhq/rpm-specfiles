diff -ruN cargo2rpm/cargo2rpm/target.py cargo2rpm-new/cargo2rpm/target.py
--- a/cargo2rpm/target.py	1970-01-01 02:00:00.000000000 +0200
+++ b/cargo2rpm/target.py	2026-07-30 10:03:10.780887316 +0300
@@ -0,0 +1,288 @@
+"""Evaluate cargo dependency target / cfg expressions against the build host."""
+
+from __future__ import annotations
+
+import platform
+import re
+import shutil
+import subprocess
+import sys
+from functools import lru_cache
+from pathlib import Path
+
+
+_ARCH_MAP = {
+    "x86_64": "x86_64",
+    "amd64": "x86_64",
+    "i386": "x86",
+    "i486": "x86",
+    "i586": "x86",
+    "i686": "x86",
+    "aarch64": "aarch64",
+    "arm64": "aarch64",
+    "armv7l": "arm",
+    "armv6l": "arm",
+    "ppc64le": "powerpc64",
+    "ppc64": "powerpc64",
+    "s390x": "s390x",
+    "riscv64": "riscv64",
+    "mips": "mips",
+    "mips64": "mips64",
+    "loongarch64": "loongarch64",
+}
+
+
+@lru_cache(maxsize=1)
+def host_cfgs() -> frozenset[str]:
+    """Return active rustc-style cfg atoms for the current build host."""
+    rustc = shutil.which("rustc")
+    if rustc:
+        try:
+            out = subprocess.check_output([rustc, "--print", "cfg"], text=True)
+            return frozenset(line.strip() for line in out.splitlines() if line.strip())
+        except (OSError, subprocess.CalledProcessError):
+            pass
+    return _fallback_host_cfgs()
+
+
+def _fallback_host_cfgs() -> frozenset[str]:
+    machine = platform.machine().lower()
+    arch = _ARCH_MAP.get(machine, machine)
+    system = platform.system().lower()
+    if system == "darwin":
+        os_name = "macos"
+    else:
+        os_name = system
+    bits = str(struct_calcsize_bits())
+    endian = sys.byteorder
+    cfgs = {
+        f'target_arch="{arch}"',
+        f'target_os="{os_name}"',
+        f'target_pointer_width="{bits}"',
+        f'target_endian="{endian}"',
+    }
+    if os_name in {"linux", "macos", "freebsd", "netbsd", "openbsd", "android"}:
+        cfgs.add("unix")
+        cfgs.add('target_family="unix"')
+    if os_name == "windows":
+        cfgs.add("windows")
+        cfgs.add('target_family="windows"')
+    return frozenset(cfgs)
+
+
+def struct_calcsize_bits() -> int:
+    return __import__("struct").calcsize("P") * 8
+
+
+def dependency_applies_to_host(target: str | None, cfgs: frozenset[str] | None = None) -> bool:
+    """Return True if a cargo dependency target applies to the build host.
+
+    Untargeted dependencies (target is None) always apply.
+    """
+    if target is None:
+        return True
+    active = host_cfgs() if cfgs is None else cfgs
+    target = target.strip()
+    if target.startswith("cfg(") and target.endswith(")"):
+        return _eval_cfg_expr(target[4:-1], active)
+    return _triple_applies(target, active)
+
+
+def _triple_applies(triple: str, cfgs: frozenset[str]) -> bool:
+    low = triple.lower().replace("_", "-")
+    parts = set(low.split("-"))
+    os_name = None
+    for atom in cfgs:
+        if atom.startswith('target_os="') and atom.endswith('"'):
+            os_name = atom[len('target_os="') : -1]
+            break
+    if not os_name:
+        return False
+    if os_name == "macos":
+        return bool(parts & {"darwin", "macos", "ios"})
+    if os_name == "windows":
+        return "windows" in parts or "win7" in parts
+    if os_name == "linux":
+        return "linux" in parts and "android" not in parts
+    return os_name in parts
+
+
+def _eval_cfg_expr(expr: str, cfgs: frozenset[str]) -> bool:
+    parser = _CfgParser(expr, cfgs)
+    value = parser.parse_option()
+    parser.skip_ws()
+    if parser.pos != len(parser.s):
+        return False
+    return value
+
+
+class _CfgParser:
+    def __init__(self, s: str, cfgs: frozenset[str]):
+        self.s = s
+        self.pos = 0
+        self.cfgs = cfgs
+
+    def skip_ws(self) -> None:
+        while self.pos < len(self.s) and self.s[self.pos].isspace():
+            self.pos += 1
+
+    def peek(self) -> str:
+        self.skip_ws()
+        if self.pos >= len(self.s):
+            return ""
+        return self.s[self.pos]
+
+    def eat(self, ch: str) -> bool:
+        self.skip_ws()
+        if self.pos < len(self.s) and self.s[self.pos] == ch:
+            self.pos += 1
+            return True
+        return False
+
+    def parse_ident(self) -> str:
+        self.skip_ws()
+        start = self.pos
+        while self.pos < len(self.s) and (self.s[self.pos].isalnum() or self.s[self.pos] == "_"):
+            self.pos += 1
+        return self.s[start : self.pos]
+
+    def parse_string(self) -> str:
+        self.skip_ws()
+        if self.pos >= len(self.s) or self.s[self.pos] != '"':
+            return ""
+        self.pos += 1
+        start = self.pos
+        while self.pos < len(self.s) and self.s[self.pos] != '"':
+            self.pos += 1
+        val = self.s[start : self.pos]
+        if self.pos < len(self.s) and self.s[self.pos] == '"':
+            self.pos += 1
+        return val
+
+    def parse_option(self) -> bool:
+        self.skip_ws()
+        ident = self.parse_ident()
+        if not ident:
+            return False
+        if ident in {"all", "any", "not"} and self.peek() == "(":
+            self.eat("(")
+            if ident == "not":
+                value = not self.parse_option()
+                self.eat(")")
+                return value
+            values = []
+            if self.peek() and self.peek() != ")":
+                values.append(self.parse_option())
+                while self.eat(","):
+                    values.append(self.parse_option())
+            self.eat(")")
+            if ident == "all":
+                return all(values) if values else True
+            return any(values) if values else False
+        if self.peek() == "=":
+            self.eat("=")
+            val = self.parse_string()
+            return f'{ident}="{val}"' in self.cfgs
+        return ident in self.cfgs
+
+
+_LINUX_ARCHES = (
+    "x86_64",
+    "aarch64",
+    "x86",
+    "powerpc64",
+    "s390x",
+    "riscv64",
+    "loongarch64",
+)
+
+
+def _linux_cfgs(arch: str, *, env: str | None, endian: str) -> frozenset[str]:
+    width = "32" if arch == "x86" else "64"
+    cfgs = {
+        f'target_arch="{arch}"',
+        'target_os="linux"',
+        'unix',
+        'target_family="unix"',
+        f'target_pointer_width="{width}"',
+        f'target_endian="{endian}"',
+    }
+    if env is not None:
+        cfgs.add(f'target_env="{env}"')
+    return frozenset(cfgs)
+
+
+def applies_to_any_linux(target: str | None) -> bool:
+    """True if target can match any Oreon/Linux arch we care about."""
+    if target is None:
+        return True
+    endians = ("little", "big")
+    envs = (None, "gnu", "musl")
+    for arch in _LINUX_ARCHES:
+        for endian in endians:
+            for env in envs:
+                if dependency_applies_to_host(target, _linux_cfgs(arch, env=env, endian=endian)):
+                    return True
+    return False
+
+
+def extract_target_from_header(header: str) -> str | None:
+    """Pull cfg(...) or triple out of a [target....] header body."""
+    if not header.startswith("target."):
+        return None
+    rest = header[len("target.") :]
+    if rest[:1] in {"'", '"'}:
+        q = rest[0]
+        i = 1
+        buf: list[str] = []
+        while i < len(rest):
+            ch = rest[i]
+            if ch == "\\" and i + 1 < len(rest):
+                buf.append(rest[i + 1])
+                i += 2
+                continue
+            if ch == q:
+                return "".join(buf)
+            buf.append(ch)
+            i += 1
+        return None
+
+    m = re.match(r"^([A-Za-z0-9_-]+)\.(?:dev-|build-)?dependencies(?:\..+)?$", rest)
+    if m:
+        return m.group(1)
+    return None
+
+
+def strip_foreign_target_tables(text: str) -> str:
+    """Drop [target.*] tables that never apply on Linux distro builds."""
+    lines = text.splitlines(keepends=True)
+    out: list[str] = []
+    i = 0
+    while i < len(lines):
+        line = lines[i]
+        sm = re.match(r"^\[(.+)\]\s*$", line.rstrip("\r\n"))
+        if sm and sm.group(1).startswith("target."):
+            header = sm.group(1)
+            target = extract_target_from_header(header)
+            section = [line]
+            i += 1
+            while i < len(lines) and not re.match(r"^\[", lines[i]):
+                section.append(lines[i])
+                i += 1
+            if target is None or applies_to_any_linux(target):
+                out.extend(section)
+            continue
+        out.append(line)
+        i += 1
+    return "".join(out)
+
+
+def strip_foreign_targets_file(path: str) -> bool:
+    """Rewrite Cargo.toml in place. Returns True if changed."""
+    p = Path(path)
+    original = p.read_text(encoding="utf-8")
+    updated = strip_foreign_target_tables(original)
+    if updated == original:
+        return False
+    p.write_text(updated, encoding="utf-8")
+    return True
