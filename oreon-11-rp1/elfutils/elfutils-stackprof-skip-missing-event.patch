diff --git a/tests/run-stackprof-user.sh b/tests/run-stackprof-user.sh
--- a/tests/run-stackprof-user.sh
+++ b/tests/run-stackprof-user.sh
@@ -50,7 +50,7 @@ if [ "x$HAVE_LIBPFM" = "x1" ]; then
     testrun ${abs_top_builddir}/src/stackprof -v -e perf::BRANCHES:freq=4000 -g -- timeout 2 /bin/sh -c "while true; do true; done" 2>&1 | tee test.out
