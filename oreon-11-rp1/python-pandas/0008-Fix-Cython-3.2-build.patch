Subject: [PATCH 1/2] BUG: Recognize tuple state without attrs dict

---
 pandas/_libs/arrays.pyx | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/pandas/_libs/arrays.pyx b/pandas/_libs/arrays.pyx
index 2932f3ff56396..584d0c14a21f8 100644
--- a/pandas/_libs/arrays.pyx
+++ b/pandas/_libs/arrays.pyx
@@ -100,6 +100,9 @@ cdef class NDArrayBacked:
                 if len(state) == 1 and isinstance(state[0], dict):
                     self.__setstate__(state[0])
                     return
+                elif len(state) == 2:
+                    self.__setstate__((*state, {}))
+                    return
                 raise NotImplementedError(state)  # pragma: no cover
 
             data, dtype = state[:2]

