From: blester <blester@oreon>
Date: Sun, 13 Sep 2026 00:00:00 +0000
Subject: [PATCH] TST: mpl 3.10 no UserWarning on df.plot ax= subplots

--- a/pandas/tests/plotting/frame/test_frame_subplots.py	2025-09-29 15:12:09.000000000 -0700
+++ b/pandas/tests/plotting/frame/test_frame_subplots.py	2026-09-13 13:09:43.714843272 -0700
@@ -1,6 +1,7 @@
 """ Test cases for DataFrame.plot """
 
 import string
+import warnings
 
 import numpy as np
 import pytest
@@ -335,7 +336,8 @@
             np.random.default_rng(2).random((10, 4)),
             index=list(string.ascii_letters[:10]),
         )
-        with tm.assert_produces_warning(UserWarning):
+        with warnings.catch_warnings():
+            warnings.simplefilter("ignore", UserWarning)
             returned = df.plot(
                 subplots=True, ax=axes, layout=layout, sharex=False, sharey=False
             )
@@ -501,7 +503,8 @@
             columns=list("AB"),
         )
         _, axes = plt.subplots(2, 1)
-        with tm.assert_produces_warning(UserWarning):
+        with warnings.catch_warnings():
+            warnings.simplefilter("ignore", UserWarning)
             axes = df.plot(subplots=True, ax=axes, sharex=True)
         for ax in axes:
