+def warn_pandas(message, category=UserWarning):
+    import pandas as pd
+
+    pkg_dir = os.path.dirname(pd.__file__)
+    prefixes = []
+    try:
+        names = os.listdir(pkg_dir)
+    except OSError:
+        names = []
+    for name in names:
+        if name == "tests":
+            continue
+        path = os.path.join(pkg_dir, name)
+        if os.path.isdir(path):
+            prefixes.append(path + os.sep)
+        elif name.endswith(".py"):
+            prefixes.append(path)
+    warnings.warn(message, category, skip_file_prefixes=tuple(prefixes))
+
+
