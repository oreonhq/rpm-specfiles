From acd9ea1e9623ab73482fb1031b620f47d7f8854f Mon Sep 17 00:00:00 2001
From: David Foerster <davidfoerster@users.noreply.github.com>
Date: Fri, 13 Jun 2025 18:25:17 +0200
Subject: [PATCH] Fix illegal use of "debug(1)"

---
 demos/gstreamer/mediaplayer/gst_mediaplayer.d | 4 ++--
 demos/gtkD/TestWindow/TestIdle.d              | 2 +-
 demos/gtkD/TestWindow/TestImage.d             | 2 +-
 demos/gtkD/TestWindow/TestScales.d            | 2 +-
 demos/gtkD/TestWindow/TestStock.d             | 2 +-
 demos/gtkD/TestWindow/TestText.d              | 2 +-
 demos/gtkD/TestWindow/TestThemes.d            | 2 +-
 7 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/demos/gstreamer/mediaplayer/gst_mediaplayer.d b/demos/gstreamer/mediaplayer/gst_mediaplayer.d
index bc01e7400..964c39746 100644
--- a/demos/gstreamer/mediaplayer/gst_mediaplayer.d
+++ b/demos/gstreamer/mediaplayer/gst_mediaplayer.d
@@ -270,10 +270,10 @@ public:
 		{
 			isPlaying = true;
 			// Now set to playing and iterate.
-			debug(1) writeln("Setting to PLAYING.");
+			debug(trace) writeln("Setting to PLAYING.");
 			//pipeline.setState( GstState.PLAYING );
 			source.setState( GstState.PLAYING );
-			debug(1) writeln("Running.");
+			debug(trace) writeln("Running.");
 		}
 		else
 		{
