 	'http://ab-initio.mit.edu/wiki/index.php/NLopt',
 	'nlopt-2.2.4.tar.gz',
 	'9c60c6380a10c6d2a06895f0e8756d4f');
-download('ScaLAPACK','http://www.netlib.org/scalapack/scalapack-2.1.0.tgz',
+download('ScaLAPACK','http://www.netlib.org/scalapack/scalapack-2.2.1.tgz',
 	'http://www.netlib.org/scalapack/',
-	'scalapack-2.1.0.tgz',
-	'3b239ef80353c67354a0a62d54946fa8');
+	'scalapack-2.2.1.tgz',
+	'58f32e40b0082012f1564c7f712a0ba1');
