diff --git a/3rdparty/gmm/Makefile b/3rdparty/gmm/Makefile
index 0688129a9..343a546d5 100644
--- a/3rdparty/gmm/Makefile
+++ b/3rdparty/gmm/Makefile
@@ -35,6 +35,7 @@ install: FAIRE
 
 $(SRCDIR): $(PKGDIR)/$(PACKAGE)
 	gunzip -c   $^ | tar xf - 
+	cp ../../config.guess ../../config.sub gmm-$(PKG_VERSION)
 
 $(PKGDIR)/$(PACKAGE):
 	../getall -o Gmm++ -a
diff --git a/3rdparty/scalapack/Makefile b/3rdparty/scalapack/Makefile
index 0ba13728a..9d2dc46ed 100644
--- a/3rdparty/scalapack/Makefile
+++ b/3rdparty/scalapack/Makefile
@@ -12,8 +12,8 @@ all-local: scalapack
 # http://www.netlib.org/scalapack/
 # Hips information
 DIRPKG=../pkg
-SRCDIR=scalapack-2.1.0
-PACKAGE1=$(DIRPKG)/scalapack-2.1.0.tgz
+SRCDIR=scalapack-2.2.1
+PACKAGE1=$(DIRPKG)/scalapack-2.2.1.tar.gz
 SERVER=http://www.netlib.org/scalapack/
 INSTALL=../..
 
diff --git a/3rdparty/scalapack/SLmake-scalapack.inc b/3rdparty/scalapack/SLmake-scalapack.inc
index 6accab241..34aa9ac77 100644
--- a/3rdparty/scalapack/SLmake-scalapack.inc
+++ b/3rdparty/scalapack/SLmake-scalapack.inc
@@ -33,8 +33,8 @@ NOOPT         = -O0 @CNOFLAGS@
 # FFCS - some return statements without value cause trouble on MacOS
 # FFCS - add path to mpi.h (required for MacOS 10.8 + MacPorts OpenMPI)
 # FFCS - added @CNOFLAGS@ according to upstream changes
-CCFLAGS       = -O3 -Wreturn-type @CFLAGS@ -I'@MPI_INC_DIR@' @CNOFLAGS@ -Wno-implicit-function-declaration
-FCFLAGS       = -O3 @CNOFLAGS@ @FCFLAGS@
+CCFLAGS       = -Wreturn-type @CFLAGS@ -I'@MPI_INC_DIR@' @CNOFLAGS@ -Wno-implicit-function-declaration
+FCFLAGS       = @CNOFLAGS@ @FCFLAGS@
 FCLOADER      = $(FC)
 CCLOADER      = $(CC)
 FCLOADFLAGS   = $(FCFLAGS)
diff --git a/configure.ac b/configure.ac
index 213763969..c15bf25da 100644
--- a/configure.ac
+++ b/configure.ac
@@ -1277,7 +1277,7 @@ if test "$enable_download"  = "yes"  ; then
  *no*)
      AC_MSG_NOTICE([ to install missing package  under debian or ubuntu, try ])
      test "$ff_git" = no && AC_MSG_NOTICE([ sudo apt-get install git])
-     AC_MSG_ERROR([ Sorry missing  git command !]);;
+     AC_MSG_WARN([ Sorry missing  git command !]);;
  esac
 fi
 
@@ -2226,23 +2226,22 @@ if test "$ff_with_gsl" = "yes"; then
 fi
 
 m4_map([AC_FF_WHERELIB],[
-	[[mumps],[-ldmumps -lzmumps  -lmumps_common  -lpord],[dmumps_c.h],[]],
+	[[mumps],[-ldmumps -lzmumps  -lmumps_common  -lpord],[MUMPS/dmumps_c.h],[]],
 	[[mumps_seq],[-ldmumps_seq -lzmumps_seq  -lmumps_common_seq  -lpord_seq -lmpiseq_seq],[dmumps_c.h],[]],
 	[[libseq],[-lmpiseq_seq],[${inc_usr_include}mumps_seq/mpi.h]],
 	[[mumps_ptscotch],[-lpord_ptscotch -lmumps_common_ptscotch -ldmumps_ptscotch -lzmumps_ptscotch -lpord_ptscotch],[dmumps_c.h]],
 	[[mumps_scotch],[-lpord_scotch -lmumps_common_scotch -ldmumps_scotch -lzmumps_scotch -lpord_scotch],[dmumps_c.h]],
 	[[fftw3],[-lfftw3],[${inc_usr_include}fftw3.h],[]],
-	[[superlu],[-lsuperlu],[${inc_usr_include}superlu/superlu_enum_consts.h],[]],
+	[[superlu],[-lsuperlu],[SuperLU/superlu_enum_consts.h],[]],
         [[blacs],[ -lblacsCinit$ff_with_mpi	-lblacsF77init$ff_with_mpi	-lblacs$ff_with_mpi],[]],
         [[scalapack],[-lscalapack$ff_with_mpi],[]],
-        [[scotch],[-lscotch -lscotcherr],[scotch.h]],
+        [[scotch],[-lscotch -lscotcherr],[scotch_wrapper.h]],
         [[ptscotch],[-lptscotch -lptscotcherr],[ptscotch.h]],
-	[[metis],[-lmetis],[${inc_usr_include}metis/metis.h],[]],
 	[[metis],[-lmetis],[metis.h],[]],
 	[[parmetis],[-lparmetis -lmetis],[],[]],
 	[[freeyams],[-lfreeyams],[freeyamslib.h],[]],
-	[[mmg3d],[-lmmg3d-v4],[libmmg3d.h],[]],
-        [[mmg],[-lmmg],[libmmg.h],[]],
+	[[mmg3d],[-lmmg3d],[mmg/mmg3d/libmmg3d.h],[]],
+        [[mmg],[-lmmg],[mmg/libmmg.h],[]],
         [[zlib],[-lz],[zlib.h],[]],
         [[parmmg],[-lparmmg],[libparmmg.h],[]],
 	[[mshmet],[-lmshmet],[mshmetlib.h],[]],
@@ -2258,7 +2257,7 @@ TOOL_DISABLE(tetgen,tetgen.$DYLIB_SUFFIX)
 TOOL_DISABLE(lapack,lapack.$DYLIB_SUFFIX)
 TOOL_DISABLE(metis,metis.$DYLIB_SUFFIX)
 TOOL_DISABLE(parmetis,parmetis.$DYLIB_SUFFIX)
-TOOL_DISABLE(mmg3d,mmg3d-v4.0.$DYLIB_SUFFIX)
+TOOL_DISABLE(mmg3d,mmg3d.$DYLIB_SUFFIX)
 if test "$ff_cmake" = yes -o \( "$ff_mmg_ok" = yes -a -z "$TOOL_COMPILE_mmg" \); then
      TOOL_DISABLE(mmg,mmg.$DYLIB_SUFFIX)
 fi
