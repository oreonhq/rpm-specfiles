Apply generic C99 compatibility fixes to the configure script,
to avoid implicit function declarations.  This improves compatibility
with future compilers and avoids miscompilations.

There is no need to upstream this patch because if upstream re-runs
autoconf, these issues will automatically be fixed.

diff --git a/configure b/configure
index fbc5969d36a9e384..7a59c88bf4fddfa3 100755
--- a/configure
+++ b/configure
@@ -2638,7 +2638,7 @@ if { (eval echo "$as_me:$LINENO: \"$ac_compile\"") >&5
   echo "$as_me:$LINENO: \$? = $ac_status" >&5
   (exit $ac_status); }; }; then
   for ac_declaration in \
-   '' \
+   '#include <stdlib.h>' \
    'extern "C" void std::exit (int) throw (); using std::exit;' \
    'extern "C" void std::exit (int); using std::exit;' \
    'extern "C" void exit (int) throw ();' \
@@ -3388,8 +3388,8 @@ main ()
   for (i = 0; i < 256; i++)
     if (XOR (islower (i), ISLOWER (i))
 	|| toupper (i) != TOUPPER (i))
-      exit(2);
-  exit (0);
+      return 2;
+  return 0;
 }
 _ACEOF
 rm -f conftest$ac_exeext
