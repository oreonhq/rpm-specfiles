[Unit]
Description=Mumble Daemon
Documentation=man:murmurd(1) http://www.mumble.info
After=network.target

[Service]
User=mumble-server
Group=mumble-server
Type=exec
ExecStart=/usr/bin/mumble-server -fg -ini /etc/murmur.ini
Restart=always
PrivateDevices=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
