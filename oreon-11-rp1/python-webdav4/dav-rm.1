.TH DAV\-RM "1" "February 2024" "" "User Commands"
.SH NAME
.B dav\ rm
\(en Removes a file from the remote server
.SH SYNOPSIS
.B dav\ rm
.RB [ \-h ]
.RB [ \-\-recursive ]
.I path
.SH OPTIONS
.SS "POSITIONAL\ ARGUMENTS"
.TP
.I path
Path to remove
.SS "OPTIONAL\ ARGUMENTS"
.TP
.B \-h\fR,\ \fB\-\-help
Show a help message and exit
.TP
.B \-\-recursive\fR,\ \fB\-R
Recurse into directories
.SH "SEE\ ALSO"
.BR dav\-ls (1),
.BR dav\-cp (1),
.BR dav\-mv (1),
.\" .BR dav\-rm (1),
.BR dav\-mkdir (1),
.BR dav\-run (1),
.BR dav\-cat (1),
.BR dav\-sync (1),
.BR dav\-du (1)
.P
.BR dav (1)
