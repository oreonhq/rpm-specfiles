#!/usr/bin/env python3
import os, subprocess, sys

def gated_requires(full, boot):
    seen = set(boot)
    out = []
    for item in full:
        if item not in seen and item not in out:
            out.append(item)
    return out

def unmet(reqs, probe):
    return [req for req in reqs if not probe(req)]

def spec_from_parent():
    raw = open("/proc/%s/cmdline" % os.getppid(), "rb").read().split(b"\0")
    args = [a.decode("utf-8", "replace") for a in raw if a]
    for arg in args:
        if arg.endswith(".spec") and os.path.isfile(arg):
            return arg
    return ""

def buildrequires(spec, extra):
    cmd = ["rpmspec", "-q", "--buildrequires", "--define", "oreon_bootstrap %{nil}", *extra, spec]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        return []
    return [line.strip() for line in r.stdout.splitlines() if line.strip()]

def available(req):
    name = req.split()[0]
    if not name or name.startswith(("%", "(")):
        return False
    q = subprocess.run(["rpm", "-q", "--whatprovides", name], capture_output=True, text=True)
    if q.returncode == 0 and q.stdout.strip():
        return True
    d = subprocess.run(["dnf", "repoquery", "-q", "--whatprovides", name], capture_output=True, text=True)
    return d.returncode == 0 and bool(d.stdout.strip())

def main():
    spec = spec_from_parent()
    if not spec:
        return 0
    gap = gated_requires(buildrequires(spec, []), buildrequires(spec, ["--with", "bootstrap"]))
    if unmet(gap, available):
        print("1")
    return 0

if __name__ == "__main__":
    sys.exit(main())
