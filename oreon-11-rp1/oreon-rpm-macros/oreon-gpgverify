#!/usr/bin/bash
set -euo pipefail

key=
sig=
data=
stdin_data=

take_val() {
  local a=$1
  if [[ $a == *=* ]]; then
    printf '%s' "${a#*=}"
    return 1
  fi
  printf '%s' "$2"
  return 0
}

while [ $# -gt 0 ]; do
  case $1 in
    --key|--keyring|--key=*|--keyring=*)
      if v=$(take_val "$1" "${2-}"); then
        shift 2
      else
        shift
      fi
      key=$v
      ;;
    --sig|--signature|--sig=*|--signature=*)
      if v=$(take_val "$1" "${2-}"); then
        shift 2
      else
        shift
      fi
      sig=$v
      ;;
    --data|--data=*)
      if v=$(take_val "$1" "${2-}"); then
        shift 2
      else
        shift
      fi
      data=$v
      if [ "$data" = - ]; then
        stdin_data=$(mktemp)
        cat > "$stdin_data"
        data=$stdin_data
      fi
      ;;
    *)
      echo "oreon-gpgverify: unknown arg $1" >&2
      exit 2
      ;;
  esac
done

if [ -z "$key" ] || [ -z "$sig" ] || [ -z "$data" ]; then
  echo "oreon-gpgverify: need --key, --sig, and --data" >&2
  exit 2
fi

for f in "$key" "$sig" "$data"; do
  if [ ! -f "$f" ]; then
    echo "oreon-gpgverify: missing $f" >&2
    exit 1
  fi
done

tmp=$(mktemp -d)
trap 'rm -rf "$tmp" ${stdin_data:+"$stdin_data"}' EXIT
mkdir -m 700 "$tmp/gnupg"
GNUPGHOME="$tmp/gnupg" gpg --batch --quiet --import "$key"
GNUPGHOME="$tmp/gnupg" gpg --batch --quiet --export > "$tmp/ring.gpg"
gpgv --keyring "$tmp/ring.gpg" "$sig" "$data"
