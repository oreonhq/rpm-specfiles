#!/usr/bin/bash
set -euo pipefail

key=
sig=
data=

while [ $# -gt 0 ]; do
  case $1 in
    --key) key=$2; shift 2 ;;
    --sig) sig=$2; shift 2 ;;
    --data) data=$2; shift 2 ;;
    *)
      echo "oreon-gpgverify: unknown arg $1" >&2
      exit 2
      ;;
  esac
done

if [ -z "$key" ] || [ -z "$sig" ] || [ -z "$data" ]; then
  echo "oreon-gpgverify: need --key, --sig, and --data" >&2
  exit 2
fi

for f in "$key" "$sig" "$data"; do
  if [ ! -f "$f" ]; then
    echo "oreon-gpgverify: missing $f" >&2
    exit 1
  fi
done

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -m 700 "$tmp/gnupg"
GNUPGHOME="$tmp/gnupg" gpg --batch --quiet --import "$key"
GNUPGHOME="$tmp/gnupg" gpg --batch --quiet --export > "$tmp/ring.gpg"
gpgv --keyring "$tmp/ring.gpg" "$sig" "$data"
