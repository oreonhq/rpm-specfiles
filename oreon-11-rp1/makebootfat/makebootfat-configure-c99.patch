Fix generic autoconf issue impacting C99 compiler compatibility, to
avoid future build failures.

This does not have to be upstreamed because it only affects code
generated by historic autoconf, so it goes away once makebootfat
upstream re-runs autoconf as part of a potential future release.

diff --git a/configure b/configure
index b36d2f6de206582b..a2fb635d5754057d 100755
--- a/configure
+++ b/configure
@@ -2625,7 +2625,7 @@ if { (eval echo "$as_me:$LINENO: \"$ac_compile\"") >&5
   echo "$as_me:$LINENO: \$? = $ac_status" >&5
   (exit $ac_status); }; }; then
   for ac_declaration in \
-   '' \
+   '#include <stdlib.h>' \
    'extern "C" void std::exit (int) throw (); using std::exit;' \
    'extern "C" void std::exit (int); using std::exit;' \
    'extern "C" void exit (int) throw ();' \
@@ -3489,8 +3489,8 @@ main ()
   for (i = 0; i < 256; i++)
     if (XOR (islower (i), ISLOWER (i))
 	|| toupper (i) != TOUPPER (i))
-      exit(2);
-  exit (0);
+      return 2;
+  return 0;
 }
 _ACEOF
 rm -f conftest$ac_exeext
