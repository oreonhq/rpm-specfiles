%global source0_hash f94a34180808c3edb24c1779f72363246dd4143a89f579ef2ac168a45b04443f

Summary:        Top-like display of Apache logs
Name:           apachetop
Version:        0.23.2
Release:        9%{?dist}
License:        BSD-3-Clause
URL:            https://github.com/tessus/apachetop
Source0:        https://github.com/tessus/apachetop/releases/download/%{version}/apachetop-%{version}.tar.gz
Source1:        https://github.com/tessus/apachetop/releases/download/%{version}/apachetop-%{version}.tar.gz.asc
Source2:        https://keys.openpgp.org/vks/v1/by-fingerprint/8A5570C1BD85D34EADBC386C172380A011EF4944
BuildRequires:  gnupg2
BuildRequires:  gcc-c++
BuildRequires:  ncurses-devel
BuildRequires:  m4
BuildRequires:  readline-devel
BuildRequires:  pcre2-devel
BuildRequires:  make

%description
ApacheTop watches a logfile generated by Apache (in standard common or
combined logformat, although it doesn't (yet) make use of any of the extra
fields in combined) and generates human-parsable output in realtime.

%prep
test "%{source0_hash}" = "none" || { f="%{SOURCE0}"; test -f "$f" || { echo "oreon: missing Source0 $f" >&2; exit 1; }; h=$(sha256sum "$f" | awk '{print $1}'); test "$h" = "%{source0_hash}" || { echo "oreon: Source0 hash mismatch" >&2; exit 1; }; }

%{gpgverify} --keyring='%{SOURCE2}' --signature='%{SOURCE1}' --data='%{SOURCE0}'
%setup -q

%build
%configure --with-logfile=%{_localstatedir}/log/httpd/access_log
%make_build

%install
%make_install

%files 
%license LICENSE
%doc AUTHORS ChangeLog README
%{_bindir}/%{name}
%{_mandir}/man1/%{name}.1*

%changelog
%autochangelog
