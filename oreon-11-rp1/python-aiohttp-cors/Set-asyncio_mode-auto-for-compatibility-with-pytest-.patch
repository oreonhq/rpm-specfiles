From 7586e66fe4e898f1cddd1ecb1b19e7e6bf80f188 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Tom=C3=A1=C5=A1=20Hrn=C4=8Diar?= <thrnciar@redhat.com>
Date: Thu, 27 Nov 2025 11:26:43 +0100
Subject: [PATCH] Set asyncio_mode=auto for compatibility with pytest 8.4.0+

---
 pytest.ini           | 1 +
 requirements-dev.txt | 1 +
 setup.py             | 1 +
 3 files changed, 3 insertions(+)

diff --git a/pytest.ini b/pytest.ini
index e62899b..63d726e 100644
--- a/pytest.ini
+++ b/pytest.ini
@@ -1,3 +1,4 @@
 [pytest]
 filterwarnings=
     error
+asyncio_mode=auto
diff --git a/requirements-dev.txt b/requirements-dev.txt
index 1d75f86..c7e80c3 100644
--- a/requirements-dev.txt
+++ b/requirements-dev.txt
@@ -3,6 +3,7 @@ aiohttp==3.11.14
 packaging==24.2
 pytest==8.3.5
 pytest-aiohttp==0.3.0
+pytest-asyncio
 pytest-cov==6.0.0
 selenium==4.30.0
 tox==4.25.0
diff --git a/setup.py b/setup.py
index 666c6fe..cdcffc6 100644
--- a/setup.py
+++ b/setup.py
@@ -57,6 +57,7 @@ setup(
     + pytest_runner,
     tests_require=[
         "pytest",
+        "pytest-asyncio",
         "pytest-cov",
         "pytest-pylint",
         "selenium",
-- 
2.51.1

