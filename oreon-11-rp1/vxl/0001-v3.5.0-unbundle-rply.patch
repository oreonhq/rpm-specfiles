-static void ply_init(p_ply ply) {
-    ply->element = NULL;
-    ply->nelements = 0;
-    ply->comment = NULL;
-    ply->ncomments = 0;
-    ply->obj_info = NULL;
-    ply->nobj_infos = 0;
-    ply->idriver = NULL;
-    ply->odriver = NULL;
-    ply->buffer[0] = '\0';
-    ply->buffer_first = ply->buffer_last = ply->buffer_token = 0;
-    ply->welement = 0;
-    ply->wproperty = 0;
-    ply->winstance_index = 0;
-    ply->wlength = 0;
-    ply->wvalue_index = 0;
