-static e_ply_storage_mode ply_arch_endian(void) {
-    unsigned long i = 1;
-    unsigned char *s = (unsigned char *) &i;
-    if (*s == 1) return PLY_LITTLE_ENDIAN;
-    else return PLY_BIG_ENDIAN;
-}
