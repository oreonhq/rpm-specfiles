-static void ply_ferror(p_ply ply, const char *fmt, ...) {
-    char buffer[1024];
-    va_list ap;
-    va_start(ap, fmt);
-    vsprintf(buffer, fmt, ap);
-    va_end(ap);
-    ply->error_cb(ply, buffer);
-}
