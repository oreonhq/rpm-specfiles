-  int numNormals = 0;
-
-  vgl_triangle_scan_iterator<double> tsi;
-  tsi.a.x = us[0];  tsi.a.y = vs[0];
-  tsi.b.x = us[1];  tsi.b.y = vs[1];
-  tsi.c.x = us[2];  tsi.c.y = vs[2];
