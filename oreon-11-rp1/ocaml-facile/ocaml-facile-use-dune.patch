   (** [release_date t] return the earliest start time of task [t]
      (i.e. [Fd.min (start t)]). *)
+
   val processing_time : t -> int
   (** [processing_time t] return the duration of task [t]. *)
+
   val deadline : t -> int
   (** [name t] return the latest completion time of task [t]
