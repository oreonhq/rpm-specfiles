Fix historic C99 incompatibility in autoconf-generated shell code
fragment.  Future compilers are likely to reject implicit int by
default.

No need to upstream this because the issue goes away once configure is
re-run.

diff --git a/configure b/configure
index aebdc4d589de4917..dc677c629b71931f 100755
--- a/configure
+++ b/configure
@@ -612,7 +612,7 @@ cross_compiling=$ac_cv_prog_cc_cross
 cat > conftest.$ac_ext <<EOF
 #line 614 "configure"
 #include "confdefs.h"
-main(){return(0);}
+int main(){return(0);}
 EOF
 if { (eval echo configure:618: \"$ac_link\") 1>&5; (eval $ac_link) 2>&5; } && test -s conftest; then
   ac_cv_prog_cc_works=yes
