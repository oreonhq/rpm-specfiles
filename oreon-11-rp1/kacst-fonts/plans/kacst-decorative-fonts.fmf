summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: kacst-decorative-fonts
execute:
    how: tmt
environment:
    PACKAGE: kacst-decorative-fonts
    FONT_ALIAS: serif
    FONT_FAMILY: KacstDecorative 
    FONT_LANG: ar
    DEFAULT_SANS: 2
    DEFAULT_SERIF: 2
    DEFAULT_MONO: 2
