%package -n texlive-alnumsec
Summary:        Alphanumeric section numbering
Version:        svn77682
License:        LPPL-1.3c
Requires:       texlive-base
Requires:       texlive-kpathsea
Provides:       texlive-alnumsec-doc = %{epoch}:%{version}-%{release}
Obsoletes:      texlive-alnumsec-doc <= 11:%{version}
