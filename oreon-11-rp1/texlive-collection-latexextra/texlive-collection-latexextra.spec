%package -n texlive-coolstr
Summary:        String manipulation in LaTeX
Version:        svn67015
License:        LGPL-2.1-or-later
Requires:       texlive-base
Requires:       texlive-kpathsea
Provides:       texlive-coolstr-doc = %{epoch}:%{version}-%{release}
