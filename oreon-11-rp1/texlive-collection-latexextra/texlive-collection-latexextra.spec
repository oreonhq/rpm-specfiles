Obsoletes:      texlive-tex-label-doc <= 11:%{version}
Requires:       tex(color.sty)
Requires:       tex(fancyhdr.sty)

%description -n texlive-tex-label
Enables the user to place a 'classification' label on each page, at the bottom
to the right of the page number

%package -n texlive-tex-locale
Summary:        Localisation support for TeX and LaTeX documents
Version:        svn77682
License:        LPPL-1.3c
Requires:       texlive-base
Requires:       texlive-kpathsea
Requires:       tex(CJK.sty)
Requires:       tex(etoolbox.sty)
Requires:       tex(fontenc.sty)
Requires:       tex(fontspec.sty)
Requires:       tex(ifluatex.sty)
Requires:       tex(ifxetex.sty)
Requires:       tex(inputenc.sty)
Requires:       tex(pinyin.sty)
