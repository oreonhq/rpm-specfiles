%package -n texlive-contracard
Summary:        Generate calling cards for dances
Version:        svn67201
License:        LPPL-1.3c
Requires:       texlive-base
Requires:       texlive-kpathsea
Provides:       texlive-contracard-doc = %{epoch}:%{version}-%{release}
