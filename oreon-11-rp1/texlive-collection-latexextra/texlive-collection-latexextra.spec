%package -n texlive-fullwidth
Summary:        Adjust margins of text block
Version:        svn24684
License:        LPPL-1.3c
Requires:       texlive-base
Requires:       texlive-kpathsea
Provides:       texlive-fullwidth-doc = %{epoch}:%{version}-%{release}
Obsoletes:      texlive-fullwidth-doc <= 11:%{version}
