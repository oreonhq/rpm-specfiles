+
+  avx2_ivec_t d0, d1, d2, d3;
+  AVX2_LOADU_VEC_128(d0, chacha_const);
+  AVX2_LOADU_VEC_128(d1, key);
+  AVX2_LOADU_VEC_128(d2, key+16);
