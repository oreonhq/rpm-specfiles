+  d3 = AVX2_START;
+
+  AVX2_STORE_VEC(state + 0*AVX2_SZ_VEC, d0);
+  AVX2_STORE_VEC(state + 1*AVX2_SZ_VEC, d1);
+  AVX2_STORE_VEC(state + 2*AVX2_SZ_VEC, d2);
+  AVX2_STORE_VEC(state + 3*AVX2_SZ_VEC, d3);
+}
