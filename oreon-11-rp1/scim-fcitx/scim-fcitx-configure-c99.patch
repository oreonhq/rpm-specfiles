Avoid implicit function declarations in the configure script.
Future compilers are likely not to support them by default,
and this breaks the script.

Re-running autoconf makes these issues go away, so there is no
need to upstream this.

diff --git a/aclocal.m4 b/aclocal.m4
index 0c3a6191c06a0473..bcb2fae21c133355 100644
--- a/aclocal.m4
+++ b/aclocal.m4
@@ -1604,10 +1604,6 @@ else
 #  endif
 #endif
 
-#ifdef __cplusplus
-extern "C" void exit (int);
-#endif
-
 void fnord() { int i=42;}
 int main ()
 {
@@ -1621,7 +1617,7 @@ int main ()
       /* dlclose (self); */
     }
 
-    exit (status);
+    return status;
 }]
 EOF
   if AC_TRY_EVAL(ac_link) && test -s conftest${ac_exeext} 2>/dev/null; then
diff --git a/configure b/configure
index eb70e37c2dec2ca1..072f2ce5a8b87b34 100755
--- a/configure
+++ b/configure
@@ -2951,7 +2951,7 @@ if { (eval echo "$as_me:$LINENO: \"$ac_compile\"") >&5
   echo "$as_me:$LINENO: \$? = $ac_status" >&5
   (exit $ac_status); }; }; then
   for ac_declaration in \
-   '' \
+   '#include <stdlib.h>' \
    'extern "C" void std::exit (int) throw (); using std::exit;' \
    'extern "C" void std::exit (int); using std::exit;' \
    'extern "C" void exit (int) throw ();' \
@@ -4164,8 +4164,8 @@ main ()
   for (i = 0; i < 256; i++)
     if (XOR (islower (i), ISLOWER (i))
 	|| toupper (i) != TOUPPER (i))
-      exit(2);
-  exit (0);
+      return 2;
+  return 0;
 }
 _ACEOF
 rm -f conftest$ac_exeext
