+check ovn-nbctl --wait=sb sync
+AT_CHECK([ovn-appctl -t ovn-controller ct-zone-list | sed "s/ [[0-9]]*/ ??/"], [0], [stdout])
+AT_CHECK([grep "ext_lr" stdout], [0], [dnl
+ext_lr ??
+])
+
+# Test ICMP traffic still works after dynamic ACL changes
