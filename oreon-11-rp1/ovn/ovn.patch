+        -- set logical_switch_port swp$i type=router \
+           options:router-port=rop$i addresses=router
+    AT_CHECK_UNQUOTED([ovn-nbctl get logical_router_port rop$i networks], [0], [[["192.168.1.$i/24"]]
+])
+done
