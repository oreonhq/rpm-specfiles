+    OVS_WAIT_UNTIL([test "$(as northd ovn-appctl -t ovn-northd status)" = "Status: active"])
+    OVS_WAIT_UNTIL([test "$(as northd ovn-appctl -t ovn-northd status)" = "Status: active"])
