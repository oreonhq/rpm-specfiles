with "gtkada";

project Mine_Detector is

   for Main use ("mine_detector");

   package Builder is
      for Default_Switches ("Ada") use ("-gnato");
   end Builder;

   package Binder is
      for Default_Switches ("Ada") use ("-shared");
   end Binder;

end Mine_Detector;
