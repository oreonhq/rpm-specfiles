From 34ce4ba872e294efaa625f3aa9188097921ff2b5 Mon Sep 17 00:00:00 2001
From: Igor Gnatenko <i.gnatenko.brain@gmail.com>
Date: Sat, 13 Aug 2016 11:26:35 +0200
Subject: [PATCH 1/2] add CMake build definitions and pkgconfig file

Signed-off-by: Igor Gnatenko <i.gnatenko.brain@gmail.com>
---
 CMakeLists.txt | 8 ++++++++
 tipl.pc.in     | 9 +++++++++
 2 files changed, 17 insertions(+)
 create mode 100644 CMakeLists.txt
 create mode 100644 tipl.pc.in

diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..06c628f
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,8 @@
+cmake_minimum_required (VERSION 3.0)
+project (TIPL VERSION 0 LANGUAGES NONE)
+configure_file (tipl.pc.in tipl.pc @ONLY)
+file (GLOB_RECURSE headers *.hpp)
+list (REMOVE_ITEM headers ${CMAKE_CURRENT_SOURCE_DIR}/image.hpp)
+install (FILES ${CMAKE_CURRENT_BINARY_DIR}/tipl.pc DESTINATION share/pkgconfig)
+install (FILES ${headers} DESTINATION include/image)
+install (FILES image.hpp DESTINATION include)
diff --git a/tipl.pc.in b/tipl.pc.in
new file mode 100644
index 0000000..55b0eed
--- /dev/null
+++ b/tipl.pc.in
@@ -0,0 +1,9 @@
+preifx=@CMAKE_INSTALL_PREFIX@
+exec_prefix=${prefix}
+includedir=${prefix}/include
+
+Name: @PROJECT_NAME@
+Description: Template image processing library
+Version: @PROJECT_VERSION@
+Libs: -lsvm
+Cflags: -I${includedir}
-- 
2.9.2

