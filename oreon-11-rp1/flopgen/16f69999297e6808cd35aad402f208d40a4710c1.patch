From 16f69999297e6808cd35aad402f208d40a4710c1 Mon Sep 17 00:00:00 2001
From: Davide Cavalca <davide@cavalca.name>
Date: Mon, 5 Oct 2020 20:16:16 -0700
Subject: [PATCH] Fix the build on GCC 8

---
 Makefile | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index 112fa01..c29652c 100644
--- a/Makefile
+++ b/Makefile
@@ -2,9 +2,10 @@ CXXFLAGS = --std=c++17
 
 CC = $(CXX)
 CCFLAGS = $(CXXFLAGS)
+LDFLAGS = -lstdc++fs
 
 flopgen: fatfs/diskio.o fatfs/fattime.o fatfs/ff.o fatfs/ffsystem.o fatfs/ffunicode.o classes.o image.o filediskio.o main.o
-	$(CXX) -o $@ $^
+	$(CXX) -o $@ $^ $(LDFLAGS)
 
 fatfs/%.o: fatfs/%.c fatfs/%.h
 classes.o: classes.cpp classes.hpp image.hpp
