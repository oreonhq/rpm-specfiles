[Unit]
Description=KeyDB Sentinel
After=network.target
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/sysconfig/keydb-sentinel
ExecStart=/usr/bin/keydb-sentinel /etc/keydb/sentinel.conf --daemonize no --supervised systemd $OPTIONS
Type=notify
User=keydb
Group=keydb
RuntimeDirectory=keydb
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
