[Unit]
Description=KeyDB persistent key-value database
After=network.target
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/sysconfig/keydb
ExecStart=/usr/bin/keydb-server /etc/keydb/keydb.conf --daemonize no --supervised systemd $OPTIONS
Type=notify
User=keydb
Group=keydb
RuntimeDirectory=keydb
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target

