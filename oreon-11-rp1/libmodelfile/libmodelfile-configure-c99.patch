Apply C99 compatibility fixes to the configure script.  Do not
rely on an implicit declaration of the exit function.  Implicit
function declarations have been removed from C in 1999, and future
compilers are likely not to accept them by default.

The changes are in code generated by autoconf/aclocal, so there is
no need to upstream these changes.  These files are not checked into
the current upstream repository at
<https://github.com/alriddoch/libmodelfile>.

diff --git a/aclocal.m4 b/aclocal.m4
index 8a90c6a124fe6399..e6f658544ce6296a 100644
--- a/aclocal.m4
+++ b/aclocal.m4
@@ -755,10 +755,6 @@ else
 #  endif
 #endif
 
-#ifdef __cplusplus
-extern "C" void exit (int);
-#endif
-
 void fnord() { int i=42;}
 int main ()
 {
@@ -772,7 +768,7 @@ int main ()
       /* dlclose (self); */
     }
 
-    exit (status);
+    return status;
 }]
 EOF
   if AC_TRY_EVAL(ac_link) && test -s conftest${ac_exeext} 2>/dev/null; then
