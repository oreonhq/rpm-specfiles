From c9cd57d1e908196ca908b65cb61c25e8cbba0331 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Miguel=20Mart=C3=ADn?= <mmartinv@redhat.com>
Date: Fri, 7 Feb 2025 11:17:17 +0100
Subject: [PATCH] chore: allow libcryptsetup-rs >= 0.11.2
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Miguel Martín <mmartinv@redhat.com>
---
 Cargo.lock                 | 4 ++--
 client-linuxapp/Cargo.toml | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 479e6998a..8f0bb5724 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -1974,9 +1974,9 @@ checksum = "b5aba8db14291edd000dfcc4d620c7ebfb122c613afb886ca8803fa4e128a20a"
 
 [[package]]
 name = "libcryptsetup-rs"
-version = "0.11.2"
+version = "0.12.0"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "b5083eeb8843b0295aba9a3ddda83b35097bc0f367cb6d9db793a1435e3eee6c"
+checksum = "186b5b6114517ab1d6e25741c6fb21060aae750e70868842efc9dd1efd08baa1"
 dependencies = [
  "bitflags 2.5.0",
  "either",
diff --git a/client-linuxapp/Cargo.toml b/client-linuxapp/Cargo.toml
index 6ade54361..7cf2a5929 100644
--- a/client-linuxapp/Cargo.toml
+++ b/client-linuxapp/Cargo.toml
@@ -16,7 +16,7 @@ rand = "0.8.4"
 nix = "0.26"
 uuid = "1.3"
 thiserror = "1"
-libcryptsetup-rs = { version = "0.11.2", features = ["mutex"] }
+libcryptsetup-rs = { version = ">= 0.11.2", features = ["mutex"] }
 secrecy = "0.8"
 devicemapper = "0.34"
 openssl = "0.10.70"
