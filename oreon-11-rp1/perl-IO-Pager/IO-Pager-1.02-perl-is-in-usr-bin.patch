 use IO::Pager::Perl;
 use Term::ReadKey;
diff --git a/lib/IO/Pager/tp b/lib/IO/Pager/tp
index ea8fb4b..31c0045 100755
--- a/lib/IO/Pager/tp
+++ b/lib/IO/Pager/tp
