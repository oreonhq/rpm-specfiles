%package -n texlive-pstricks
Summary:        PostScript macros for TeX
Version:        svn78101
License:        LPPL-1.3c
Requires:       texlive-base
Requires:       texlive-kpathsea
Provides:       texlive-pstricks-doc = %{epoch}:%{version}-%{release}
