From 733fd0daaadd5a232e948b852b800178d85acdee Mon Sep 17 00:00:00 2001
From: Carl George <carlwgeorge@gmail.com>
Date: Mon, 4 Aug 2025 02:14:35 -0500
Subject: [PATCH] Revert "feat(meson): use appstream for appdata validation
 (#1379)"

This reverts commit e5a1528c27ef7b4411c1b322e61beea6dd430bf0.
---
 data/meson.build | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/data/meson.build b/data/meson.build
index 95a0c6e8..1cf17619 100644
--- a/data/meson.build
+++ b/data/meson.build
@@ -87,12 +87,12 @@ if host_machine.system() != 'windows' and host_machine.system() != 'darwin'
         install_dir: join_paths(get_option('datadir'), 'metainfo'),
     )
 
-    appstreamcli = find_program('appstreamcli', required: false)
-    if appstreamcli.found()
+    appstream_util = find_program('appstream-util', required: false)
+    if appstream_util.found()
         test(
             'Validate appstream file',
-            appstreamcli,
-            args: ['validate', '--no-net', '--explain', appstream_file],
+            appstream_util,
+            args: ['validate-relax', '--nonet', appstream_file],
         )
     endif
 endif
-- 
