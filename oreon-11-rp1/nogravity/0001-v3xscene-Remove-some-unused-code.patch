-        OVI->index_INSTANCE = cORI - pScene->ORI;  
-		assert(OVI->ORI!=NULL);		
-		OVI->state|=V3XSTATE_INSTANCED;
-    }
-    OVI->state|=V3XSTATE_VALIDPOINTER;
-    return OVI;
-}
