From d392d22d5ee80737b6cdfb78cf9880ae71d57ed0 Mon Sep 17 00:00:00 2001
From: Jacek Caban <jacek@codeweavers.com>
Date: Sun, 17 Sep 2023 13:48:02 +0200
Subject: [PATCH 2/3] nss: Don't use -mwindows in OS_CFLAGS.

---
 security/nss/coreconf/WIN32.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/security/nss/coreconf/WIN32.mk b/security/nss/coreconf/WIN32.mk
index 67f67926dc4c..18d1b5fef200 100644
--- a/security/nss/coreconf/WIN32.mk
+++ b/security/nss/coreconf/WIN32.mk
@@ -104,7 +104,7 @@ endif
 DLL_SUFFIX   = dll
 
 ifdef NS_USE_GCC
-    OS_CFLAGS += -mwindows -mms-bitfields
+    OS_CFLAGS += -mms-bitfields
     _GEN_IMPORT_LIB=-Wl,--out-implib,$(IMPORT_LIBRARY)
     DLLFLAGS  += -mwindows -o $@ -shared -Wl,--export-all-symbols -Wl,--nxcompat $(if $(IMPORT_LIBRARY),$(_GEN_IMPORT_LIB))
     ifdef BUILD_OPT
-- 
GitLab


