From 177a35780e1ad93d3a1279d64142614bb55b6a84 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Franti=C5=A1ek=20Zatloukal?= <fzatlouk@redhat.com>
Date: Mon, 21 Jul 2025 22:56:38 +0200
Subject: [PATCH] Hacky resolve of "two or more data types in declaration
 specifiers"

---
 security/nss/lib/dev/ckhelper.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/security/nss/lib/dev/ckhelper.c b/security/nss/lib/dev/ckhelper.c
index 4f39726..b17a286 100644
--- a/security/nss/lib/dev/ckhelper.c
+++ b/security/nss/lib/dev/ckhelper.c
@@ -186,13 +186,13 @@ nssCKObject_IsAttributeTrue(
     NSSSlot *slot,
     PRStatus *rvStatus)
 {
-    CK_BBOOL bool;
+    CK_BBOOL boolVal;
     CK_ATTRIBUTE_PTR attr;
     CK_ATTRIBUTE atemplate = { 0, NULL, 0 };
     CK_RV ckrv;
     void *epv = nssSlot_GetCryptokiEPV(slot);
     attr = &atemplate;
-    NSS_CK_SET_ATTRIBUTE_VAR(attr, attribute, bool);
+    NSS_CK_SET_ATTRIBUTE_VAR(attr, attribute, boolVal);
     nssSession_EnterMonitor(session);
     ckrv = CKAPI(epv)->C_GetAttributeValue(session->handle, object,
                                            &atemplate, 1);
@@ -202,7 +202,7 @@ nssCKObject_IsAttributeTrue(
         return PR_FALSE;
     }
     *rvStatus = PR_SUCCESS;
-    return (PRBool)(bool == CK_TRUE);
+    return (PRBool)(boolVal == CK_TRUE);
 }
 
 NSS_IMPLEMENT PRStatus
-- 
2.50.1

