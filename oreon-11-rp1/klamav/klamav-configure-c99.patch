Avoid implicit ints and implicit function declarations for
compatibility with future compiler defaults.

All the changes are generic in nature, but acinclude.m4 is not
regenerated automatically, so this part theoretically needs to be
upstreamed.

diff --git a/acinclude.m4 b/acinclude.m4
index fad2a7fa4aee16e4..95554a8a7642e24e 100644
--- a/acinclude.m4
+++ b/acinclude.m4
@@ -6734,10 +6734,6 @@ else
 #  endif
 #endif
 
-#ifdef __cplusplus
-extern "C" void exit (int);
-#endif
-
 void fnord() { int i=42;}
 int main ()
 {
@@ -6751,7 +6747,7 @@ int main ()
       /* dlclose (self); */
     }
 
-    exit (status);
+    return status;
 }]
 EOF
   if AC_TRY_EVAL(ac_link) && test -s conftest${ac_exeext} 2>/dev/null; then
