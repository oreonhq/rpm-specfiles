+  PORT (
+  cko : out WOR_BIT BUS;	
+  ck : in BIT;	
+  vdde : in BIT;	
+  vddi : in BIT;	
+  vsse : in BIT;	
+  vssi : in BIT	
+  );
+END pvddick_mpx;
+
+ARCHITECTURE behaviour_data_flow OF pvddick_mpx IS
+
+BEGIN
+  label0 : BLOCK ('1' = '1')
