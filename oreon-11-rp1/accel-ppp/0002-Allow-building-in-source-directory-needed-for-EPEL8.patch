From 5dd05a21ef3655dd36c17af3aba872cbdbbef478 Mon Sep 17 00:00:00 2001
From: Neel Chauhan <blackbird@sour.coffee>
Date: Tue, 10 Feb 2026 10:19:54 -0500
Subject: [PATCH 2/3] Allow building in source directory (needed for EPEL8)

---
 CMakeLists.txt | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index f5d472db..58306ae1 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,9 +1,5 @@
 cmake_minimum_required(VERSION 3.10)
 
-if (CMAKE_BINARY_DIR STREQUAL CMAKE_HOME_DIRECTORY)
-    message(FATAL_ERROR "Building in source directory is forbidden. Please make separated build directory.")
-endif ()
-
 project(accel-ppp C)
 
 SET(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Wall -fno-strict-aliasing -D_GNU_SOURCE -fPIC -rdynamic -Wno-unused-result")
-- 
