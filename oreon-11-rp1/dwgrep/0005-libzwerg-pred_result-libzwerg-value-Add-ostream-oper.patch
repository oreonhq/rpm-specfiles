+       your option) any later version
+
+   or both in parallel, as here.
+
+   dwgrep is distributed in the hope that it will be useful, but
+   WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   General Public License for more details.
+
+   You should have received copies of the GNU General Public License and
+   the GNU Lesser General Public License along with this program.  If
+   not, see <http://www.gnu.org/licenses/>.  */
+
+#include <iostream>
+
+#include "pred_result.hh"
+
+std::ostream &
+operator<< (std::ostream &o, pred_result result)
+{
+  switch (result)
+    {
+    case pred_result::yes:
+      return o << "yes";
+    case pred_result::no:
+      return o << "no";
+    case pred_result::fail:
+      return o << "fail";
+    }
+  return o;
+}
diff --git a/libzwerg/pred_result.hh b/libzwerg/pred_result.hh
index dfd9779..00572cc 100644
--- a/libzwerg/pred_result.hh
+++ b/libzwerg/pred_result.hh
@@ -29,12 +29,16 @@
 #ifndef _PRED_RESULT_H_
 #define _PRED_RESULT_H_
 
+#include <cstdlib>
+#include <iosfwd>
+
 enum class pred_result
   {
     no = false,
     yes = true,
     fail,
   };
+std::ostream &operator<< (std::ostream &o, pred_result result);
 
 inline pred_result
 operator! (pred_result other)
diff --git a/libzwerg/value.cc b/libzwerg/value.cc
index c8e5420..faf7f2e 100644
--- a/libzwerg/value.cc
+++ b/libzwerg/value.cc
@@ -34,6 +34,23 @@
 #include "tree.hh"
 #include "value.hh"
 
+std::ostream &
+operator<< (std::ostream &o, cmp_result result)
+{
+  switch (result)
+    {
+    case cmp_result::less:
+      return o << "less";
+    case cmp_result::equal:
+      return o << "equal";
+    case cmp_result::greater:
+      return o << "greater";
+    case cmp_result::fail:
+      return o << "fail";
+    }
+  return o;
+}
+
 value_type
 value_type::alloc (char const *name, char const *docstring)
 {
diff --git a/libzwerg/value.hh b/libzwerg/value.hh
index abc786f..fe02c20 100644
--- a/libzwerg/value.hh
+++ b/libzwerg/value.hh
@@ -41,6 +41,7 @@ enum class cmp_result
     greater,
     fail,
   };
+std::ostream &operator<< (std::ostream &o, cmp_result result);
 
 template <class T>
 cmp_result
