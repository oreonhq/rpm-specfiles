From bc361bb11010eecc177f6decf87c1b23c302e341 Mon Sep 17 00:00:00 2001
From: Petr Machata <petrm@nvidia.com>
Date: Sun, 8 May 2022 22:36:58 +0200
Subject: [PATCH 05/10] libzwerg/pred_result, libzwerg/value: Add ostream
 operators

GTest attempts to serialize the values entering comparison, and pred_result
and cmp_result are missing the required operator<<. This breaks the build.

Signed-off-by: Petr Machata <me@pmachata.org>
---
 libzwerg/CMakeLists.txt |  1 +
 libzwerg/pred_result.cc | 46 +++++++++++++++++++++++++++++++++++++++++
 libzwerg/pred_result.hh |  4 ++++
 libzwerg/value.cc       | 17 +++++++++++++++
 libzwerg/value.hh       |  1 +
 5 files changed, 69 insertions(+)
 create mode 100644 libzwerg/pred_result.cc

diff --git a/libzwerg/CMakeLists.txt b/libzwerg/CMakeLists.txt
index e3c128b..896d5e4 100644
--- a/libzwerg/CMakeLists.txt
+++ b/libzwerg/CMakeLists.txt
@@ -44,6 +44,7 @@ ADD_LIBRARY (LibzwergCore OBJECT
   libzwerg.cc
   op.cc
   overload.cc
+  pred_result.cc
   scon.cc
   selector.cc
   stack.cc
diff --git a/libzwerg/pred_result.cc b/libzwerg/pred_result.cc
new file mode 100644
index 0000000..ce475cf
--- /dev/null
+++ b/libzwerg/pred_result.cc
@@ -0,0 +1,46 @@
+/*
+   Copyright (C) 2022 Petr Machata
+   This file is part of dwgrep.
