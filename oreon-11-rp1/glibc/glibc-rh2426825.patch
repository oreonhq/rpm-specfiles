Work around GCC problem that makes diagnostics pragmas ineffective,
by moving the error suppression to the command line.

diff --git a/sysdeps/unix/sysv/linux/s390/Makefile b/sysdeps/unix/sysv/linux/s390/Makefile
index 30332909982271b2..5a33e8c2530b1bf2 100644
--- a/sysdeps/unix/sysv/linux/s390/Makefile
+++ b/sysdeps/unix/sysv/linux/s390/Makefile
@@ -37,3 +37,9 @@ sysdep_headers += \
   sys/elf.h \
   # sysdep_headers
 endif
+
+ifeq ($(subdir),benchtests)
+CFLAGS-bench-memcpy.c += -Wno-error=maybe-uninitialized
+CFLAGS-bench-memmove.c += -Wno-error=maybe-uninitialized
+CFLAGS-bench-mempcpy.c += -Wno-error=maybe-uninitialized
+endif
