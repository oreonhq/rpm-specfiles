<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
<match>
  <test name="family">
    <string>sans</string>
  </test>
  <edit name="family" mode="prepend">
    <string>Junction</string>
  </edit>
</match>

<alias>
  <family>Junction</family>
  <default>
    <family>sans</family>
  </default>
</alias>
</fontconfig>

