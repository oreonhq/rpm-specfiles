Subject: [PATCH] Set aiohttp to >=3.9

---
 setup.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/setup.py b/setup.py
index 761229e..fdf16fa 100644
--- a/setup.py
+++ b/setup.py
@@ -79,7 +79,7 @@ def get_git_commit_datetime() -> str:
 PACKAGES = find_packages(exclude=['tests', 'tests.*'])
 
 REQUIRES = [
-    'aiohttp>=3.8,<4',
+    'aiohttp>=3.9,<4',
     'click-log>=0.4,<0.5',
     'click>=8,<9',
     'dateparser>=0.7.1,<1.2',
