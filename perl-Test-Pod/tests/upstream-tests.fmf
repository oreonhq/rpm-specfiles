summary: Upstream tests
contact: Michal Josef Spacek <mspacek@redhat.com>
component: perl-Test-Pod
require: perl-Test-Pod-tests
test: /usr/libexec/perl-Test-Pod/test
enabled: true
tag:
  - rhel-buildroot
adjust:
  - enabled: false
    when: distro < rhel-10 or distro < centos-stream-10
    continue: false
