execute:
  how: tmt

discover:
  how: shell
  url: https://src.fedoraproject.org/tests/python.git
  tests:
    - name: marshalparser_compatibility36
      path: /marshalparser
      test: VERSION=3.6 SAMPLE=200 ./test_marshalparser_compatibility.sh
    - name: marshalparser_compatibility39
      path: /marshalparser
      test: VERSION=3.9 SAMPLE=200 ./test_marshalparser_compatibility.sh
    - name: marshalparser_compatibility310
      path: /marshalparser
      test: VERSION=3.10 SAMPLE=200 ./test_marshalparser_compatibility.sh
    - name: marshalparser_compatibility311
      path: /marshalparser
      test: VERSION=3.11 SAMPLE=200 ./test_marshalparser_compatibility.sh
    - name: marshalparser_compatibility312
      path: /marshalparser
      test: VERSION=3.12 SAMPLE=200 ./test_marshalparser_compatibility.sh
    - name: marshalparser_compatibility313
      path: /marshalparser
      test: VERSION=3.13 SAMPLE=200 ./test_marshalparser_compatibility.sh
    - name: marshalparser_compatibility314
      path: /marshalparser
      test: VERSION=3.14 SAMPLE=200 ./test_marshalparser_compatibility.sh
    - name: marshalparser_compatibility315
      path: /marshalparser
      test: VERSION=3.15 SAMPLE=200 ./test_marshalparser_compatibility.sh
prepare:
  - name: Install dependencies
    how: install
    package:
    - python3.6
    - python3.9
    - python3.10
    - python3.11
    - python3.12
    - python3.13
    - python3.14
    - python3.15
    - marshalparser
    - dnf # for upgrade
  - name: Update packages
    how: shell
    script: dnf upgrade -y
