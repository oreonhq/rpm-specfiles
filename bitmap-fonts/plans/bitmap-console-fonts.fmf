summary: Fonts related tests
discover:
  how: fmf
  url: https://src.fedoraproject.org/tests/fonts
prepare:
  name: tmt
  how: install
  package:
    - bitmap-console-fonts
execute:
  how: tmt
environment:
  PACKAGE: bitmap-console-fonts
  FONT_ALIAS: monospace
  FONT_FAMILY: Console
  FONT_LANG: en
