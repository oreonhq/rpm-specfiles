summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: rit-rachana-fonts
execute:
    how: tmt
environment:
    PACKAGE: rit-rachana-fonts
    FONT_ALIAS: serif
    FONT_FAMILY: RIT Rachana
    FONT_LANG: ml
    DEFAULT_SERIF: 1
