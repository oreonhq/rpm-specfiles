summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: sil-padauk-book-fonts
execute:
    how: tmt
environment:
    PACKAGE: sil-padauk-book-fonts
    FONT_ALIAS: sans-serif
    FONT_FAMILY: Padauk Book
    FONT_LANG: my
    DEFAULT_SERIF: 2
    DEFAULT_MONO: 2
