summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: sil-padauk-fonts
execute:
    how: tmt
environment:
    PACKAGE: sil-padauk-fonts
    FONT_ALIAS: sans-serif
    FONT_FAMILY: Padauk
    FONT_LANG: my
    DEFAULT_SANS: 1
    DEFAULT_SERIF: 2
    DEFAULT_MONO: 1
