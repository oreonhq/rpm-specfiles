summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: gubbi-fonts
execute:
    how: tmt
environment:
    PACKAGE: gubbi-fonts
    FONT_ALIAS: serif
    FONT_FAMILY: Gubbi
    FONT_LANG: kn
    DEFAULT_SANS: 2
    DEFAULT_SERIF: 2
    DEFAULT_MONO: 2
