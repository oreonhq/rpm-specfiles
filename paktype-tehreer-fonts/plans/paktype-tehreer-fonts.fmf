summary: Fonts related tests
discover:
    how: fmf
    url: https://src.fedoraproject.org/tests/fonts
prepare:
    name: tmt
    how: install
    package: paktype-tehreer-fonts
execute:
    how: tmt
environment:
    PACKAGE: paktype-tehreer-fonts
    FONT_ALIAS: sans-serif
    FONT_FAMILY: PakType Tehreer
    FONT_LANG: pa-pk,ur-in,ur-pk
    DEFAULT_SANS: 2
    DEFAULT_SERIF: 2
    DEFAULT_MONO: 2
